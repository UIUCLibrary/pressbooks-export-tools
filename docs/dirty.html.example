idth: 165.469px;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 165.266px;"><p class="import-Normal" style="text-align: center;">−1</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 165.266px;"><p class="import-Normal" style="text-align: center;">1</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 67.125px;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 258.766px;"><p class="import-Normal" style="text-align: center;">7</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 165.469px;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 165.266px;"><p class="import-Normal" style="text-align: center;">−1</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 165.266px;"><p class="import-Normal" style="text-align: center;">1</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 67.125px;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 258.766px;"><p class="import-Normal" style="text-align: center;">7</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 165.469px;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 165.266px;"><p class="import-Normal" style="text-align: center;">−1</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 165.266px;"><p class="import-Normal" style="text-align: center;">1</p> </