der: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">64</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">16</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">64</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">17</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">81</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">18</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">81</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">19</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">81</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">20</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">81</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">21</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">81</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">22</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">100</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">23</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">100</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">24</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">100</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">11</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">121</p> </td> </tr> <tr class="TableGrid-R"><td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">26</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">12</p> </td> <td class="TableGrid-C" style="vertical-align: bottom; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">144</p> </td> </tr> <tr class="shaded"><td class="TableGrid-C" style="border: 0.5pt solid windowtext; text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=TiA9IDI2&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N = 26" title="N = 26" class="latex mathjax" /></strong></td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=XG1hdGhiZntcU2lnbWF9eD0yMDg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mathbf{\Sigma}x=208" title="\mathbf{\Sigma}x=208" class="latex mathjax" /></strong></td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4XjIgPSAxNzQ4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x^2 = 1748" title="\sum x^2 = 1748" class="latex mathjax" /></strong></td> </tr> </tbody> </table> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 7.3. Calculating Sum of Squares with Computational Formula</h5> </div> <div class="textbox__content"><p><strong>Formula for sum of squares–computational:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfeCA9IFxzdW0geF4yIC0gXGZyYWN7KFxzdW0geCleMn17Tn0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_x = \sum x^2 - \frac{(\sum x)^2}{N}" title="SS_x = \sum x^2 - \frac{(\sum x)^2}{N}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2FsaWduZWR9IFNTX3ggJj0gMSw3NDggLSBcZnJhY3soMjA4KV4yfXsyNn0gXFwgU1NfeCAmPSAxLDc0OCAtIFxmcmFjezQzLDI2NH17MjZ9IFxcIFNTX3ggJj0gMSw3NDggLSAxLDY2NCBcXCBTU194ICY9IDg0XGVuZHthbGlnbmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{aligned} SS_x &amp;amp;= 1,748 - \frac{(208)^2}{26} \\ SS_x &amp;amp;= 1,748 - \frac{43,264}{26} \\ SS_x &amp;amp;= 1,748 - 1,664 \\ SS_x &amp;amp;= 84\end{aligned}" title="\begin{aligned} SS_x &amp;amp;= 1,748 - \frac{(208)^2}{26} \\ SS_x &amp;amp;= 1,748 - \frac{43,264}{26} \\ SS_x &amp;amp;= 1,748 - 1,664 \\ SS_x &amp;amp;= 84\end{aligned}" class="latex mathjax" /></p> </div> </div> <div class="chapter-7:-distributions-and-their-shapes"><p>Both the definitional formula and the computational formulas for the sum of squares give us a value of 84. Next, we will calculate the variance and standard deviation.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 7.4. Calculating Sample Variance</h5> </div> <div class="textbox__content"><p><strong>Formula for sample variance:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=c14yID0gXGZyYWN7U1NfeH17KE4tMSl9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s^2 = \frac{SS_x}{(N-1)}" title="s^2 = \frac{SS_x}{(N-1)}" class="latex mathjax" /></p> <p><strong>Our example:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2FsaWduZWR9IHNeMiA9IFxmcmFjezg0fXsoMjYtMSl9IFxcIHNeMiA9IFxmcmFjezg0fXsyNX0gPSAzLjM2XGVuZHthbGlnbmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{aligned} s^2 = \frac{84}{(26-1)} \\ s^2 = \frac{84}{25} = 3.36\end{aligned}" title="\begin{aligned} s^2 = \frac{84}{(26-1)} \\ s^2 = \frac{84}{25} = 3.36\end{aligned}" class="latex mathjax" /></p> </div> </div> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 7.5. Calculating Sample Standard Deviation</h5> </div> <div class="textbox__content"><p><b>Formula for sample standard deviation:</b></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=cyA9IFxzcXJ0e3NeMn0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s = \sqrt{s^2}" title="s = \sqrt{s^2}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2FsaWduZWR9IHMgPSBcc3FydHszLjM2fVxcIHMgPSAxLjgzXGVuZHthbGlnbmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{aligned} s = \sqrt{3.36}\\ s = 1.83\end{aligned}" title="\begin{aligned} s = \sqrt{3.36}\\ s = 1.83\end{aligned}" class="latex mathjax" /></p> </div> </div> <ul><li><span style="text-align: initial; font-size: 14pt;">Sample variance: 3.36</span></li> </ul> <div class="chapter-7:-distributions-and-their-shapes"><ul><li>Standard deviation: 1.83</li> </ul> <p class="import-Normal">We will use the mean (<em><span style="font-size: NaNpt; color: #; text-decoration: none;">x̅ </span></em>= 8) and standard deviation (<em>s</em> = 1.83) later in this chapter. However, you can start to see the shape of our distribution as we connect our data points in Figure 7.3.</p> <p>&nbsp;</p> <div class="wp-caption aligncenter" id="attachment_1255" aria-describedby="caption-attachment-1255" style="width: 700px"><img class="wp-image-1255" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-7.3R-1.png" alt="A line is used to connect the data points (ranging from 4 to 12 along the x-axis). The highest peak of the distribution is 8." width="700" height="467" title="" /><div class="wp-caption-text" id="caption-attachment-1255">Figure 7.3. Distribution of values (i.e., number of evictions) using a frequency polygon.</div></div> <h2 class="import-Normal">The Normal Distribution</h2> <p class="import-Normal">Also referred to as the bell-shaped curve because of its shape, the <strong><em><span class="glossary-term">normal distribution</span></em></strong> is a theoretical distribution (see Figure 7.4). This means that the distribution resulted from mathematical principles, rather than actual data. Thus, it provides a visual showing the key features of how a variable is expected to look (i.e., be distributed). In statistics, we can use this theoretical model and compare our actual data distributions to it; we can approximate it.</p> </div> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-199" style="width: 700px"><img class="wp-image-196" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/028-1.png" alt="A symmetrical, bell-shaped curve representing a normal distribution, with the peak centered over the mean" width="700" height="448" title="" /><div class="wp-caption-text">Figure 7.4. The Normal Distribution.</div></div> <div class="chapter-7:-distributions-and-their-shapes"><p class="import-Normal">Most data points cluster around the mean, and the rest taper off on either side of the high point of the curve. As you get farther away from the mean, you have the upper and lower tails of the distribution. There are three key features of the normal distribution:</p> <p>1. The mean, median, and mode are all the same value at the center, the high point of the distribution.</p> <p>2. It is symmetrical; if you folded the distribution in half, you’d have mirror images. 50% of the distribution is below the mean, median, and mode, and 50% of the distribution is above the mean, median, and mode (see Figure 7.5).</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-199" style="width: 700px"><img class="wp-image-199" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/029-2-1.png" alt="The normal distribution has the mean, median, and mode shown at the center, high point of the curve. It is symmetrical, so 50% is on each side." width="700" height="448" title="" /><div class="wp-caption-text">Figure 7.5. The mean, median, and mode shown at the center, at the high point of the curve. The normal distribution is symmetrical, so 50% of the distribution falls on each side.</div></div> <p>3. Approximately 68.27% of scores are located within 1 standard deviation below and above the mean (see Figure 7.6), 95.45% of scores are within 2 standard deviations below and above the mean (see Figure 7.7), and 99.73% of scores are within 3 standard deviations below and above the mean (see Figure 7.8).</p> </div> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-199" style="width: 700px"><img class="wp-image-1183" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-7.6R-1.png" alt="The normal distribution shows 1, 2, and 3 standard deviation lines on either side of the mean. The area between -1 and 1 standard deviations around the mean is shaded to indicate 68.27% of scores are located here." width="700" height="375" title="" /><div class="wp-caption-text">Figure 7.6. Approximately 68.27% of scores are located within 1 standard deviation of the mean.</div></div> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-199" style="width: 700px"><img class="wp-image-1184" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-7.7R-1.png" alt="The normal distribution shows 1, 2, and 3 standard deviation lines on either side of the mean. The area between -2 and 2 standard deviations around the mean is shaded to indicate 95.45% of scores are located here." width="700" height="370" title="" /><div class="wp-caption-text">Figure 7.7. Approximately 95.45% of scores are located within 2 standard deviations of the mean.</div></div> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-199" style="width: 700px"><img class="wp-image-1185" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-7.8R-1.png" alt="The normal distribution shows 1, 2, and 3 standard deviation lines on either side of the mean. The area between -3 and 3 standard deviations around the mean is shaded to indicate 99.73% of scores are located here." width="700" height="375" title="" /><div class="wp-caption-text">Figure 7.8. Approximately 99.73% of scores are located within 3 standard deviations of the mean.</div></div> <div class="chapter-7:-distributions-and-their-shapes"><p class="import-Normal">Based on these three key features, we can use this distribution to help us understand approximately where data points are located. As shown earlier, the mean (and median and mode) is at the center line of the distribution. The distribution is symmetrical in shape. In Figure 7.9, standard deviations are used to help measure the amount of variability around the mean. There are three lines above the mean, which represent 1, 2, and 3 standard deviations above the mean. There are also three lines below the mean, which represent 1, 2, and 3 standard deviations below the mean. We can use our mean and standard deviation to calculate exactly what those lines represent. This also helps us understand where proportions of scores fall on this distribution.</p> <div class="wp-caption aligncenter" id="attachment_1186" aria-describedby="caption-attachment-1186" style="width: 700px"><img class="wp-image-1186" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-7.9R-1.png" alt="Normal distribution with standard deviation lines showing -3, -2, -1, 0, 1, 2, and 3 along the x-axis." width="700" height="413" title="" /><div class="wp-caption-text" id="caption-attachment-1186">Figure 7.9. Normal distribution with standard deviation lines.</div></div> <p class="import-Normal">We can calculate exactly what the line values represent for any given problem, but the normal distribution helps us understand that approximately 68.27% of scores fall under the highest part of the curve, within 1 standard deviation on either side of the mean (see Figure 7.10). The second key feature is that the distribution is symmetrical, so you have half of the total area (34.135%) below the mean, and half of the total area (34.135%) is above the mean.</p> <p class="import-Normal">As you go out to 2 standard deviations from the mean, you are now seeing that approximately 95.45% of scores fall in this area. Again, this is symmetrical, so 47.725% is below the mean, and 47.725% of scores are above the mean.</p> <p class="import-Normal">Finally, as you go out to 3 standard deviations from the mean, you are now seeing that approximately 99.73% of scores are in this area of the distribution (49.865% below the mean, 49.865% above the mean).</p> <div class="wp-caption aligncenter" id="attachment_1187" aria-describedby="caption-attachment-1187" style="width: 700px"><img class="wp-image-1187" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-7.10R-1.png" alt="The normal distribution has three areas labeled: 1) area 1 standard deviation above and below mean is where 68.27% of cases are, 2) area 2 standard deviations above and below the mean is where 95.45% of cases are, and 3) area 3 standard deviations above and below the mean is where 99.73% of cases are." width="700" height="515" title="" /><div class="wp-caption-text" id="caption-attachment-1187">Figure 7.10. Normal distribution with standard deviation lines and areas shown.</div></div> <h3 class="import-Normal">Using the Mean and Standard Deviation on the Normal Distribution</h3> <p class="import-Normal">Once we calculate the mean and standard deviation for a population or sample, we can use these values to visualize our distributions. Let’s use our example from earlier in the chapter: mean (<img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fSA9IDg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x} = 8" title="\bar{x} = 8" class="latex mathjax" />) and standard deviation (<img src="https://mathjax.library.illinois.edu/latex?latex=cyA9IDEuODM&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s = 1.83" title="s = 1.83" class="latex mathjax" />). The mean goes at the center line. Then, you’ll use your standard deviation to calculate the values at 1 standard deviation above and below that mean. Figure 7.11 is what we will use for our sample mean (x-bar) and standard deviation (s). Figure 7.12 shows what this would look like if we had a population mean (<img src="https://mathjax.library.illinois.edu/latex?latex=XG11&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu" title="\mu" class="latex mathjax" />) and standard deviation (<img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21h&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma" title="\sigma" class="latex mathjax" />).</p> <div class="wp-caption aligncenter" id="attachment_207" aria-describedby="caption-attachment-207" style="width: 700px"><img class="wp-image-207" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/036_Normal-Distribution_sample-notation-for-SD-lines-1.png" alt="Normal distribution with x-bar at the center. Around the mean is x-bar plus or minus 1, 2, and 3 standard deviations (notated with s)." width="700" height="383" title="" /><div class="wp-caption-text" id="caption-attachment-207">Figure 7.11. Normal distribution with sample notation.</div></div> </div> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-199" style="width: 700px"><img class="wp-image-206" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/035_Normal-Distribution_population-notation-for-SD-lines-1.png" alt="Normal distribution with mu at the center. Around the mean is mu plus or minus 1, 2, and 3 standard deviations (notated with sigma)." width="700" height="383" title="" /><div class="wp-caption-text">Figure 7.12. Normal distribution with population notation.</div></div> <div class="chapter-7:-distributions-and-their-shapes"><p class="import-Normal">First, let’s find 1 standard deviation below the mean: 8 – 1.83 = 6.17. Then let’s find 1 standard deviation above the mean: 8 + 1.83 = 9.83. This means that 68.27% of scores fall between 6.17 and 9.83.</p> <ul><li>Mean – 1 standard deviation: 8 – 1.83 = 6.17.</li> <li>Mean + 1 standard deviation: 8 + 1.83 = 9.83.</li> </ul> <p class="import-Normal">You’ll do the same process to calculate 2 and 3 standard deviations from the mean:</p> <ul><li>Mean – 2 standard deviations: 8 – 1.83(2)= 4.34.</li> <li>Mean + 2 standard deviations: 8 + 1.83(2) = 11.66.</li> <li>Mean – 3 standard deviations: 8 – 1.83(3) = 2.51.</li> <li>Mean + 3 standard deviations: 8 + 1.83(3) = 13.49.</li> </ul> <p class="import-Normal">From this information, you know that 68.26% of scores fall between 6.17 and 9.83, 95.45% of scores fall between 4.34 and 11.66, and 99.73% of scores fall between 2.51 and 13.49 (see Figure 7.13).</p> <div class="wp-caption aligncenter" id="attachment_208" aria-describedby="caption-attachment-208" style="width: 700px"><img class="wp-image-208" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/037_Using-Mean-and-SD-on-ND-1.png" alt="Numbers from left to right: 2.51, 4.34, 6.17, 8 (mean), 9.83, 11.66, and 13.49. These values are the standard deviations below and above the mean of 8." width="700" height="386" title="" /><div class="wp-caption-text" id="caption-attachment-208">Figure 7.13. Normal distribution with mean and standard deviation values for our example.</div></div> <p class="import-Normal">We can also use our example from Chapters 5 and 6 to visualize the mean and standard deviation for the sample that completed the cognitive decline assessment. The mean (<img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fT0gNzkuNjk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}= 79.69" title="\bar{x}= 79.69" class="latex mathjax" />) and standard deviation (<img src="https://mathjax.library.illinois.edu/latex?latex=cyA9IDEzLjE0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s = 13.14" title="s = 13.14" class="latex mathjax" />) are repeated here:</p> <ul><li>Mean – 1 standard deviation: 79.69 – 13.14 = 66.55.</li> <li>Mean + 1 standard deviation: 79.69 + 13.14 = 92.83.</li> <li>Mean – 2 standard deviations: 79.69 – 13.14 (2) = 53.41.</li> <li>Mean + 2 standard deviations: 79.69 + 13.14 (2) = 105.97.</li> <li>Mean – 3 standard deviations: 79.69 – 13.14 (3) = 40.27.</li> <li>Mean + 3 standard deviations: 79.69 + 13.14 (3) = 119.11.</li> </ul> <p class="import-Normal">From this information, you now know that 68.27% of scores fall between 66.55 and 92.83, 95.45% of scores fall between 53.41 and 105.97, and 99.73% of scores fall between 40.27 and 119.11 (see Figure 7.14).</p> <div class="wp-caption aligncenter" id="attachment_209" aria-describedby="caption-attachment-209" style="width: 700px"><img class="wp-image-209" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/038_Example2_ND-with-SD-1.png" alt="Normal distribution; values from left to right are 40.27, 53.41, 66.55, 79.69, 92.83, 105.97, and 119.11." width="700" height="411" title="" /><div class="wp-caption-text" id="caption-attachment-209">Figure 7.14. Normal distribution with mean and standard deviation labeled for our second example.</div></div> <h3 class="import-Normal">Common Applications in Social Work</h3> <p class="import-Normal">Calculating univariate, descriptive statistics, and using distributions to visualize continuous variables can be helpful to social workers. One common example is when we use standardized assessments. These structured tools have gone through rigorous research, with a systematic or uniform method of administration and scoring. Often, standardized assessments include information about what is called a general norm sample. The researchers who created the assessment administered it with a large, representative sample of people. Then, from this research, they determined a general normal sample mean or average score for the assessment, as well as a standard deviation, or the amount of variability in this sample. This information is provided to clinicians so that they can then compare their client or group of clients to the general norm sample mean and standard deviation.</p> <h4 class="import-Normal">Example: Plotting Client Scores with Standardized Assessments</h4> <p class="import-Normal">Imagine we use a standardized assessment of anxiety for our clients; the scoring manual provides the following information:</p> <ul><li>Mean = 50.</li> <li>Standard deviation = 12.</li> <li>Interpretation information: If clients have a score that is more than 2 standard deviations above the mean, their scores are considered clinically significant. If they fall between 1 and 2 standard deviations above the mean, then their symptoms are considered “elevated.”</li> <li>So, if clients score higher than 74, they are clinically significant scores, and if clients score between 62 and 74, they have elevated scores.</li> </ul> <p class="import-Normal">You have four clients take the assessment, and their scores are as follows: Jhmira scores a 47, Rodney scores a 59, Sarah scores a 68, and Lupita scores an 84. Figure 7.15&nbsp; shows where their scores fall in relation to the normal distribution of the general norm sample (the mean is plotted at 50).</p> <div class="wp-caption aligncenter" id="attachment_210" aria-describedby="caption-attachment-210" style="width: 700px"><img class="wp-image-210" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/039_all-1.png" alt="Normal distribution, with areas between 62 and 74 (which is between 1 and 2 standard deviations above the mean) shaded gray, and the area between 74 and 86 (which is 2 and 3 standard deviations above the mean) shaded black. Then, four client shows are marked (Jhmira = 47 and Rodney = 59) do not fall in the shaded areas. Sarah = 68 scored in the gray area, and Lupita = 84 scored in the black area." width="700" height="452" title="" /><div class="wp-caption-text" id="caption-attachment-210">Figure 7.15. Four client scores plotted on a normal distribution.</div></div> <p>Using this general norm sample’s normal distribution from the scoring manual, you can then determine the following about your clients:</p> <ul><li>Jhmira and Rodney do not have elevated or clinically significant symptoms.</li> <li>Sarah has elevated symptoms.</li> <li>Lupita has clinically significant symptoms.</li> </ul> <h2 class="import-Normal" style="margin-left: 18pt;">Shapes of Distributions</h2> <p class="import-Normal" style="margin-left: 18pt;">Distributions of data can vary, which can affect their shape. Although we can approximate the normal distribution (which can be helpful for understanding where proportions of scores fall based on the key features of the normal distribution), we do not always have data that resemble the normal distribution. Thus, we have to examine the shapes of our distributions to assess for issues of kurtosis and skew. This book briefly describes how kurtosis and skew, two descriptive statistics, can help describe the shape of a distribution.</p> <p class="import-Normal" style="margin-left: 18pt;"><strong><em><span class="glossary-term">Kurtosis</span></em></strong> assesses the “peakedness” of a distribution, which reflects the weight of the distribution’s tails. A normal distribution has a <strong><em><span class="glossary-term">mesokurtic shape</span></em></strong>. When a distribution has high levels of kurtosis, known as a<strong><em><span class="glossary-term">leptokurtic shape</span></em></strong>, there are more extreme outliers that extend the tail regions. This makes the tail regions longer and flatter. The center is also more peaked from a greater concentration of data points close to the mean (almost like you’re pinching and pulling up on the top of the distribution).</p> <p class="import-Normal" style="margin-left: 18pt;">When a distribution has low levels of kurtosis, known as a <strong><em><span class="glossary-term">platykurtic shape</span></em></strong>, it has fewer cases in the tails. These distributions have fewer outliers, and data points are more evenly distributed around the center of the distribution (i.e., data points are less likely to deviate too far from the mean). This means there is lower consistency, and it makes the center almost flattened and broad in shape (almost like you’re flattening the distribution). Figure 7.16 shows these three types of kurtosis.</p> <div class="wp-caption aligncenter" id="attachment_211" aria-describedby="caption-attachment-211" style="width: 1024px"><img class="wp-image-211 size-large" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/040_Kurtosis-1.png" alt="Three distributional shapes are shown; one is flattened on top and wide (platykurtic shape, one is normal bell-shaped curve (mesokurtic shape), and one has a high thin peak (leptokurtic shape)" width="1024" height="265" title="" /><div class="wp-caption-text" id="caption-attachment-211">Figure 7.16. Distributional shapes in terms of kurtosis.</div></div> <p class="import-Normal" style="margin-left: 18pt;">With more advanced statistical analyses, checking the amount of kurtosis is an important data-checking step. A mesokurtic shape is ideal for many statistical analyses.</p> <p class="import-Normal" style="margin-left: 18pt;"><strong><em><span class="glossary-term">Skew</span> </em></strong>is the amount to which a distribution departs from being symmetrical, pulled by outliers on one side of a distribution. A normal distribution has zero skew because it is perfectly symmetrical.</p> <p class="import-Normal" style="margin-left: 18pt;">Distributions are positively skewed when outliers exist on the right side of the distribution; the distributional shape tries to account for these outliers, which stretches the tail on the right side. This leaves the rest of the distribution, including the curve and tail on the left side to be clustered.</p> <p class="import-Normal" style="margin-left: 18pt;">Distributions are negatively skewed when outliers exist on the left side of the distribution; the distributional shape tries to account for these outliers, which stretches the tail on the left side. This leaves the rest of the distribution, including the curve and tail on the right side to be clustered.</p> <p class="import-Normal" style="margin-left: 18pt;">In both cases of positive and negative skew, the mean is affected by the skew; it is pulled higher (with positive skew) or lower (with negative skew) to account for the outliers (see Figure 7.17). Thus, not only is the distributional shape no longer symmetrical, but the mean is also no longer at the top, the center of the distribution.</p> <div class="wp-caption aligncenter" id="attachment_212" aria-describedby="caption-attachment-212" style="width: 1024px"><img class="wp-image-212 size-large" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/041_Skew-1.png" alt="To show negative skew, there is a distribution that has a long tail on the left, with the peak on the right side (negative skew); in this distribution, an outlier(s) is pulling that distribution from below the mean. To show positive skew, there is a distribution that has a long tail on the right, with the peak on the left side (positive skew); in this distribution, an outlier(s) is pulling that distribution from above the mean." width="1024" height="289" title="" /><div class="wp-caption-text" id="caption-attachment-212">Figure 7.17. Negative and positive skew.</div></div> <h3 class="import-Normal" style="margin-left: 18pt;">Other Shapes</h3> <p class="import-Normal" style="margin-left: 18pt;">Finally, there are other shapes that distributions can take, including uniform and bimodal distributions. A uniform distribution (sometimes called a flat distribution) is when every value of a distribution has the same frequency or very similar frequencies. These distributions are rectangular in shape (see Figure 7.18).</p> <div class="wp-caption aligncenter" id="attachment_213" aria-describedby="caption-attachment-213" style="width: 700px"><img class="wp-image-213" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/042_Uniform-1.png" alt="A bar graph is shown, but all the bars are of similar height. This depicts a uniform distribution." width="700" height="456" title="" /><div class="wp-caption-text" id="caption-attachment-213">Figure 7.18. Example of a uniform distribution.</div></div> <p class="import-Normal" style="margin-left: 18pt;">Bimodal distributions have two points at which values cluster; that is, they have two modes (see Figure 7.19).</p> <div class="wp-caption aligncenter" id="attachment_214" aria-describedby="caption-attachment-214" style="width: 700px"><img class="wp-image-214" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/043_bimodal-1.png" alt="A distribution is shown that has two peaks; this depicts a bimodal distribution" width="700" height="430" title="" /><div class="wp-caption-text" id="caption-attachment-214">Figure 7.19. Example of a bimodal distribution.</div></div> <h2 class="import-Normal" style="margin-left: 18pt;">Summary</h2> <p class="import-Normal" style="margin-left: 18pt;">This chapter highlighted visualizations of how values in a dataset are organized and dispersed. These graphs can help assess for a normal distribution shape and show whether there are concerns with kurtosis or skew. You can also assess for a uniform or bimodal distribution. However, if you have a shape that resembles the normal distribution, you can plot the mean and standard deviation. This visualization can be helpful when using standardized assessments and comparing client scores to standard norm scores. Also, we will return to the importance of the normal distribution shape in Chapter 11 because the normal shape is used in an array of inferential statistics.</p> <p class="import-Normal" style="margin-left: 18pt;">As a recap, our normal distribution has three key features:</p> <ul><li>The mean, median, and mode are all the same value at the center, the high point of the distribution.</li> <li>It is symmetrical; if you folded the distribution in half, you’d have mirror images; 50% of the distribution is below the mean, median, and mode, and 50% of the distribution is above the mean, median, and mode.</li> <li>Approximately 68.27% of scores are located within 1 standard deviation below and above the mean, 95.45% of scores are within 2 standard deviations below and above the mean, and 99.73% of scores are within 3 standard deviations below and above the mean.</li> </ul> </div> 
	</div>
			
				
				
	</div>

</div>
<div class="part-wrapper" id="part-unit-iii-standard-normal-distribution-and-z-scores-wrapper">
    <div class="part  " id="part-unit-iii-standard-normal-distribution-and-z-scores">
	<div class="part-title-wrap">
		<p class="part-number">III</p>
		<h1 class="part-title">Unit 3. Standard Normal Distribution and z-Scores</h1>
	</div>
	<div class="ugc part-ugc">
		<p>This next section will illustrate how we can standardize our variables, which will allow for comparisons and answer questions about probability.</p>
	</div>
			
				
	</div>
<div class="chapter standard " id="chapter-chapter-8-the-standard-normal-distribution-and-z-scores" title="Chapter 8: The Standard Normal Distribution and z-Scores">
	<div class="chapter-title-wrap">
		<p class="chapter-number">28</p>
		<h1 class="chapter-title">Chapter 8: The Standard Normal Distribution and z-Scores</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-8:-the-standard-normal-distribution-and-z-scores-"><h2>Standardization</h2> <p class="import-Normal">In Chapter 7, we saw that the normal distribution has key features of central tendency and a symmetrical shape, and we also saw where the scores are located (e.g., approximately 68.27% of scores are located within 1 standard deviation below and above the mean, 95.45% of scores are within 2 standard deviations below and above the mean, and 99.73% of scores are within 3 standard deviations below and above the mean). Most inferential statistics are built on the assumption that data are normally distributed, so we have to check for outliers that may skew our distributions or show leptokurtic or platykurtic shapes. We’ll proceed in this book under the assumption that we have checked for these deviations, and we’ll be working with normally distributed data.</p> <p class="import-Normal">Depending on whether we have a population or a sample, we can use our mean and standard deviation as guidelines for plotting information on a normal distribution. This can be a helpful visual representation, especially if you are using assessment tools that provide information on a general norm sample. This allows you to see how your client or participant scores in relation to this sample.</p> <p class="import-Normal">However, what if we want to compare variables that are on different scales? Or what if we want to compare the same variable across different samples or populations? In these cases, we can standardize our scores so that they all use the same scaling.</p> <h3 class="import-Normal">Example: Referrals Using Different Standardized Assessments for Generalized Anxiety Disorder</h3> <p class="import-Normal">A private practice is starting a group treatment program for generalized anxiety disorder. Participants will be selected for treatment based on their anxiety screening assessment scores. Referral sources use a variety of different anxiety assessments, so the practice needs to find a way to standardize across these different assessments to compare potential participants.</p> <p class="import-Normal">For this example and anytime you want to convert scores on the same scale, you can standardize raw scores (from their original scoring) into standard scores. This allows you to compare variables that are on different scales, or variables that come from different samples or populations. We can calculate standard scores so that we can compare scores using the same scaling.</p> <p class="import-Normal">Let’s say the practitioners want to compare Potential Participant 1 to Potential Participant 2. Here’s their information:</p> <ul><li>Potential Participant 1: <ul><li>Raw Score: 78</li> <li>Standardized Assessment: General norm sample mean is 70, and standard deviation is 10.</li> </ul> </li> <li>Potential Participant 2: <ul><li>Raw Score: 66</li> <li>Standardized Assessment: General norm sample mean is 50, and standard deviation is 12.</li> </ul> </li> </ul> <p class="import-Normal">We can use <em>z</em>-scores and the standard normal distribution to standardize their scores and help us make an informed decision.</p> <div class="wp-caption aligncenter" id="attachment_222" aria-describedby="caption-attachment-222" style="width: 810px"><img class="wp-image-222 size-full" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/08.1.jpg" alt="Four people are sitting in a group therapy session." width="810" height="540" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/08.1.jpg 810w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/08.1-300x200.jpg 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/08.1-768x512.jpg 768w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/08.1-65x43.jpg 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/08.1-225x150.jpg 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/08.1-350x233.jpg 350w" sizes="auto, (max-width: 810px) 100vw, 810px" title="" /><div class="wp-caption-text" id="caption-attachment-222">Figure 8.1 “<a href="https://www.pexels.com/photo/people-in-a-psychotherapy-session-7579310/" target="_blank" rel="noopener" data-url="https://www.pexels.com/photo/people-in-a-psychotherapy-session-7579310/">People in a Psychotherapy Session</a>” by <a href="https://www.pexels.com/@shkrabaanthony/" target="_blank" rel="noopener" data-url="https://www.pexels.com/@shkrabaanthony/">Antoni Shkraba Studio</a>, via <a href="https://www.pexels.com/" target="_blank" rel="noopener" data-url="https://www.pexels.com/">Pexels</a>, 2021. <a href="https://www.pexels.com/license/" target="_blank" rel="noopener" data-url="https://www.pexels.com/license/">Pexels license</a>.</div></div> <h2 class="import-Normal">Standard Normal Distribution and <em>z</em>-Scores</h2> <p class="import-Normal">In the process of converting our raw scores to <em>z</em>-scores, we will be plotting our <em>z</em>-scores on the standard normal distribution. The <strong><em><span class="glossary-term">standard normal distribution</span></em></strong> has a mean of 0 (at the center of the distribution), and a standard deviation of 1 (lines going above and below the mean at the center of the distribution are in increments of 1) (see Figure 8.2). Thus, if a <em>z</em>-score is positive, it is above the mean (of 0). If a <em>z</em>-score is negative, it is below the mean (of 0). Thus, you can transform any raw scores into <em>z</em>-scores, plot them on the standard normal distribution, and then easily make comparisons because they are on the same standard scale.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-222" style="width: 700px"><img class="wp-image-1190" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-8.1R-1.png" alt="Standard normal distribution with -3, -2, -1, 0, 1, 2, 3 along the x-axis. Negative z-scores are labeled if they fall below the mean of 0. Positive z-scores are labeled if they fall above the mean of 0." width="700" height="407" title="" /><div class="wp-caption-text">Figure 8.2. The standard normal distribution.</div></div> <p class="import-Normal">To compute a <strong><em><span class="glossary-term">z-score</span></em></strong> for an individual, you will need to know the population or sample mean and standard deviation (often provided to you in assessment guides, scoring manuals, research articles, etc.). Because you are using the standard normal distribution (which is scaled in terms of standard deviations), the <em>z</em>-score represents the number of standard deviations that a score is from the mean. Thus, you need three pieces of information for the equation:</p> <ul><li>Raw score (<em>x</em>): This is the score that you want to convert.</li> <li>Population or sample mean (𝜇 or <em>x̅</em>): this is the mean of the group you are comparing your participant’s score to.</li> <li>Population or sample standard deviation (𝜎 or <em>s</em>): This is the standard deviation of the group you are comparing your participant’s score to.</li> </ul> <div class="textbox shaded"><h3>Formula 8.1. Calculating <em>z-</em>score</h3> <p><strong>Formula for <em>z</em>-score (population):</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyh4IC0gXG11KX17XHNpZ21hfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(x - \mu)}{\sigma}" title="z = \frac{(x - \mu)}{\sigma}" class="latex mathjax" /></p> <p><strong>Formula for <em>z</em>-score (sample):&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyh4IC0gXGJhcnt4fSl9e3N9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(x - \bar{x})}{s}" title="z = \frac{(x - \bar{x})}{s}" class="latex mathjax" /></p> </div> <p><span style="text-align: initial; font-size: 14pt;">So, in following the order of operations, you’ll first subtract within the parentheses: Take the raw score minus the population or sample mean. Next, you’ll take that difference and divide by the population or sample standard deviation.</span></p> <p class="import-Normal">Key points about these calculations are as follows:</p> <ul><li><em>z</em>-Scores can be positive or negative. <ul><li>Positive <em>z</em>-scores are above the mean of 0.</li> <li>Negative <em>z</em>-scores are below the mean of 0.</li> </ul> </li> <li><em>z</em>-Scores can be 0 (if the raw score is the same value as the population or sample mean).</li> </ul> <p class="import-Normal">So, if an individual has a <em>z</em>-score of 1.5, they are 1.5 standard deviations above the mean. If they have a <em>z</em>-score of -0.75, they are 0.75 standard deviations below the mean.</p> <p class="import-Normal">Going back to our example, we can standardize our two potential participants’ anxiety assessment scores:</p> <ul><li>Potential Participant 1: <ul><li>Raw Score: 78</li> <li>The general norm mean is 70, and the standard deviation is 10.</li> </ul> </li> </ul> <div class="textbox textbox--examples"><div class="textbox__header"><h3 class="textbox__title">Example 8.1. Finding <em>z</em>-Score for Participant 1</h3> </div> <div class="textbox__content"><p><strong>Formula for <em>z</em>-score:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyh4IC0gXG11KX17XHNpZ21hfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(x - \mu)}{\sigma}" title="z = \frac{(x - \mu)}{\sigma}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyg3OCAtIDcwKX17MTB9PTAuODA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(78 - 70)}{10}=0.80" title="z = \frac{(78 - 70)}{10}=0.80" class="latex mathjax" /></p> </div> </div> <p>Their <em>z</em>-score is 0.80, so we know that this score is above the mean (i.e., it’s a positive score).</p> <ul><li>Potential Participant 2: <ul><li>Raw Score: 66</li> <li>The general norm mean is 50, and the standard deviation is 12.</li> </ul> </li> </ul> <div class="textbox textbox--examples"><div class="textbox__header"><h3 class="textbox__title">Example 8.2. Finding <em>z</em>-Score for Participant 2</h3> </div> <div class="textbox__content"><p><strong>Formula for <em>z</em>-score:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyh4IC0gXG11KX17XHNpZ21hfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(x - \mu)}{\sigma}" title="z = \frac{(x - \mu)}{\sigma}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyg2NiAtIDUwKX17MTJ9PTEuMzM&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(66 - 50)}{12}=1.33" title="z = \frac{(66 - 50)}{12}=1.33" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">Their <em>z</em>-score is 1.33, so we know that this score is also above the mean (i.e., it’s a positive score), and it is higher than Potential Participant 1’s score.</span></p> <p class="import-Normal">We can then plot both of their <em>z</em>-scores on the standard normal distribution (see Figure 8.3). From this comparison, we can see that Potential Participant 2 has a higher anxiety score, so this individual will likely get the next spot in the group treatment program.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-222" style="width: 700px"><img class="wp-image-1191" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-8.2R-1.png" alt="Standard normal distribution with potential participant&amp;#039;s z-scores (0.80 and 1.33) labeled." width="700" height="439" title="" /><div class="wp-caption-text">Figure 8.3. Standard normal distribution with two potential participant’s <em>z</em>-scores labeled.</div></div> <h3 class="import-Normal">Example: Multiple Assessments for the Same Person</h3> <p class="import-Normal">Another time <em>z</em>-scores can be helpful is when you have multiple assessments for the same person. For example, you may have a client complete an anxiety assessment and a depression assessment. You can take their scores, even if they are on different assessments with their own scaling systems, and convert them into <em>z</em>-scores. This will allow you to visualize an array of scores for one client all on one visual for a more comprehensive understanding.</p> <p class="import-Normal">Let’s say your client, Sally, completed an anxiety assessment and a depression assessment. From each scoring manual, you pull out the following information:</p> <ul><li>Anxiety: <em>x</em> = 75, <em>x̅</em> <span style="font-size: 14pt;">= 70, </span><em style="font-size: 14pt;">s</em> <span style="font-size: 14pt;">= 10</span></li> <li>Depression: <em>x</em> = 85, <em>x̅</em> <span style="font-size: 14pt;">= 90, </span><em style="font-size: 14pt;">s</em> <span style="font-size: 14pt;">= 10</span></li> </ul> <p class="import-Normal">You’ll then calculate Sally’s two z-scores and plot them on the standard normal distribution.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 8.3. Calculating <em>z</em>-Scores for Multiple Assessments</h4> </div> <div class="textbox__content"><p><strong>Formula for <em>z</em>-score:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyh4IC0gXG11KX17XHNpZ21hfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(x - \mu)}{\sigma}" title="z = \frac{(x - \mu)}{\sigma}" class="latex mathjax" /></p> <p><strong>Our example:</strong></p> <p><strong>Anxiety</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyg3NSAtIDcwKX17MTB9PTAuNTA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(75 - 70)}{10}=0.50" title="z = \frac{(75 - 70)}{10}=0.50" class="latex mathjax" /></p> <p><strong>Depression</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyg4NSAtIDkwKX17MTB9PS0wLjUw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(85 - 90)}{10}=-0.50" title="z = \frac{(85 - 90)}{10}=-0.50" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">From these calculations, we can see that Sally’s anxiety score is 0.50 standard deviations above the mean, whereas her depression score is 0.50 standard deviations below the mean (see Figure 8.4). This information may help prioritize addressing her anxiety symptoms, given the higher <em>z</em>-score relative to her depression score.</span></p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-222" style="width: 700px"><img class="wp-image-1198" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-8.3R-1-1.png" alt="Standard normal distribution with depression (z = -.50) and anxiety (z = .50) scores labeled." width="700" height="438" title="" /><div class="wp-caption-text">Figure 8.4. Using the standard normal distribution to compare across assessments.</div></div> <h2 class="import-Normal">Interpreting <em>z</em>-Scores: Areas Under the Standard Normal Distribution Curve</h2> <p class="import-Normal"><em>z</em>-Scores can be further interpreted in terms of proportion (e.g., describe the proportion or percentage of a group with a certain attribute) and probability (e.g., predict the probability or likelihood that someone may obtain a particular score); you can use Table A.1 in the Appendix to look up areas between your <em>z</em>-score and the mean, as well as the area beyond your <em>z</em>-score. These areas can be used to describe the proportion of a population with scores less than a particular <em>z</em>-score, or probability (e.g., what is the probability of scoring higher than a positive <em>z</em>-score?).</p> <p class="import-Normal">After you calculate someone’s <em>z</em>-score, you can use Table A.1 to learn more about their score. For example, you may be curious about what percentage of people scored higher than your client’s z-score or what percentage of people scored between the mean and your client’s <em>z</em>-score. Table A.1 allows you to look up a z-score and understand what proportion of people’s scores fell in a particular area of the distribution.</p> <p class="import-Normal">To use Table A.1, first, you’ll calculate your <em>z</em>-score. Then, you’ll find that z-score in the first column of the table. In that row, you have two additional pieces of information: (1) In the second column, you’ll find the proportion of scores that fall between the mean (of 0) and that <em>z</em>-score. This is known as the <em>area between mean and z</em> (pictured in red in Figure 8.5). (2) In the third column, you’ll find the proportion of scores that fall beyond the <em>z</em>-score, known as the <em>area beyond z</em> (pictured in blue in Figure 8.5).</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-222" style="width: 700px"><img class="wp-image-1193" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-8.4R-1.png" alt="Standard normal distribution with z = 1.00 labeled. There is an area between the mean of 0 and z = 1 that is colored in red, and the area from z = 1 and beyond colored in blue" width="700" height="375" title="" /><div class="wp-caption-text">Figure 8.5. Using <em>z</em>-scores to assess areas under the standard normal distribution.</div></div> <p class="import-Normal">For example, if we look up a <em>z</em>-score of 1.00, we see that the area between the mean and <em>z</em> is 0.3413 (see Table 8.1). If we convert this area to a percentage (by multiplying by 100), then we see that 34.13% of cases fall between the <em>z</em>-score of 1.00 and a mean of 0.</p> <table style="width: 602px;" cellpadding="0pt 5.4pt"><caption>Table 8.1. Excerpt from Table A.1 (<em>z</em> = 1.00)</caption> <thead><tr style="height: 15pt;"><th class="shaded" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 127.016px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Negative <em>z</em>-score</strong></p> </th> <th class="shaded" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 119.312px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Positive <em>z</em>-score</strong></p> </th> <th class="shaded" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 187.734px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Area between mean and <em>z</em></strong></p> </th> <th class="shaded" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 105.438px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Area beyond <em>z</em></strong></p> </th> </tr> </thead> <tbody><tr class="TableNormal-R" style="height: 15pt;"><td class="TableNormal-C" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 127.016px;"><p class="import-Normal" style="text-align: center;"><strong>-1.00</strong></p> </td> <td class="TableNormal-C" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 119.312px;"><p class="import-Normal" style="text-align: center;"><strong>1.00</strong></p> </td> <td class="TableNormal-C" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 187.734px;"><p class="import-Normal" style="text-align: center;"><strong>0.3413</strong></p> </td> <td class="TableNormal-C" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 105.438px;"><p class="import-Normal" style="text-align: center;"><strong>0.1587</strong></p> </td> </tr> </tbody> </table> <p class="import-Normal">From the table, you can also see that the area beyond <em>z</em> is 0.1587. Converting this to a percentage, we see that 15.87% of scores fall beyond a <em>z</em>-score of 1.00. The area beyond is also known as the <em>tail area</em> of the distribution.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-222" style="width: 700px"><img class="wp-image-1194" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-8.5R-1.png" alt="Standard normal distribution with z = 1 labeled. The area (in red) between mean and z is equal to 0.3413 or 34.13% and the area (in blue) beyond z is 0.1587 or 15.87%." width="700" height="461" title="" /><div class="wp-caption-text">Figure 8.6. Using a <em>z</em>-score to understand areas under the standard normal distribution.</div></div> <p class="import-Normal">Based on what we know about the normal distribution, we know that this shape is symmetrical (see Figure 8.6). So, the second and third column areas (red and blue areas in Figure 8.6) sum to 0.50 for their total area, meaning this area accounts for 50% of scores. Take any row in Table A.1, and the second and third columns will total 0.50.</p> <p class="import-Normal">Let’s look at a <em>z</em>-score of 1.00. We have two areas: the area between mean and <em>z</em> = 0.3413 and the area beyond <em>z</em> = 0.1587. If we add these two areas together, we get 0.3413 + 0.1587 = 0.50.</p> <table style="width: 602px;" cellpadding="0pt 5.4pt"><caption>Table 8.2. Excerpt from Table A.1 (<em>z</em> = -1.00)</caption> <thead><tr style="height: 15pt;"><th class="shaded" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 125.922px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Negative <em>z</em>-score</strong></p> </th> <th class="shaded" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 119px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Positive <em>z</em>-score</strong></p> </th> <th class="shaded" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 186.344px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Area between mean and <em>z</em></strong></p> </th> <th class="shaded" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 108.234px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Area beyond <em>z</em></strong></p> </th> </tr> </thead> <tbody><tr class="TableNormal-R" style="height: 15pt;"><td class="TableNormal-C" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 125.922px;"><p class="import-Normal" style="text-align: center;"><strong>-1.00</strong></p> </td> <td class="TableNormal-C" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 119px;"><p class="import-Normal" style="text-align: center;"><strong>1.00</strong></p> </td> <td class="TableNormal-C" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 186.344px;"><p class="import-Normal" style="text-align: center;"><strong>0.3413</strong></p> </td> <td class="TableNormal-C" style="vertical-align: bottom; padding: 0pt 5.4pt; border: 0.5pt solid windowtext; width: 108.234px;"><p class="import-Normal" style="text-align: center;"><strong>0.1587</strong></p> </td> </tr> </tbody> </table> <p class="import-Normal">Also, because the distribution is symmetrical, you can use the information in Table A.1 for both positive and negative <em>z</em>-scores (see Table 8.2). For example, if you have a <em>z</em>-score of -1.00, you’d look up 1.00 and pull this same information about the red and blue areas. However, you would shade in these areas on the left-hand side of the distribution (because the negative scores are below the mean of 0 (see Figure 8.7). You’d still have an area between the mean and <em>z</em> of 0.3413, along with an area beyond <em>z</em> of 0.1587 (totaling 0.50). The only difference is that these areas are shaded on the left-hand, or negative side.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-222" style="width: 700px"><img class="wp-image-1195" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-8.6R-1.png" alt="Standard normal distribution with z = -1 labeled. The area (in red) between mean and z is equal to 0.3413 or 34.13% and the area (in blue) beyond z is 0.1587 or 15.87%." width="700" height="461" title="" /><div class="wp-caption-text">Figure 8.7. Example with <em>z</em> = −1, which has the same areas as <em>z</em> = 1, just on the negative side, illustrating the symmetrical nature of the distribution.</div></div> <p class="import-Normal">We often use <em>z</em>-score tables to help us answer questions about probability. For example, if you have a positive <em>z</em>-score, you may be interested in the probability of someone scoring <em>higher</em> than that positive score. To determine this, you would look up the <em>area beyond z</em> in the table.</p> <p class="import-Normal">In an earlier example, Sally scored <em>z</em> = 0.50 on their anxiety assessment. You are curious about the probability of someone scoring higher than Sally, so you look up <em>z</em> = 0.50 in Table A.1 and find that the area beyond z = 0.3085. Converting to a percentage, this means that there is a 30.85% probability of someone scoring higher than Sally (see Figure 8.8).</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-222" style="width: 700px"><img class="wp-image-1196" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-8.7R-1.png" alt="Standard normal distribution with z = .50 labeled. There is an arrow indicating the area beyond z is .3085 or 30.85%." width="700" height="453" title="" /><div class="wp-caption-text">Figure 8.8. Sally’s anxiety assessment score and the probability of scoring higher than <em>z</em> = 0.50.</div></div> <p class="import-Normal">Sally also scored <em>z</em> = −0.50 on their depression assessment (so their score was on the negative side of the distribution). You could use this same information to see what the probability is of someone scoring <em>lower</em> than that negative score. So, using the <em>area beyond z</em>, there is also a 30.85% probability of someone scoring lower than Sally (see Figure 8.9).</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-222" style="width: 700px"><img class="wp-image-1197" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-8.8R-1.png" alt="Standard normal distribution with z = -.50 labeled. There is an arrow indicating the area beyond z is .3085 or 30.85%." width="700" height="457" title="" /><div class="wp-caption-text">Figure 8.9. Sally’s depression assessment score and the probability of scoring lower than <em>z</em> = −0.50.</div></div> <p>&nbsp;</p> <p class="import-Normal">If you had another client who scored <em>z</em> = −2.50, you could look up this z-score to find the area beyond z (which would be 0.0062). This means that there is a 0.62% probability that someone would score lower than this client. This information can be helpful if you need to compare this client to Sally (30.85% versus 0.62% probability).</p> <h2 class="import-Normal">Putting It All Together: Example With an Executive Functioning Assessment</h2> <p class="import-Normal">Let’s work through one more example involving calculating <em>z</em>-scores, plotting them on the standard normal distribution, and using the <em>z</em>-score tables. For this example, you are a clinician who will assess clients’ executive functioning before starting an intervention for attention-deficit hyperactivity disorder (ADHD). You use a standardized assessment, where scores range from 0 (low executive functioning problems) to 150 (high executive functioning problems), on a 1-point interval. Among children who seek services for ADHD interventions, the mean and standard deviation are <em>μ </em><span style="font-size: 14pt;">= 92.5, <em>σ</em></span><span style="font-size: 14pt;">&nbsp;= 15.5.</span></p> <p>The scoring manual also specifies that children who score higher than 105 typically qualify for intervention. To get set up for screening participants, you want to answer the following: What is the probability that children will have a score greater than 105 (i.e., the probability of children qualifying for services)?</p> <p class="import-Normal">The first step is to calculate the z-score associated with a raw score of 105 (<em>x</em> = 105).</p> <div class="textbox textbox--examples"><div class="textbox__header"><h3 class="textbox__title">Example 8.4. Calculating z-Score for <em>x</em> = 105</h3> </div> <div class="textbox__content"><p><strong>Formula for <em>z</em>-score:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyh4IC0gXG11KX17XHNpZ21hfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(x - \mu)}{\sigma}" title="z = \frac{(x - \mu)}{\sigma}" class="latex mathjax" /></p> <p><strong>Our example:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeygxMDUgLSA5Mi41KX17MTUuNX09MC44MQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(105 - 92.5)}{15.5}=0.81" title="z = \frac{(105 - 92.5)}{15.5}=0.81" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">Next, you can look up the <em>area beyond z</em> in Table A.1 to determine the probability of children scoring greater than 105. The <em>area beyond z</em> for a <em>z</em>-score of 0.81 is 0.2090, or 20.90% (see Figure 8.10). Thus, there is a 20.90% probability that children will score higher than 105 and will be recommended for the intervention.</span></p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-222" style="width: 700px"><img class="wp-image-1199" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-8.9R-1.png" alt="Standard normal distribution with z = .81. There is an arrow showing that the area beyond z-score is 0.2090or 20.90%." width="700" height="454" title="" /><div class="wp-caption-text">Figure 8.10. Standard normal distribution with <em>z</em> = 0.81 (with a 20.90% probability of scoring higher than <em>z</em> = 0.81).</div></div> <p class="import-Normal">As we continue into Chapter 9, we’ll see more examples of how we can use the <em>z</em>-score tables to help us answer questions about probability.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">This chapter highlighted the utility of converting raw scores into <em>z</em>-scores, which utilizes the standard normal distribution. This distribution has a mean of 0 (at the center of the distribution), and a standard deviation of 1 (lines going above and below the mean at the center of the distribution are in increments of 1). If a <em>z</em>-score is positive, it is above the mean (of 0). If a <em>z</em>-score is negative, it is below the mean (of 0). Thus, you can transform any raw scores into z-scores and plot them on the standard normal distribution, and then you can easily make comparisons because they are on the same standard scale. We can use Table A.1 to further understand <em>z</em>-scores, examining the percentage of cases that fall in certain areas (between a <em>z</em>-score and the mean; the area beyond a <em>z</em>-score). This can be especially helpful if you have questions about the probability of scoring higher or lower than a positive or negative <em>z</em>-score, respectively.</p> </div> 
	</div>
			
				
				
	</div>
<div class="chapter standard " id="chapter-chapter-9-percentile-scores-and-cut-off-scores" title="Chapter 9: Percentile Scores and Cutoff Scores">
	<div class="chapter-title-wrap">
		<p class="chapter-number">29</p>
		<h1 class="chapter-title">Chapter 9: Percentile Scores and Cutoff Scores</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-9:-percentile-scores-and-cut-off-scores"><p class="import-Normal">In Chapter 8, we saw the utility of the standard normal distribution, calculating <em>z</em>-scores, and using a <em>z</em>-score table (Table A.1) to answer questions about probability. This chapter continues applications using <em>z</em>-scores: percentile scores and cutoff scores. Both can be used to further describe a single variable.</p> <h2 class="import-Normal">Percentile Scores</h2> <p class="import-Normal">Another way in which <em>z</em>-scores can be helpful, especially when you want to make comparisons, is by calculating percentile scores. When we calculate<strong><em><span class="glossary-term">percentile scores</span></em></strong>, we find out the percentage of scores that fall below the observed score. We commonly see percentile scores used in standardized student tests (e.g., ACT or SAT); if you score in the 80<sup>th</sup> percentile, for example, then you scored higher in that domain than 80% of other people who took the test. Percentile scores are also helpful when tracking growth for children; if your child is in the 50<sup>th</sup> percentile for height, they are taller than 50% of other children that age.</p> <div class="wp-caption aligncenter" id="attachment_234" aria-describedby="caption-attachment-234" style="width: 600px"><img class="wp-image-234" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/9.1.jpg" alt="A person writes on a piece of paper that is attached to a clipboard." width="600" height="900" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/9.1.jpg 1650w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/9.1-200x300.jpg 200w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/9.1-683x1024.jpg 683w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/9.1-768x1152.jpg 768w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/9.1-1024x1536.jpg 1024w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/9.1-1365x2048.jpg 1365w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/9.1-65x98.jpg 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/9.1-225x338.jpg 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/9.1-350x525.jpg 350w" sizes="auto, (max-width: 600px) 100vw, 600px" title="" /><div class="wp-caption-text" id="caption-attachment-234">Figure 9.1.&nbsp;<span class="TextRun SCXW67479708 BCX0" xml:lang="EN-US" data-contrast="auto"><span class="NormalTextRun SCXW67479708 BCX0">“</span></span><a href="https://www.pexels.com/photo/a-woman-writing-on-a-paper-9064742/" target="_blank" rel="noopener" data-url="https://www.pexels.com/photo/a-woman-writing-on-a-paper-9064742/">A Woman Writing on a Paper</a><span class="TextRun SCXW67479708 BCX0" xml:lang="EN-US" data-contrast="auto"><span class="NormalTextRun SCXW67479708 BCX0">”</span></span> by <a href="https://www.pexels.com/@rdne/" target="_blank" rel="noopener" data-url="https://www.pexels.com/@rdne/">RDNE Stock project</a>, via <a href="https://www.pexels.com/" target="_blank" rel="noopener" data-url="https://www.pexels.com/">Pexels</a>, 2021. <a href="https://www.pexels.com/license/" target="_blank" rel="noopener" data-url="https://www.pexels.com/license/">Pexels license</a>.</div></div> <p class="import-Normal">To calculate a percentile score, you will first find the <em>z</em>-score and then use the <em>z</em>-table (Table A.1). The process is different depending on which side of the standard normal distribution you are on (positive versus negative):</p> <ul><li><strong>If your <em>z</em>-score is negative</strong>, you are already on the left side of the distribution, so your percentile score is the <em>area beyond z</em> (or the tail region). This area tells you what percentage of people fall below that negative <em>z</em>-score.</li> <li><strong>If your <em>z</em>-score is positive</strong>, you are now on the right side of the distribution, which means you scored higher than those who would fall in the <em>area between the mean and z,</em> as well as the entire left side of the distribution (i.e., all the negative scores, so 0.50, or 50%). To find your percentile score, you’ll take the <em>area between the mean and z</em> + 0.50. This total area tells you the percentage of people who fall below that positive <em>z</em>-score.</li> </ul> <h3 class="import-Normal">Example: Percentile Scores for Assessment of Executive Functioning</h3> <p class="import-Normal">In Chapter 8, our example used a standardized assessment of executive functioning, with <em>μ </em><span style="font-size: 14pt;">= 92.5, <em>σ</em></span><span style="font-size: 14pt;">&nbsp;= 15.5.</span> Let’s find percentile scores for two clients who are screened for the attention-deficit hyperactivity disorder (ADHD) intervention:</p> <ul><li>Client A scores a 65 on the assessment. What is their percentile score?</li> </ul> <div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 9.1. Calculating Percentile Score for Client A</h4> </div> <div class="textbox__content"><p><strong>Formula for <em>z</em>-score:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyh4IC0gXG11KX17XHNpZ21hfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(x - \mu)}{\sigma}" title="z = \frac{(x - \mu)}{\sigma}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyg2NSAtIDkyLjUpfXsxNS41fT0tMS43Nw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(65 - 92.5)}{15.5}=-1.77" title="z = \frac{(65 - 92.5)}{15.5}=-1.77" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">Because the <em>z</em>-score is negative (z = -1.77), the <em>z</em>-score for Client A will be on the left side of the distribution (1.77 standard deviations below the mean; see Figure 9.2). To find their percentile score, you would look up the <em>z</em>-score in Table A.1 and look up the <em>area beyond z,</em> which is 0.0384. Convert this to a percentage (3.84%). So, Client A scored higher on executive functioning than only 3.84% of all other clients.</span></p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-234" style="width: 700px"><img class="wp-image-1201" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-9.2R-1.png" alt="Standard normal distribution with z = -1.77 labeled. The area beyond this z-score (.0384 or 3.84%) is labeled." width="700" height="457" title="" /><div class="wp-caption-text">Figure 9.2. Client A’s percentile score (they scored higher than 3.84% of others).</div></div> <ul><li>Client B scores 101 on the executive functioning assessment. What is their percentile score?</li> </ul> <div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 9.2. Calculating Percentile Score for Client B</h4> </div> <div class="textbox__content"><p><strong>Formula for <em>z</em>-score:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyh4IC0gXG11KX17XHNpZ21hfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(x - \mu)}{\sigma}" title="z = \frac{(x - \mu)}{\sigma}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeygxMDEgLSA5Mi41KX17MTUuNX09MC41NQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(101 - 92.5)}{15.5}=0.55" title="z = \frac{(101 - 92.5)}{15.5}=0.55" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">Because the <em>z</em>-score is positive (z = 0.55), the <em>z</em>-score will be on the right side of the distribution (0.55 standard deviations above the mean; see Figure 9.3). To find their percentile score, you would look up the z-score in Table A.1 and look up the <em>area between the mean and z,</em> which is 0.2088. You’ll then add 0.2088 to 0.50 (to account for all the negative <em>z</em>-scores that this client also scored higher than): 0.2088 + 0.50 = 0.7088. Convert this to a percentage (70.88%). So, Client B scored higher than 70.88% of clients.</span></p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-234" style="width: 700px"><img class="wp-image-1202" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-9.3R-1.png" alt="Standard normal distribution with z = 0.55 labeled. The areas between mean and z-score (0.2088 or 20.88%) and area for all negative z-scores (0.50 or 50%) are labeled." width="700" height="462" title="" /><div class="wp-caption-text">Figure 9.3. Client B’s percentile score (they scored higher than 70.88% of others).</div></div> <p class="import-Normal">Percentile scores are another descriptive piece of information you can use to describe your client, participant, or patient. For another example, we will use the example from Chapter 8 where we saw that a <em>z</em>-score of 0.81 (raw score, <em>x</em> = 105) was a suggested score that would qualify clients with ADHD for intervention. First, <span style="text-align: initial; font-size: 14pt;">we convert this to a percentile score, then look up <em>z</em> = 0.81 in Table A.1 and find the <em>area between the mean and z</em> = 0.2910. Next, we add 0.50: 0.2910 + 0.50 = 0.791. Your client would need to have a percentile score of 79.1% to “qualify for services” according to the test manual.</span></p> <p class="import-Normal">However, these are recommended scores based on research with norm samples. Drawing these lines can be difficult, especially if you have clients who have a percentile score of 78% – they may have high levels of executive functioning problems but they are 1% shy of “qualifying for services” according to this assessment. Thus, assessments can be seen as a guide, with further discussion being necessary if scores fall on these thresholds.</p> <h2 class="import-Normal">Cutoff Scores</h2> <p class="import-Normal">Another application of z-scores is calculating<strong><em><span class="glossary-term">cutoff scores</span></em></strong>. These scores are useful when we are interested in a top percentage (e.g., the top 5% of scores are accepted into a group recovery program) or a bottom percentage (e.g., the bottom 10% of scores qualify for a remedial program). For cutoff scores, we will start with the percentage we are interested in and work backward to find the <em>z</em>-score and raw score (<em>x</em>) that are associated with the top or bottom percentage. You are solving for <em>x</em>, or the raw score that will serve as your cutoff score.</p> <ul><li>You will start by identifying the percentage or proportion of cases you are interested in working with.</li> <li>Then, you will find the <em>area beyond z</em> in Table A.1 that is as close to that proportion as possible. For example, if you are interested in the top 10% of cases, you’ll find the area in the <em>area beyond z</em> column as close to 0.10 as possible. This is the row where the <em>area beyond z</em> = 0.1003 (10.03%).</li> <li>Find the affiliated <em>z</em>-score in column 1. Note: If you are interested in the top percentage, you will use a positive <em>z</em>-score; if you are interested in the bottom percentage, you will make this affiliated <em>z</em>-score negative. So, if you are interested in the top 10%, your affiliated <em>z</em>-score would be 1.28; if you are interested in the bottom 10%, your affiliated <em>z</em>-score would be −1.28.</li> <li>Finally, you will plug in this <em>z</em>-score to solve for <em>x</em> (your cut-off-score):</li> </ul> <div class="textbox shaded"><h3>Formula 9.1. Calculating cutoff score</h3> <p><strong>Formula for cutoff score (population):</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eCA9IHooXHNpZ21hKSArIFxtdQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x = z(\sigma) + \mu" title="x = z(\sigma) + \mu" class="latex mathjax" /></p> <p><strong>Formula for cutoff score (sample):</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eCA9IHoocykgKyBcYmFye3h9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x = z(s) + \bar{x}" title="x = z(s) + \bar{x}" class="latex mathjax" /></p> </div> <h3 class="import-Normal">Example: Cutoff Scores for Top 10% and Bottom 15%</h3> <p class="import-Normal">Your norm sample information is <em>x̅</em> <span style="font-size: 14pt;">= 150, </span><em style="font-size: 14pt;">s</em> <span style="font-size: 14pt;">= 10</span>, and you want to find the cutoff score for the top 10%.</p> <ul><li>Identify the percentage you are interested in: top 10%.</li> <li>Find the <em>area beyond z</em> that is as close to 10% as possible: area beyond z = 0.1003.</li> <li>Affiliated <em>z</em>-score: Because you are interested in the top percentage, you will find the corresponding <em>positive z</em>-score: <em>z</em> = 1.28.</li> <li>Plug these values into the equation to solve for <em>x.</em></li> </ul> <div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 9.3. Calculating Cutoff Score (Top 10%)</h4> </div> <div class="textbox__content"><p><strong>Formula for cutoff score:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eCA9IHoocykgKyBcYmFye3h9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x = z(s) + \bar{x}" title="x = z(s) + \bar{x}" class="latex mathjax" /></p> <p><strong>Our example:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eCA9IDEuMjgoMTApICsgMTUw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x = 1.28(10) + 150" title="x = 1.28(10) + 150" class="latex mathjax" /></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eCA9IDEyLjggKyAxNTAgPSAxNjIuOA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x = 12.8 + 150 = 162.8" title="x = 12.8 + 150 = 162.8" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">So, your cutoff score = 162.8. This means an individual would have to score 162.8 or higher to be in the top 10%.</span></p> <p class="import-Normal">Let’s try this again, but now let’s say we are interested in the bottom 15%.</p> <ul><li>Identify the percentage you are interested in: bottom 15%.</li> <li>Find the <em>area beyond z</em> that is as close to 15% as possible: area beyond z = 0.1492.</li> <li>Affiliated <em>z</em>-score: Because you are interested in the bottom percentage, you will find the corresponding negative <em>z</em>-score: <em>z</em> = −1.04.</li> <li>Plug these values into the equation to solve for <em>x.</em></li> </ul> <div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 9.4. Calculating Cut-off Score (Bottom 10%)</h4> </div> <div class="textbox__content"><p><strong>Formula for cutoff score:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eCA9IHoocykgKyBcYmFye3h9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x = z(s) + \bar{x}" title="x = z(s) + \bar{x}" class="latex mathjax" /></p> <p><strong>Our example:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eCA9IC0xLjA0KDEwKSArIDE1MA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x = -1.04(10) + 150" title="x = -1.04(10) + 150" class="latex mathjax" /></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eCA9IC0xMC40ICsgMTUwID0gMTM5LjY&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x = -10.4 + 150 = 139.6" title="x = -10.4 + 150 = 139.6" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">So, your cutoff score = 139.6. This means an individual would have to score 139.6 or lower to be in the bottom 15%.</span></p> <h3 class="import-Normal">Common Cutoff Score Information</h3> <p class="import-Normal">Table 9.1 shows some of the common top or bottom percentages that may be used for calculating cutoff scores, allowing you to find the <em>area beyond z</em> that is closest to the percentage you are interested in. However, 5% is a unique case, where there are two affiliated <em>z</em>-scores that are equidistant from 5%. You can choose a <em>z-</em>score of 1.64 (5.05%) or 1.65 (4.95%), or you can take the number between them (<em>z</em> = 1.645 or −1.645) if you want to get to exactly 5%.</p> <table class="grid landscape" style="height: 144px;"><caption>Table 9.1. Common Cutoff Score Information</caption> <thead><tr class="shaded" style="height: 18px;"><th style="height: 18px; width: 102.692px;" scope="col">Top or bottom</th> <th style="height: 18px; width: 102.372px;" scope="col">Area beyond <em>z</em></th> <th style="height: 18px; width: 74.3395px;" scope="col">Area to %</th> <th style="height: 18px; width: 130.341px;" scope="col"><em>z</em>-score value (top)</th> <th style="height: 18px; width: 158.324px;" scope="col"><em>z</em>-score value (bottom)</th> </tr> </thead> <tbody><tr style="height: 18px;"><th style="height: 54px; width: 102.692px;" rowspan="3" scope="rowgroup">5%</th> <td style="height: 18px; width: 102.827px;">.0505</td> <td style="height: 18px; width: 75.2486px;">5.05%</td> <td style="height: 18px; width: 131.25px;">1.64</td> <td style="height: 18px; width: 158.778px;">−1.64</td> </tr> <tr style="height: 18px;"><td style="height: 18px; width: 102.827px;">.0495</td> <td style="height: 18px; width: 75.2486px;">4.95%</td> <td style="height: 18px; width: 131.25px;">1.65</td> <td style="height: 18px; width: 158.778px;">−1.65</td> </tr> <tr style="height: 18px;"><td style="height: 18px; width: 102.827px;">–</td> <td style="height: 18px; width: 75.2486px;">–</td> <td style="height: 18px; width: 131.25px;">(1.645)</td> <td style="height: 18px; width: 158.778px;">(−1.645)</td> </tr> </tbody> <tbody><tr style="height: 18px;"><th style="height: 18px; width: 102.692px;" scope="row">10%</th> <td style="height: 18px; width: 102.827px;">.1003</td> <td style="height: 18px; width: 75.2486px;">10.03%</td> <td style="height: 18px; width: 131.25px;">1.28</td> <td style="height: 18px; width: 158.778px;">−1.28</td> </tr> <tr style="height: 18px;"><th style="height: 18px; width: 102.692px;" scope="row">15%</th> <td style="height: 18px; width: 102.827px;">.1492</td> <td style="height: 18px; width: 75.2486px;">14.92%</td> <td style="height: 18px; width: 131.25px;">1.04</td> <td style="height: 18px; width: 158.778px;">−1.04</td> </tr> <tr style="height: 18px;"><th style="height: 18px; width: 102.692px;" scope="row">20%</th> <td style="height: 18px; width: 102.827px;">.2005</td> <td style="height: 18px; width: 75.2486px;">20.05%</td> <td style="height: 18px; width: 131.25px;">0.84</td> <td style="height: 18px; width: 158.778px;">−0.84</td> </tr> <tr style="height: 18px;"><th style="height: 18px; width: 102.692px;" scope="row">25%</th> <td style="height: 18px; width: 102.827px;">.2514</td> <td style="height: 18px; width: 75.2486px;">25.14%</td> <td style="height: 18px; width: 131.25px;">0.67</td> <td style="height: 18px; width: 158.778px;">−0.67</td> </tr> </tbody> </table> <p class="import-Normal">As with the ethical implications of percentile scores, the same applies to cutoff scores. You can use cutoff scores to help guide decisions, but further discussion is warranted if&nbsp;a client falls right below or above a specified cutoff score.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">This chapter highlighted two additional applications using <em>z</em>-scores: percentile scores and cutoff scores. Both can be used to further describe a single variable. Percentile scores can be useful when describing the percentage of scores that fall below the observed score. Cut-off scores are useful when you are interested in a top percentage (e.g., top 5%) or bottom percentage (e.g., bottom 20%) of scores. With cutoff scores, we start with the percentage we are interested in and work backward to find the <em>z</em>-score and raw score (<em>x</em>) that are associated with the top or bottom percentage.</p> </div> 
	</div>
			
				
				
	</div>

</div>
<div class="part-wrapper" id="part-unit-iv-inferential-statistics-and-hypothesis-testing-wrapper">
    <div class="part  " id="part-unit-iv-inferential-statistics-and-hypothesis-testing">
	<div class="part-title-wrap">
		<p class="part-number">IV</p>
		<h1 class="part-title">Unit 4. Introduction to Inferential Statistics and Hypothesis Testing</h1>
	</div>
	<div class="ugc part-ugc">
		<p class="import-Normal">Up to this point in the book, we have focused on describing a sample or population. With continuous variables, we have been able to describe a variable in terms of its central tendency (mode, median, and mean) and variability (range, sum of squares, variance, standard deviation), plot this information on a normal distribution, assess the shape of our distribution, and standardize variables so that we can use the standard normal distribution for comparisons and answering questions about probability.</p> <p class="import-Normal">When using the normal distribution and standard normal distribution, we focused on comparing <em>a single score </em>(<em>x</em>) to a norm sample or a population. We calculated a <em>z</em>-score for a participant and used that information to make comparisons (e.g., assess probability and percentile scores). As we move into the second half of this book, we will now be focusing on samples, seeing how <em>group scores</em> relate to the population from which they came.</p>
	</div>
			
				
	</div>
<div class="chapter standard " id="chapter-chapter-10-introduction-to-inferential-statistics" title="Chapter 10: Introduction to Inferential Statistics">
	<div class="chapter-title-wrap">
		<p class="chapter-number">30</p>
		<h1 class="chapter-title">Chapter 10: Introduction to Inferential Statistics</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-10:-introduction-to-inferential-statistics"><p class="import-Normal"><strong><em><span class="glossary-term">Inferential statistics</span></em></strong> allow us to draw conclusions about populations based on randomly selected samples (i.e., sampled by methods of chance, such as drawing names from a hat) from these populations. So, our focus is now on samples; in social work, this could be groups of clients or patients, groups of participants in a program or intervention, groups of students, groups of families, community samples, and so forth. We want to see how these groups relate to the population from which they come. As we discussed in Chapter 2, it is not always feasible to hear from every single person that makes up a population (e.g., <em>every</em> member of a community), so we must rely on samples (e.g., a sample of 100 community members) and make inferences about the larger population.</p> <p class="import-Normal">For example, we may be interested in researching outcomes among people who have a substance use disorder (SUD) and are participating in motivational interviewing (for more information on motivational interviewing, see Smith [2024]). Our population would be all people who meet these criteria, but it would be impossible to survey or interview every single person who meets these criteria. So, we could take a sample of 100 clients who have a SUD and are participating in motivational interviewing. Then, we could calculate inferential statistics to make inferences about the population from which this sample of participants comes (see Figure 10.1).</p> <p>&nbsp;</p> <div class="wp-caption aligncenter" id="attachment_241" aria-describedby="caption-attachment-241" style="width: 700px"><img class="wp-image-241" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/055_inferential-pop-sample-1024x387.png" alt="Diagram showing a &amp;quot;population: individuals with substance use disorder who participate in motivational interviewing&amp;quot; - from this population, a &amp;quot;sample of 100 clients with substance use disorder who participate in motivational interviewing&amp;quot; is shown. From the sample, box, an arrow specifies that you would then &amp;quot;make inferences about the population of all individuals with substance use disorder who participate in motivational interviewing." width="700" height="264" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/055_inferential-pop-sample-1024x387.png 1024w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/055_inferential-pop-sample-300x113.png 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/055_inferential-pop-sample-768x290.png 768w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/055_inferential-pop-sample-1536x580.png 1536w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/055_inferential-pop-sample-65x25.png 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/055_inferential-pop-sample-225x85.png 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/055_inferential-pop-sample-350x132.png 350w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/055_inferential-pop-sample.png 1632w" sizes="auto, (max-width: 700px) 100vw, 700px" title="" /><div class="wp-caption-text" id="caption-attachment-241">Figure 10.1. Example showing how a sample is drawn from a population and inferences are made about that population.</div></div> <h2 class="import-Normal">Central Limit Theorem</h2> <p class="import-Normal">Anytime we take a sample from a population, there is a chance we will have <strong><em><span class="glossary-term">sampling error</span></em></strong>, or a difference between our sample statistic and the population parameter. We can assess and quantify the amount of sampling error by calculating the standard error and estimate how well we represented the population when we took a sample. We can quantify this amount of error using the central limit theorem. In most cases, we do not know what our population parameter is that we are trying to represent, so we rely on the central limit theorem to help us estimate the amount of expected sampling error (known as the standard error).</p> <p class="import-Normal">The first core tenet of the central limit theorem is that as your sample size increases, your <strong><em><span class="glossary-term">sampling distribution</span> </em></strong>of the sample statistic will approximate a normal distribution. A sampling distribution (of a statistic) is a theoretical distribution that results from taking an infinite number of random samples of the same size from the same population. This distribution is theoretical, but the tenets of the sampling distribution are used in all inferential statistics. Thus, we rely on the central limit theorem and its applications anytime we test an inferential hypothesis.</p> <p class="import-Normal">There are software programs that show simulations of the Central Limit Theorem, as well as other simulation tools used in math courses (e.g.,Hagtvedt et al., 2007; Ruggieri, 2016). Simulations have you start with a population distribution–it can be any shape (e.g., normal or non-normal shape, such as a uniform distribution or a heavily skewed distribution). Then, the simulation pulls repeated samples of the same size. For each of these samples, the mean is calculated. Then, you plot all the means from each of these samples. Once you plot all the means, your distribution will approximate the normal distribution. This is the power of the central limit theorem: Even if our population data are not normally distributed, you can rely on the sampling distribution (which approximates the normal distribution) to test your inferential research question. This is ideal; see Chapter 7 on the utility of the normal distribution.</p> <p class="import-Normal">From these simulations, the three principles of the Central Limit Theorem are illustrated. In this chapter and the next few chapters, we’ll be examining inferential tests that use sampling distributions of sample means (<em>x̅</em>) as a foundation.</p> <p class="import-Normal">The <strong><em><span class="glossary-term">central limit theorem</span></em></strong> tenets pertain to the following:</p> <ul><li><em>Shape</em>: As the sample size increases, the shape of the sampling distribution of <em>x̅</em> approximates normality (approximates the normal distribution), which allows us to use statistical analyses based on the normal distribution.</li> <li><em>Mean: </em>The mean of the sampling distribution equals the mean in the population from which samples were randomly selected.</li> <li><em>Variability: </em>The standard deviation of the sampling distribution decreases as the sample size increases; in other words, larger samples lead to more accurate estimates (with less sampling error). We can compute this expected sampling error (also known as the standard error) using the equation for calculating the standard error.</li> </ul> <div class="textbox shaded"><h3>Formula 10.1.&nbsp;Formula for standard error</h3> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fSA9IFxmcmFje1xzaWdtYX17XHNxcnR7Tn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" title="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" class="latex mathjax" /></p> </div> <p class="import-Normal">A few additional notes about these components of the central limit theorem are warranted. As a reminder, theorems are mathematical statements that have been proven to be true.</p> <p class="import-Normal">First, even if the population distribution is heavily skewed, platykurtic or leptokurtic, uniform, or any non-normal shape, but you take many large random sample means from the population, the shape of your sampling distribution of means will still approximate a normal distribution. This will allow you to run inferential statistical tests using what we know about a normal distribution.</p> <p class="import-Normal">Second, much of the central limit theorem revolves around the idea of sample size. Recommendations across texts range from minimum sample sizes of <em>N</em> &gt; 30 to as high as <em>N</em> &gt; 200 (e.g., Magsalay, 2025) for your sampling distribution shape to approximate a normal distribution. If the population distribution is strongly non-normal (e.g., heavily skewed), the larger sample size recommendations may be needed (Islam, 2018). Taking a more conservative approach, it is recommended to have sample sizes of <em>N</em> <span style="text-decoration: underline;">&gt;</span> 200 for more reliable approximations.</p> <h3 class="import-Normal">Simulation of Creating a Sampling Distribution of Means</h3> <p class="import-Normal">Let’s simulate our own sampling distribution of means. According to the U.S. Office of Juvenile Justice and Delinquency Prevention (OJJDP; Puzzanchera et al., 2025), in 2023, the average age of youth detained for juvenile offenses was 16 (<em>N</em> = 29,314). The distribution of ages is negatively skewed; most youth who were detained for a juvenile offense were between the ages of 16 and 17. Only a few youth who were detained were 13 or younger (see Figure 10.2).</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-241" style="width: 700px"><img class="wp-image-1205" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-10.2R-1.png" alt="Bar graph with age as your x-axis (ages 12 to 20), and frequency as your y-axis. The distribution is negatively skewed, with 16 and 17 as your most frequent ages." width="700" height="408" title="" /><div class="wp-caption-text">Figure 10.2. Example skewed population distribution.</div></div> <p class="import-Normal">If we wanted to ask a research question concerning this population, we would likely have to rely on a sample; it would be difficult to obtain surveys or interviews from all 29,314 youth. This is where we can rely on inferential statistics to help us sample this population. We hope to represent this population well, and minimize the amount of expected sampling error.</p> <p class="import-Normal">For our simulation, we are going to take 30 samples from this population; each sample will be 200 people. Note: In computer software simulations of creating sampling distributions, programs take very large numbers of samples (i.e., get close to infinity). This example of 30 is nowhere near these simulations, but because of space constraints, we will use it for illustrative purposes.</p> <p class="import-Normal">Across our 30 samples of 200 people each, we have the following sample means.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 10.1. Means from 30 Samples</h4> </div> <div class="textbox__content"><ol style="column-count: 4; column-gap: 60px; max-width: 600px;"><li>16.35</li> <li>16.32</li> <li>15.93</li> <li>15.92</li> <li>16.22</li> <li>15.69</li> <li>16.31</li> <li>15.73</li> <li>16.39</li> <li>15.94</li> <li>16.05</li> <li>16.38</li> <li>16.29</li> <li>16.20</li> <li>15.63</li> <li>16.04</li> <li>16.05</li> <li>16.22</li> <li>15.73</li> <li>15.61</li> <li>15.83</li> <li>15.90</li> <li>15.86</li> <li>15.70</li> <li>16.15</li> <li>15.81</li> <li>15.68</li> <li>16.29</li> <li>16.05</li> <li>15.73</li> </ol> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">Our sample means range from 15.61 to 16.39. We can apply the three principles of central limit theorem to describe our sampling distribution of </span><span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em>.</span></p> <p>In Table 10.1, we see information about our population. (Note: The standard deviation is not provided in the OJJDP report, so it is not the actual standard deviation. This value is listed for this example only.)</p> <table style="width: 467.75pt;"><caption>Table 10.1. Summary Information About Our Population&nbsp;</caption> <thead><tr><th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 5px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>𝜇</strong></p> </th> <th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 5px; vertical-align: middle;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>𝜎</strong></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 5px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Shape of population distribution</strong></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 5px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Sample size of randomly selected samples</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 23.35pt;"><td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 5px;"><p class="import-Normal" style="text-align: center;">16</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 5px;"><p class="import-Normal" style="text-align: center;">1.3</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 5px;"><p class="import-Normal" style="text-align: center;">Negatively skewed</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 5px;"><p class="import-Normal" style="text-align: center;">200</p> </td> </tr> </tbody> </table> <p class="import-Normal">Based on the information we know about the central limit theorem, Table 10.2 reports the sampling distribution of <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅.&nbsp;</em></span></p> <table><caption>Table 10.2. Summary Information About the Sampling Distribution of <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em></span></caption> <thead><tr class="shaded" style="height: 14.4pt;"><td class="shaded" style="border: 0.5pt solid windowtext; width: 90px;"><p class="import-Normal" style="text-align: center;"></p></td> <th class="shaded" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 352px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Shape</strong></p> </th> <th class="shaded" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 330px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Mean </strong></p> </th> <th class="shaded" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 341px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Variability</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 32.05pt;"><th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 90px;" scope="row"><p class="import-Normal"><strong>Notes</strong></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 352px; text-align: center;">If the size of our randomly selected samples in a simulation is <em>N</em>&gt;200, we can assume a normal shape for our sampling distribution.</td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 330px; text-align: center;">The mean of the sampling distribution equals the mean in the population from which the samples were randomly selected.</td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 341px;"><p class="import-Normal" style="text-align: center;">We can compute the expected sampling error (also known as the standard error) with the following equation:</p> <p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fSA9IFxmcmFje1xzaWdtYX17XHNxcnR7Tn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" title="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 30.25pt;"><th class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 90px;" scope="row"><p class="import-Normal"><strong>Our example</strong><strong>:</strong></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 352px;"><p class="import-Normal" style="text-align: center;">Normal</p> <p class="import-Normal" style="text-align: center;">(<em>N</em> = 200)</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 330px;"><p class="import-Normal" style="text-align: center;">16</p> <p style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=KFxtdV97XGJhcnt4fX09XG11KQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(\mu_{\bar{x}}=\mu)" title="(\mu_{\bar{x}}=\mu)" class="latex mathjax" /></p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 341px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fSA9IFxmcmFjezEuM317XHNxcnR7MjAwfX09MC4wOQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}} = \frac{1.3}{\sqrt{200}}=0.09" title="\sigma_{\bar{x}} = \frac{1.3}{\sqrt{200}}=0.09" class="latex mathjax" /></p> </td> </tr> </tbody> </table> <p class="import-Normal">We can check these aspects by examining the distribution of these 30 sample means, as shown in Figure 10.3. The shape resembles more of a bell-shaped curve or normal distribution compared with the population shape (which was skewed). As you took more samples for a simulation, you would see this shape better resemble the normal distribution.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-241" style="width: 700px"><img class="wp-image-1206" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-10.3R-1.png" alt="Frequency polygon shown, and the shape resembles more of a bell-shaped curve." width="700" height="421" title="" /><div class="wp-caption-text">Figure 10.3. Distribution of 30 sample means for our sampling distribution simulation.</div></div> <p class="import-Normal">We can also check the sampling distribution mean. If we add all 30 of our sample means, and then divide by 30, we can verify that our sampling distribution mean is 16, which is equal to the population mean of 16.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 10.2. Calculating our Sampling Distribution Mean</h4> </div> <div class="textbox__content"><p><strong>Formula for sampling distribution mean:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XG11X3tcYmFye3h9fSA9IFxmcmFje1xzdW0gXGJhcnt4fX17Tn0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu_{\bar{x}} = \frac{\sum \bar{x}}{N}" title="\mu_{\bar{x}} = \frac{\sum \bar{x}}{N}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XG11X3tcYmFye3h9fSA9IFxmcmFjezQ4MH17MzB9PTE2&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu_{\bar{x}} = \frac{480}{30}=16" title="\mu_{\bar{x}} = \frac{480}{30}=16" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">Finally, we can use our expected sampling error estimate (<img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}}" title="\sigma_{\bar{x}}" class="latex mathjax" />) in inferential statistics tests. You will see examples of how standard error is used in inferential tests in the next few chapters.</span></p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-241" style="width: 550px"><img class="wp-image-387" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/010.5-1.jpg" alt="A person is sitting with their hands in their lap." width="550" height="825" title="" /><div class="wp-caption-text">Figure 10.4. “<a href="https://www.pexels.com/photo/person-in-black-jacket-and-gray-denim-jeans-4100422/" target="_blank" rel="noopener" data-url="https://www.pexels.com/photo/person-in-black-jacket-and-gray-denim-jeans-4100422/">Person in Black Jacket and Gray Denim Jeans</a>”&nbsp;by <a href="https://www.pexels.com/@cottonbro/" target="_blank" rel="noopener" data-url="https://www.pexels.com/@cottonbro/">cottonbro studio</a>, via <a href="https://www.pexels.com/" target="_blank" rel="noopener" data-url="https://www.pexels.com/">Pexels</a>, 2020. <a href="https://www.pexels.com/license/" target="_blank" rel="noopener" data-url="https://www.pexels.com/license/">Pexels license</a>.</div></div> <p class="import-Normal">Although this simulation is only with 30 sample means, you can still see the components of the theorem in action. You could re-calculate the standard error with <em>N</em> = 2,000 and see how this reduces the standard error estimate to 0.03. This illustrates that if our random samples to make a sampling distribution are larger, we can reduce the amount of expected sampling error.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">Thanks to the central limit theorem, we know something about the shape, central tendency, and variability of the theoretical sampling distribution, which we can then use within inferential tests. We can take a single sample and compare it with the sampling distribution and assess the probability that our sample came from the same population.</p> </div> 
	</div>
			
				
				
	</div>
<div class="chapter standard " id="chapter-chapter-11-confidence-intervals" title="Chapter 11: Confidence Intervals">
	<div class="chapter-title-wrap">
		<p class="chapter-number">31</p>
		<h1 class="chapter-title">Chapter 11: Confidence Intervals</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-11:-confidence-intervals"><p class="import-Normal">In the world of inferential statistics, we are taking a sample and making inferences about the population it came from. As we read in Chapter 10, the central limit theorem provides us with a way to make inferences about a population based on a sample. We can estimate the amount of expected sampling error when we conduct inferential statistics. This chapter introduces confidence intervals, a way for us to further assess the inferences we are making.</p> <h2 class="import-Normal">Confidence Intervals</h2> <p class="import-Normal"><strong><em><span class="glossary-term">Confidence intervals</span></em></strong> provide us with a way to assess our level of confidence in representing the population; they can tell us with 95% or 99% confidence that we have represented the population with our sample statistic. Thus, confidence intervals give us a range within which the population parameter is located.</p> <ul><li><strong><em>95% Confidence Interval</em></strong>: the range within which a population parameter is located, with 95% confidence.</li> <li><strong><em>99% Confidence Interval</em></strong>: the range within which a population parameter is located, with 99% confidence.</li> </ul> <p class="import-Normal">If we think about the key features of the normal distribution, approximately 95% of scores are located within 2 standard deviations of the mean, and approximately 99% of scores are located within 3 standard deviations of the mean. So, we’ll use Table A.1 to help us find the exact standard deviations from the mean (i.e., <em>z</em>-scores) that give us 95% and 99% confidence.</p> <p class="import-Normal">With both 95% and 99% confidence intervals, there is a 5% and 1% (respectively) chance that we did not include the population parameter in our confidence interval range. Because we are using samples to make inferences, we will always have a chance for error or not representing the mean.</p> <p class="import-Normal">For example, let’s pretend we know our population mean is 50. This population mean is outlined in red at the center of the distribution in Figure 11.1; this is what we are trying to represent when we take samples. If we took three samples and calculated their means and confidence intervals, they would be plotted as shown in Figure 11.1. The mean for each sample is outlined in red, with the confidence interval brackets extending lower and higher around the mean. We would expect the population parameter to fall somewhere in that bracketed area. If it falls outside of the confidence interval, then we did not represent the population mean.</p> <p class="import-Normal">Let’s look at each sample:</p> <div class="wp-caption aligncenter" id="attachment_247" aria-describedby="caption-attachment-247" style="width: 700px"><img class="wp-image-247" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/11.1-1024x570.png" alt="Normal distribution is shown with 50 as our population mean. Three lines are shown (sample mean in middle of line, and a lower and upper bracket. These lines represent confidence intervals. Two of the lines include the population mean, while 1 does not." width="700" height="389" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/11.1-1024x570.png 1024w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/11.1-300x167.png 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/11.1-768x427.png 768w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/11.1-65x36.png 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/11.1-225x125.png 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/11.1-350x195.png 350w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/11.1.png 1528w" sizes="auto, (max-width: 700px) 100vw, 700px" title="" /><div class="wp-caption-text" id="caption-attachment-247">Figure 11.1. Samples A-C and their confidence intervals.</div></div> <ul><li><strong>Sample A</strong>: The mean is at the center of the line (<em>x̅</em> is 48), and the confidence interval gives a value below the mean and above the mean. So, from the lower value to the upper value of the confidence interval bracket, we have 95% confidence that we represented the population mean. In this example, the population mean is inside the bracketed area, so Sample A included the population parameter it was trying to represent.</li> <li><strong>Sample B</strong>: The sample mean (<em>x̅</em> is 28) and the confidence interval bracket do not include the population mean. This would be an example of the 5% of the time when your sample does not represent the population parameters.</li> <li><strong>Sample C:</strong> The sample mean (<em>x̅ </em>is 69) and the confidence interval bracket do include the population, although it is very close.</li> </ul> <p class="import-Normal">In most situations, we will not know the population parameter we are trying to represent, so we can rely on confidence intervals to say with either 95% or 99% confidence that we represented the parameter.</p> <h2 class="import-Normal">Calculating 95% Confidence Intervals</h2> <p class="import-Normal">To find the lower and upper values of our confidence intervals, we’ll use Table A.1 to find the exact proportion we are interested in (95%). If you look up <em>z</em> = 1.96 in the <em>z</em>-score table (Table A.1), you’ll see that the <em>area between the mean and z</em> = 0.475. Because your distribution is symmetrical, you have 0.475 between 1.96 and a mean of 0, and you have 0.475 between −1.96 and a mean of 0. So, together, these areas equal 0.95, which converts to a percentage of 95%. Thus, 95% of cases are located within 1.96 standard deviations of the mean.</p> <p class="import-Normal">So, when we are extending the confidence interval bracket above and below the sample mean, we can extend that 1.96 standard deviations in both directions from the sample mean. We can be 95% confident that we include the population in that confidence interval. See Figure 11.2.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-247" style="width: 700px"><img class="wp-image-1218" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-11.2R-1.png" alt="A standard normal distribution is shown with the area between z = -1.96 and 1.96 shaded in (this area totals 0.95 or 95%)." width="700" height="535" title="" /><div class="wp-caption-text">Figure 11.2. Distribution showing 95% confidence intervals (area between <em>z</em> = −1.96 and 1.96 totals 0.95, or 95%).</div></div> <p>&nbsp;</p> <p class="import-Normal">To calculate the 95% confidence interval of your population mean (again, this is what you are hoping to include when you take your sample), you will need to calculate the standard error. Note: Because we are calculating the standard error based on the central limit theorem, we will also want to make sure we have a sample size of 200 or more. This will ensure that we are approximating a normal distribution.</p> <div class="textbox shaded"><h3>Formula 11.1. Calculating 95% confidence intervals</h3> <div style="text-align: left;"><strong>Formula for 95% confidence interval of population mean:</strong></div> <div></div> <div style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=XG11ID0gXGJhcnt4fSBccG0gKDEuOTYgXHRpbWVzIHNfe1xiYXJ7eH19KQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu = \bar{x} \pm (1.96 \times s_{\bar{x}})" title="\mu = \bar{x} \pm (1.96 \times s_{\bar{x}})" class="latex mathjax" /></div> <div></div> <div></div> <div><strong>Steps for calculating 95% confidence interval of population mean:&nbsp;</strong></div> <ol><li><strong>Calculate the standard error using</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=KHNfe1xiYXJ7eH19ID0gXGZyYWN7c317XHNxcnR7Tn19KS4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(s_{\bar{x}} = \frac{s}{\sqrt{N}})." title="(s_{\bar{x}} = \frac{s}{\sqrt{N}})." class="latex mathjax" /></li> <li><strong>Multiply the standard error by 1.96.</strong> Remember, 1.96 is the z-score that will give you the proportion you are interested in: 95%.</li> <li><strong>Take the product (from step 2) and add it to the sample mean.</strong> This value becomes the upper part of your bracket or confidence interval value, above the sample mean.</li> <li><strong>Take the product (from step 2) and subtract it from the sample mean.</strong> This value becomes the lower part of your bracket or confidence interval value, below the sample mean.</li> </ol> </div> </div> <div class="chapter-11:-confidence-intervals"><h3 class="import-Normal">Example: 95% Confidence Interval for Estimating the Monthly Benefit of SNAP</h3> <p class="import-Normal">According to the U.S. Department of Agriculture (2025), individuals enrolled in the Supplemental Nutrition Assistance Program (SNAP), received an average monthly benefit of $177 (based on an average household size of 1.9 people). You collect a sample of individuals (<em>N</em> = 425) in your service area who are receiving SNAP benefits. For your sample, your <em>x̅ </em>= 180, and the standard deviation is 42. In this case, you know the average you hope to represent ($177), although in many instances, you will not know this population information. Let’s calculate a 95% confidence interval.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 11.1. Calculating 95% Confidence Interval</h4> </div> <div class="textbox__content"><div style="text-align: left;"><strong>Formula for 95% Confidence Interval of Population Mean:</strong></div> <div></div> <div style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=XG11ID0gXGJhcnt4fSBccG0gKDEuOTYgXHRpbWVzIHNfe1xiYXJ7eH19KQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu = \bar{x} \pm (1.96 \times s_{\bar{x}})" title="\mu = \bar{x} \pm (1.96 \times s_{\bar{x}})" class="latex mathjax" /></div> <div></div> <div><div><strong>Steps for Calculating 95% Confidence Interval of Population Mean in our example:&nbsp;</strong></div> <ol><li><strong>Calculate the standard error:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fX0gPSBcZnJhY3tzfXtcc3FydHtOfX0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}} = \frac{s}{\sqrt{N}}" title="s_{\bar{x}} = \frac{s}{\sqrt{N}}" class="latex mathjax" />&nbsp; <img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fX0gPSBcZnJhY3s0Mn17XHNxcnR7NDI1fX09Mi4wNC4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}} = \frac{42}{\sqrt{425}}=2.04." title="s_{\bar{x}} = \frac{42}{\sqrt{425}}=2.04." class="latex mathjax" /></li> <li><strong>Multiply the standard error by 1.96:</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=MS45NiBcdGltZXMgMi4wNCA9IDQuMDAu&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="1.96 \times 2.04 = 4.00." title="1.96 \times 2.04 = 4.00." class="latex mathjax" /></li> <li><strong>Take the product (from step 2) and add it to the sample mean </strong><img src="https://mathjax.library.illinois.edu/latex?latex=MTgwICsgNCA9IDE4NC4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="180 + 4 = 184." title="180 + 4 = 184." class="latex mathjax" /></li> <li><strong>Take the product (from step 2) and subtract it from the sample mean </strong><img src="https://mathjax.library.illinois.edu/latex?latex=MTgwIC0gNCA9IDE3Ni4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="180 - 4 = 176." title="180 - 4 = 176." class="latex mathjax" /></li> </ol> </div> </div> </div> </div> <div class="chapter-11:-confidence-intervals"><p class="import-Normal">So, your 95% confidence interval (CI) of 𝜇 is 176 and 184. You may see this notated in texts as 95% CI = [176, 184]. These values give you the lower and upper boundaries of a range where you have 95% confidence that you represented the population mean. In this example, our population mean was 177, so it is within this confidence interval.</p> <h2 class="import-Normal">Calculating 99% Confidence Intervals</h2> <p class="import-Normal">To find the lower and upper values of our confidence intervals, we’ll use Table A.1 to find the exact proportion we are interested in (99%). If you look up <em>z</em> = 2.58 in the <em>z</em>-score table (Table A.1.), you’ll see that the <em>area between the mean and z</em> = 0.495. Because the distribution is symmetrical, we have 0.495 between 2.58 and a mean of 0, and we have 0.495 between −2.58 and a mean of 0. So, together, these areas equal 0.99, which converts to a percentage of 99%. Thus, 99% of cases are located within 2.58 standard deviations of the mean. So, when we are extending the confidence interval bracket above and below the sample mean, we can extend the 2.58 standard deviation in both directions from the sample mean. We can be 95% confident that we included the population in that confidence interval. See Figure 11.3.</p> <div class="wp-caption aligncenter" id="attachment_1219" aria-describedby="caption-attachment-1219" style="width: 700px"><img class="wp-image-1219" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-11.3R-1.png" alt="A standard normal distribution is shown with the area between z = -2.58 and 2.58 shaded in (this area totals 0.99 or 99%)." width="700" height="531" title="" /><div class="wp-caption-text" id="caption-attachment-1219">Figure 11.3. Distribution with 99% confidence intervals (area between <em>z</em> = −2.58 and 2.58 totals 0.99, or 99%).</div></div> <p>&nbsp;</p> <p class="import-Normal">To calculate the 99% confidence interval of your population mean, you will need to calculate the standard error. Note: Because we are calculating the standard error based on the central limit theorem, we will also want to make sure we have a sample size of 200 or more. This will ensure that we are approximating a normal distribution.</p> <div class="textbox shaded"><h3>Formula 11.2: Calculating 99% confidence intervals</h3> <div style="text-align: left;"><strong>Formula for 99% confidence interval of population mean:</strong></div> <div></div> <div style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=XG11ID0gXGJhcnt4fSBccG0gKDIuNTggXHRpbWVzIHNfe1xiYXJ7eH19KQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu = \bar{x} \pm (2.58 \times s_{\bar{x}})" title="\mu = \bar{x} \pm (2.58 \times s_{\bar{x}})" class="latex mathjax" /></div> <div></div> <div></div> <div><strong>Steps for calculating 99% confidence interval of population mean:&nbsp;</strong></div> <ol><li><strong>Calculate the standard error using</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=KHNfe1xiYXJ7eH19ID0gXGZyYWN7c317XHNxcnR7Tn19KS4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(s_{\bar{x}} = \frac{s}{\sqrt{N}})." title="(s_{\bar{x}} = \frac{s}{\sqrt{N}})." class="latex mathjax" /></li> <li><strong>Multiply the standard error by 2.58.</strong> Remember, 2.58 is the z-score that will give you the proportion you are interested in: 99%.</li> <li><strong>Take the product (from step 2) and add it to the sample mean.</strong> This value becomes the upper part of your bracket or confidence interval value above the sample mean.</li> <li><strong>Take the product (from step 2) and subtract it from the sample mean.</strong> This value becomes the lower part of your bracket or confidence interval value below the sample mean.</li> </ol> </div> </div> <div class="chapter-11:-confidence-intervals"><h3 class="import-Normal">Example: 99% Confidence Intervals for Estimating the Monthly Benefit of SNAP</h3> <p class="import-Normal">Let’s try our previous example, but this time let’s calculate a 99% confidence interval. As a reminder, here’s the sample information: <em>N</em> = 425,</p> <div><span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em> = 180, and standard deviation = 42.</span></div> <div><div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 11.2. Calculating 99% Confidence Interval</h4> </div> <div class="textbox__content"><div style="text-align: left;"><strong>Formula for 99% Confidence Interval of Population Mean:</strong></div> <div></div> <div style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=XG11ID0gXGJhcnt4fSBccG0gKDIuNTggXHRpbWVzIHNfe1xiYXJ7eH19KQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu = \bar{x} \pm (2.58 \times s_{\bar{x}})" title="\mu = \bar{x} \pm (2.58 \times s_{\bar{x}})" class="latex mathjax" /></div> <div></div> <div><div><strong>Steps for Calculating 99% Confidence Interval of Population Mean in our example:&nbsp;</strong></div> <ol><li><strong>Calculate the standard error:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fX0gPSBcZnJhY3tzfXtcc3FydHtOfX0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}} = \frac{s}{\sqrt{N}}" title="s_{\bar{x}} = \frac{s}{\sqrt{N}}" class="latex mathjax" /> <img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fX0gPSBcZnJhY3s0Mn17XHNxcnR7NDI1fX09Mi4wNC4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}} = \frac{42}{\sqrt{425}}=2.04." title="s_{\bar{x}} = \frac{42}{\sqrt{425}}=2.04." class="latex mathjax" /></li> <li><strong>Multiply the standard error by 2.58</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=Mi41OCBcdGltZXMgMi4wNCA9IDUuMjYu&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="2.58 \times 2.04 = 5.26." title="2.58 \times 2.04 = 5.26." class="latex mathjax" /></li> <li><strong>Take the product (from step 2) and add it to the sample mean. </strong><img src="https://mathjax.library.illinois.edu/latex?latex=MTgwICsgNS4yNiA9IDE4NS4yNi4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="180 + 5.26 = 185.26." title="180 + 5.26 = 185.26." class="latex mathjax" /></li> <li><strong>Take the product (from step 2) and subtract it from the sample mean. </strong><img src="https://mathjax.library.illinois.edu/latex?latex=MTgwIC0gNS4yNiA9IDE3NC43NC4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="180 - 5.26 = 174.74." title="180 - 5.26 = 174.74." class="latex mathjax" /></li> </ol> </div> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">So, your 95% Confidence Interval (CI) of 𝜇 is 174.74 and 185.26. You may see this notated in texts as 99% CI = [174.74, 185.26]. These values give you the lower and upper boundaries of a range where you have 99% confidence that you represented the population mean. In this example, our population mean was 177, so it is within this confidence interval.</span></p> </div> <p class="import-Normal">Confidence intervals of 99% include a larger area of the normal distribution (between 2.58 standard deviations of the mean), so this widens the range. So, you’re expanding the range, and you are now 99% confident.&nbsp; Confidence intervals of 95% have a narrower range; you are only 95% confident.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">In the world of inferential statistics, we can never be 100% confident in our estimates. However, we can calculate confidence intervals with 95% or 99% confidence that we represented our population parameter. As we continue into Chapter 12, we will continue to see these areas of confidence and the ways in which we use them in inferential statistics.</p> </div> 
	</div>
			
				
				
	</div>
<div class="chapter standard " id="chapter-chapter-12-hypothesis-testing-with-the-z-test" title="Chapter 12: Hypothesis Testing (with the z-test)">
	<div class="chapter-title-wrap">
		<p class="chapter-number">32</p>
		<h1 class="chapter-title">Chapter 12: Hypothesis Testing (with the z-test)</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-12:-hypothesis-testing-(with-the-z-test)"><p class="import-Normal">Chapters 10 and 11 oriented you to the central limit theorem, which provide you with estimates pertaining to the expected sampling error (i.e., standard error) and confidence intervals. This chapter will continue to introduce you to topics within the world of inferential statistics, including <strong><em><span class="glossary-term">hypothesis testing</span></em></strong>, which is a step-by-step process in testing your research hypothesis with an inferential statistics test. A <strong><em><span class="glossary-term">hypothesis</span></em></strong> is an informed assumption or prediction about your research question. Hypothesis testing will introduce new language and phrases that are used throughout the steps.</p> <h2 class="import-Normal">Hypothesis Testing and Probability</h2> <p class="import-Normal">The basis of all inferential statistics tests is grounded in <strong><em><span class="glossary-term">probability</span></em></strong>, which assesses how likely or probable it is that a result you obtain occurred by random chance. For example, there is a .50 or 50% probability that you will flip a coin and end up with heads. You may have probabilities that range from 0 (i.e., zero probability of something happening) to 1.00 or 100% (i.e., absolute probability of something happening). Remember that in inferential statistics, we are using a sample to make inferences or conclusions about the population it comes from. So, we can never be 100% certain that we have a sample that reflects the population (although, as we saw in Chapter 11, we can have 95% and 99% confidence).</p> <p class="import-Normal">As we calculate inferential statistics results, we can quantify the probability of our result being due to chance or due to a meaningful difference from our sample. For example, if you take a sample from a population, you may want to test to see whether that sample is different from the population (i.e., there’s something unique about your sample) or is a representation of that population (i.e., your sample reflects the population from which it came).</p> <h3 class="import-Normal">Example: Assessing Need for Trauma-Informed Therapies Using Hypothesis Testing</h3> <p class="import-Normal">Let’s say you are working with a group of women who are incarcerated and are trying to assess the need for trauma-informed therapies (e.g., Trauma-Focused Cognitive Behavioral Therapy or Eye Movement Desensitization and Reprocessing; Substance Abuse and Mental Health Services Administration [SAMHSA], 2014; Yadav et al., 2024) at the facility where you work. You have a random sample of women (<em>N</em> = 300) complete a questionnaire about their adverse childhood experiences (ACEs; Felitti et al., 1998). You also review their case records to assess their number of prior incarcerations.</p> <p class="import-Normal">You may have a research question that you want to test, which involves comparing your sample to the population (i.e., all women who are incarcerated in the U.S.) mean.</p> <ul><li>Research Question: Does this sample of women have significantly different levels of prior incarcerations compared to all women who are incarcerated?</li> <li>If you find that your sample does have significantly different levels (we will walk through the steps of determining this), then your sample has significantly different levels of prior incarcerations than the whole population.</li> <li>If you find that your sample does not have significantly different levels, then your sample is like the population.</li> </ul> <p class="import-Normal">Our hypotheses are guided by our research questions; sometimes we hypothesize that our sample is different from the population or unique. For example, maybe our sample includes women with higher security levels with more violent histories, so we would hypothesize that our sample would have a different (i.e., higher) average level of prior incarcerations than all women who are incarcerated.</p> <div class="wp-caption aligncenter" id="attachment_252" aria-describedby="caption-attachment-252" style="width: 612px"><img class="wp-image-252 size-full" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/12.jpg" alt="People sitting in circle holding hands." width="612" height="408" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/12.jpg 612w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/12-300x200.jpg 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/12-65x43.jpg 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/12-225x150.jpg 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/12-350x233.jpg 350w" sizes="auto, (max-width: 612px) 100vw, 612px" title="" /><div class="wp-caption-text" id="caption-attachment-252">Figure 12.1. “<a href="https://www.pexels.com/photo/person-in-black-pants-standing-on-gray-carpet-5711369/" target="_blank" rel="noopener" data-url="https://www.pexels.com/photo/person-in-black-pants-standing-on-gray-carpet-5711369/">Person in Black Pants Standing on Gray Carpet</a>” by <a href="https://www.pexels.com/@tima-miroshnichenko/" target="_blank" rel="noopener" data-url="https://www.pexels.com/@tima-miroshnichenko/">Tima Miroshnichenko</a>, via <a href="https://www.pexels.com/" target="_blank" rel="noopener" data-url="https://www.pexels.com/">Pexels</a>, 2020. <a href="https://www.pexels.com/license/" target="_blank" rel="noopener" data-url="https://www.pexels.com/license/">Pexels license</a>.</div></div> <p class="import-Normal">Testing these inferential statistics questions with hypothesis testing will involve probability. We have already seen probability when we looked at the normal distribution. For example, we could ask about the probability of selecting a <em>z</em>-score of 1.5 standard deviations above the mean (see Chapter 7). We would look up the <em>area beyond z</em> in Table A.1 to find the probability of finding a score in this region. For example, with a z-score of 1.5, the proportion of cases beyond <em>z</em> is 0.0668; thus, there is a 6.68% chance of a <em>z</em>-score being higher than 1.5. If we have a <em>z</em>-score of 3, this area is 0.0013, and we have a 0.13% chance of a <em>z</em>-score being higher than 3.</p> <p class="import-Normal">We’ll use probability to guide hypothesis testing as well. If we see a low probability, this means that there is a low probability that this statistic represents the population; in other words, this sample is significantly different from the population.</p> <p class="import-Normal">When describing probability in hypothesis testing, we’ll use the following guidelines:</p> <ul><li>Low probability (i.e., small <em>p </em>value or probability value) that a sample comes from a population: <em>significant difference</em>.</li> <li>High probability (i.e., larger <em>p</em> value) that a sample comes from a population: <em>not a significant difference.</em></li> </ul> <p class="import-Normal">As we continue in this chapter, we’ll define what constitutes a “small <em>p</em> value” and what makes something “significant” or “not significant.”</p> <h2 class="import-Normal">The Logic of the Hypothesis Test</h2> <p class="import-Normal">As an inferential statistical procedure, hypothesis testing includes four steps. As you collect quantitative data from your sample, you will write a hypothesis about the population from which you pulled the sample. So, Steps 1 and 4 will refer to that population about which you are making inferences.</p> <ol><li class="import-Normal"><strong>Hypothesis Pair</strong> <ul><li>Null hypothesis, <em>H</em><sub>o</sub>: Statement of no difference</li> <li>Alternative hypothesis, <em>H</em><sub>a</sub>: Statement of difference</li> </ul> </li> <li><p class="import-Normal"><strong>Setup for the Test</strong></p> <ul><li>What inferential test are you using?</li> <li>Set your confidence/alpha.</li> <li>Find your critical value(s).</li> </ul> </li> <li><p class="import-Normal"><strong>Test Statistic computation</strong></p> <ul><li>Solve for your obtained value.</li> </ul> </li> <li><p class="import-Normal"><strong>Make a decision</strong></p> <ul><li>Reject the null hypothesis.</li> <li>Fail to reject the null hypothesis.</li> </ul> </li> </ol> <h3>Step 1: Hypothesis Pair</h3> <p class="import-Normal">First, you are going to write up your hypothesis pair to articulate what you are testing. You’ll have a <em>null hypothesis</em> and an <em>alternative hypothesis</em>.</p> <ul><li>The <strong><em><span class="glossary-term">null hypothesis</span></em></strong>, notated as <em>H<sub>o</sub></em> is your statement of no difference. This is when you obtain a sample statistic and expect it to be like your population parameter. For example, you’d expect your sample mean to fall between 1.96 standard deviations of your population mean, with 95% confidence.</li> <li>The <strong><em><span class="glossary-term">alternative hypothesis</span></em></strong>, notated as <em>H<sub>a</sub>&nbsp;</em>is your statement of difference. This is often your research hypothesis. For example, if you expect your sample statistic to be different from your population (e.g., statistic falls beyond the confidence interval of the population mean), this would be the statement to hypothesize that difference. You may hypothesize that your sample would have a higher value, a lower value, or be different (i.e., higher or lower) from the population parameter. You will specify this in your hypothesis pair write-up. For this chapter, we will walk through a hypothesis where you want to see if your sample is different from than the population; Chapter 13 will walk you through an example of when you specifically hypothesize higher or lower values.</li> </ul> <p class="import-Normal">This pair of statements is always written together, and the alternative hypothesis always negates the null hypothesis; so, if one hypothesis statement is true, the other is false.</p> <p class="import-Normal">For this step and the rest of our steps, we’ll continue the same example as detailed earlier: According to the 2016 Profile of Prison Inmates (U.S. Department of Justice, 2021), females who were incarcerated at the time of the survey had an average of five prior incarcerations in their lifetime. We sample a group of female participants (<em>N</em> = 300) who are incarcerated in Illinois and calculate their average number of prior incarcerations. We want to know if there is a significant difference between our sample mean and the federal population mean.</p> <p class="import-Normal">In this chapter, we will compare one sample mean to a population mean and standard deviation (often provided to you through an assessment manual that provides information about a normed sample, or a large, representative group that was used to develop the norms for the population). We will be testing this comparison with the <strong><em>z</em>-test</strong>. The <em>z</em>-test allows you to compare one sample mean (<em><span style="font-size: NaNpt; color: #; text-decoration: none;">x̅</span></em>) to a population mean (𝜇).</p> <p class="import-Normal">For this example, our research question is as follows: Do females incarcerated in Illinois have different levels of prior incarcerations compared with the national average?</p> <p class="import-Normal" style="text-indent: 36pt;">Federal population: 𝜇 = 5, <span style="font-size: NaNpt; color: #; text-decoration: none;">σ </span>= 1.6.</p> <p class="import-Normal" style="text-indent: 36pt;">Your sample: <em><span style="font-size: NaNpt; color: #; text-decoration: none;">x̅ </span></em>= 4.8, <em>s</em> = 1.9, <em>N</em> = 300.</p> <p class="import-Normal">First, we’ll write our hypothesis pair for step 1 of our hypothesis test:</p> <ul><li>Null hypothesis: <em>μ</em><sub>1 </sub><span style="font-size: 14pt;">= 5.</span></li> <li>Alternative hypothesis: <em>μ</em><sub>1 </sub>≠ 5.</li> </ul> <p class="import-Normal">This can also be notated like this:</p> <ul><li><div><span style="font-size: NaNpt; color: #; text-decoration: none;"><span style="font-size: NaNpt; color: #; text-decoration: none;"><em>H<sub>o</sub></em>: </span></span><em>μ</em><sub>1 </sub><span style="font-size: 14pt;">= 5.</span></div> </li> <li><div><span style="font-size: NaNpt; color: #; text-decoration: none;"><span style="font-size: NaNpt; color: #; text-decoration: none;"><em>H<sub>a</sub></em>: <em>μ</em><sub>1</sub></span></span> ≠ 5.</div> </li> </ul> <p class="import-Normal">We are referring to our population mean in these statements. Table 12.1 shows a break down of all the elements.</p> <table style="width: 750px; height: 318px;"><caption>Table 12.1. Elements of the Hypothesis Pair Statements</caption> <thead><tr style="height: 15.8pt;"><th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 75.0938px; height: 35px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Element</strong></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 641.719px; height: 35px;" scope="col"><p class="import-Normal"><strong>Description of the Hypothesis Pair Statement Elements</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 14.9pt;"><th style="border: 0.5pt solid windowtext; width: 75.0938px; height: 35px; vertical-align: middle;" scope="row"><p class="import-Normal" style="text-align: center;"><em><span style="font-size: NaNpt; color: #; text-decoration: none;">H<sub>o</sub></span></em></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 641.719px; height: 35px;"><p class="import-Normal">Notation for null hypothesis</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.8pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 75.0938px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;"><em><span style="font-size: NaNpt; color: #; text-decoration: none;">H<sub>a</sub></span></em></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 641.719px; height: 35px;"><p class="import-Normal">Notation for alternative hypothesis</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.9pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 75.0938px; height: 107px;" scope="row"><p class="import-Normal" style="text-align: center;"><span style="font-size: NaNpt; color: #; text-decoration: none;"><em>μ</em><sub>1</sub></span></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 641.719px; height: 107px;"><p class="import-Normal">Mu (population mean): because we are testing an inferential test, we are making hypotheses and inferences about a population. There is a subscript “1”–this is because we are taking one sample and comparing its mean to the population mean.</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.8pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 75.0938px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;">= or ≠</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 641.719px; height: 35px;"><p class="import-Normal">We will be testing to see if there is a difference (≠) or no difference (=).</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.8pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 75.0938px; height: 53px;" scope="row"><p class="import-Normal" style="text-align: center;">5</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 641.719px; height: 53px;"><p class="import-Normal">In our example, our population mean is 5. So, we are including this in our hypothesis pair statement to see if we can infer that our sample is or is not significantly different from 5.</p> </td> </tr> </tbody> </table> <p class="import-Normal">As you’ll see in Chapter 13, you can also have a directional alternative hypothesis. This means that you hypothesize that your sample will have either higher levels than the population (&gt;) or lower levels than the population (&lt;). So, your alternative hypothesis would use “&gt;” or “&lt;” instead of “≠” in the statement. However, for the rest of this chapter, we will focus on differences and use “≠” in our alternative hypothesis statement.</p> <h3 class="import-Normal">Step 2: Set-up for the Test</h3> <p class="import-Normal">This step is all about setting up information for testing your hypotheses. There are three elements to this step: (1) determining what inferential test you will use, (2) setting your confidence and alpha levels, and (3) finding your critical value or values.</p> <p class="import-Normal">First, you will determine your inferential test. In Chapters 12 and 13, we will be using the <em>z</em>-test. Again, the <em>z</em>-test allows you to compare one sample mean (<em><span style="font-size: NaNpt; color: #; text-decoration: none;">x̅</span></em>) to a population mean (𝜇). As you’ll see in later chapters, you will be looking at hypothesis tests for other types of inferential tests. We will note the implications those inferential test selections will have on the rest of the hypothesis test in those specific chapters.</p> <p class="import-Normal">Second, you will set your confidence and alpha levels. This is also called setting your <em>significance level</em>. These numbers provide you with the threshold for making decisions about your hypotheses.</p> <ul><li><strong><em><span class="glossary-term">Confidence</span>: </em></strong>This is the total area of the distribution that is <em>not</em> in the tail or tails of a distribution. Commonly, you’ll see people set their confidence level at 95%, but you can also set it to 99% or another confidence level. For the rest of this book, we will examine hypothesis testing with 95% confidence.</li> <li><strong><em><span class="glossary-term">Alpha (α)</span></em></strong>: This is the total area of the distribution that is in the tail or tails of a distribution. Because the alpha and confidence areas add up to 1.00, or 100%, your alpha area would be set at 0.05, or 5% if your confidence is set to 0.95, or 95%.</li> </ul> <p class="import-Normal">In this chapter, we will be testing whether our sample is “different” from a population (i.e., could be lower or higher), so we will be testing both tails (i.e., tail on each side of the distribution). Because we are testing both tails, we are going to split our alpha area of 0.05, or 5% into the left side (0.025, or 2.5%) and right side (0.025, or 2.5%). Then, our confidence is everything in between, totaling .95, or 95%. Confidence can be defined as 1 – α, so in this example, 1 – .05 = 0.95.</p> <p class="import-Normal">Third, you find your critical value or values. Because we will be testing two tails (remember, we split the alpha), you will have two critical values. Critical values are the values that divide your alpha and confidence areas. Because we are calculating a <em>z</em>-test, we can use our <em>z</em>-score table (Table A.1) to find our critical values.</p> <p class="import-Normal">Earlier, we set our confidence level to 95%. So, that leaves 5% total alpha. The <em>z</em>-scores that gives us 95% confidence are 1.96 and -1.96. If we look up the <em>area beyond z</em> for these <em>z</em>-scores, it is 0.025. We have two tails, so 0.025 × 2 = 0.05. This totals our .05, or 5% alpha area. So, that means our critical values are 1.96 and −1.96. These are notated in Figure 12.2 as “<em>z</em><sub>c</sub>” for <span class="TextRun SCXW233799717 BCX0" xml:lang="EN-US" data-contrast="auto"><span class="NormalTextRun SCXW233799717 BCX0">“</span></span><em>z</em>-critical.”</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-252" style="width: 700px"><img class="wp-image-1221" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-12.2R-1.png" alt="Set-up for a z-test is shown on a standard normal distribution." width="700" height="396" title="" /><div class="wp-caption-text">Figure 12.2. Set-up for a <em>z</em>-test; your <em>z</em>-critical values (−1.96 and 1.96) separate your alpha (tail regions) from your confidence area (under the high point of the curve). Together, your alpha and confidence areas total 1.00, or 100%.</div></div> <p>&nbsp;</p> <p class="import-Normal">As shown in the figure, your confidence area is set to 95% and includes the <em>area between z</em> = −1.96 and 1.96. The alpha area is split between your two tails and is the area beyond the z-scores of −1.96 and 1.96. Your total alpha area is 5%, and it is split between two tails, so 2.5% in each tail. You will use this image to guide the rest of your hypothesis test. Note: If we wanted to set our confidence to 99%, <em>z</em>-scores of −2.58 and 2.58 would be our critical values.</p> <p class="import-Normal">To summarize Step 2, we do the following:</p> <ul><li>Determine what inferential test you are using: We will use the <strong><em>z</em>-test</strong> because we want to compare one sample mean (<em>x̅</em>) to a population mean (𝜇).</li> <li>Set your confidence/alpha: <strong>Confidence = .95 (95%), and alpha = .05 (5% total split between two tails).</strong></li> <li>Find your critical value(s): <strong><em>z</em><sub>c</sub> = ±1.96.</strong></li> </ul> <h3 class="import-Normal">Step 3: Test Statistic Computation</h3> <p class="import-Normal">In this step, you will compute your test statistic, or your “obtained value,” using the inferential test you selected in Step 2. As a reminder, your federal population mean is 𝜇 = 5, and the standard deviation is 𝜎 = 1.6. Your sample mean (<em>N</em> = 300) is <em><span style="font-size: NaNpt; color: #; text-decoration: none;">x̅ </span></em>= 4.8. We will be using the <em>z</em>-test to compare our sample mean of 4.8 to the population mean of 5 and see if they are significantly different.</p> <p class="import-Normal">Because we are using a sample to make inferences, we will first calculate the standard error (i.e., expected sampling error). Then, we can use this standard error and solve for the <em>z</em>-obtained value.</p> <div class="textbox shaded"><h4>Formula 12.1. Calculating standard error and z-obtained</h4> <p><strong>Formula for standard error:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fSA9IFxmcmFje1xzaWdtYX17XHNxcnR7Tn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" title="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" class="latex mathjax" /></p> <p><strong>Formula for <em>z</em>-obtained value (for the <em>z</em>-test):&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyhcYmFye3h9IC0gXG11KX17XHNpZ21hX3tcYmFye3h9fX0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(\bar{x} - \mu)}{\sigma_{\bar{x}}}" title="z = \frac{(\bar{x} - \mu)}{\sigma_{\bar{x}}}" class="latex mathjax" /></p> </div> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 12.1. Finding Standard Error and <em>z</em>-obtained Values</h4> </div> <div class="textbox__content"><p><strong>Formula for standard error:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fSA9IFxmcmFje1xzaWdtYX17XHNxcnR7Tn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" title="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" class="latex mathjax" /></p> <p><strong>Formula for z-obtained value (for the <em>z</em>-test):&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyhcYmFye3h9IC0gXG11KX17XHNpZ21hX3tcYmFye3h9fX0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(\bar{x} - \mu)}{\sigma_{\bar{x}}}" title="z = \frac{(\bar{x} - \mu)}{\sigma_{\bar{x}}}" class="latex mathjax" /></p> <p><strong>Our example s</strong><strong>tandard error:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fSA9IFxmcmFjezEuNn17XHNxcnR7MzAwfX09MC4wOQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}} = \frac{1.6}{\sqrt{300}}=0.09" title="\sigma_{\bar{x}} = \frac{1.6}{\sqrt{300}}=0.09" class="latex mathjax" /></p> <p><strong>Our example z-obtained value (for the <em>z</em>-test):&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyg0LjggLSA1KX17MC4wOX0gPSAtMi4yMg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(4.8 - 5)}{0.09} = -2.22" title="z = \frac{(4.8 - 5)}{0.09} = -2.22" class="latex mathjax" /></p> </div> </div> <div class="chapter-12:-hypothesis-testing-(with-the-z-test)"><p class="import-Normal">For our example, our <em>z</em>-obtained value is −2.22.</p> <h3 class="import-Normal">Step 4: Make a Decision</h3> <p class="import-Normal">Finally, in Step 4, you’ll make an inference based on your previous steps. The language used in Step 4 includes selecting one of two phrases:</p> <p class="import-Normal">“Reject the null hypothesis” or “Fail to reject the null hypothesis.”</p> <p class="import-Normal">If you remember back to Step 1, the null hypothesis is the statement of no difference; the sample mean and population mean are not significantly different. So, our statement selection is based on the logic of falsification. We will use our distribution visual to help us with our decision. We will see where our obtained value (found in Step 3) falls in relation to your confidence and alpha areas.</p> <ul><li><strong>If the obtained value falls in the confidence area</strong>: You would “fail to reject the null hypothesis” because your obtained value from your sample falls in the area in which you are 95% confident that the population mean is represented. This would mean that there is <em>not</em> a significant difference between your sample mean and the population mean. You would infer that there not is a significant difference.</li> <li><strong>If the obtained value falls in the alpha area</strong>: You would “reject the null hypothesis,” because your obtained value from your sample falls beyond the area (as defined by your critical values) in which you are 95% confident that the population mean is represented. This would mean that there <em>is</em> a significant difference between your sample mean and the population mean. You would infer that there <em>is</em> a significant difference.</li> </ul> <p class="import-Normal">Let’s look at our example. Our <em>z</em>-obtained value is −2.22. If we plot this on our distribution (which has our confidence and alpha areas labeled from Step 2), as shown in Figure 12.3, we see that our obtained value falls in the alpha area on the negative side of our distribution. So, we would <strong>reject the null hypothesis</strong>. In other words, our sample has significantly different levels of prior incarcerations than the federal average.</p> <div class="wp-caption aligncenter" id="attachment_1222" aria-describedby="caption-attachment-1222" style="width: 700px"><img class="wp-image-1222" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-12.3R-1.png" alt="Standard normal distribution, with alphas shaded (areas beyond -1.96 and 1.96). The z-obtained falls on the negative side of the distribution in the shaded alpha area." width="700" height="396" title="" /><div class="wp-caption-text" id="caption-attachment-1222">Figure 12.3. Plotting our <em>z</em>-obtained value on our distribution (which we set up in step 2 of the hypothesis test).</div></div> <h3 class="import-Normal">Making an Inference Based on the Hypothesis Test: APA-Style Write-up</h3> <p class="import-Normal">After you go through the four steps, you will make an inference about your findings. Typically, reports suggest including components outlined by the American Psychological Association (APA, 2020). You’ll want to introduce the type of test you conducted, report key values (e.g., means and obtained value), and indicate whether you found a significant difference or not. For our example, we could write the following in a report:</p> <p class="import-Normal" style="padding-left: 40px;">A one-sample <em>z</em>-test was calculated to compare the average number of prior incarcerations from a sample of women who are currently incarcerated in Illinois to the mean found with a large, federal survey. Based on a sample size of 300, women in Illinois who were incarcerated had a significantly different average of prior incarcerations (mean [<em>M</em>] = 4.8, standard deviation [<em>SD</em>] = 1.9) than the national average (<em>M</em> = 5), <em>z</em> = −2.22, <em>p</em> &lt; .05.</p> <p class="import-Normal">This type of result may lead you to test other hypotheses to try to understand why this sample is significantly different from the national average. Some of the key components of the APA-style write-up include the following:</p> <ul><li>Use of “<em>M</em>” for means; rather than using symbol notation for population and sample means, APA style typically uses “<em>M</em>” when writing up the results for means. You can also include your sample standard deviation (termed “<em>SD</em>” in these write-ups). This standard deviation for the sample is not used in any of the calculations; it is just listed here in case readers are interested in sample-specific descriptive statistics. Although the population standard deviation is used in analyses, they are typically not presented in the APA-style write-up.</li> <li>The notation of “<em>z</em> = −2.22”: This is your obtained value from Step 3 of the hypothesis test.</li> <li>“Significantly different” means you rejected the null hypothesis in Step 4 of the hypothesis test.</li> <li>The notation of “<em>p</em> &lt; .05”: This also indicates to readers that you rejected the null hypothesis. This means that there is a less than (&lt;) 5% probability (<em>p</em>) that this sample represents the population; there is something significantly different about this sample of women. Again, if you have a small probability (defined here as less than 5%, which was set in Step 2 of the hypothesis test), then there is a small probability that your sample represents the population; there is something different about your sample. Because you set these confidence and alpha areas in Step 2, the difference is large enough that it is unlikely to be due to chance.</li> </ul> <h2 class="import-Normal">Probability values (<em>p </em>Values)</h2> <p class="import-Normal">Probability values, or <strong><em><span class="glossary-term">p values</span></em></strong>, are computed alphas.</p> <ul><li>When the <em>p </em>value is less than your set alpha (e.g., 0.05), you reject the null hypothesis.</li> <li>When the <em>p </em>value is greater than your set alpha (e.g., 0.05), you fail to reject the null hypothesis.</li> </ul> <p class="import-Normal">You can use “<em>p</em> &lt; .05” to indicate your set threshold and where your obtained value fell (in the alpha area), or you can find the exact <em>p</em> value or probability. Look up your <em>z</em>-obtained value in the <em>z</em>-table (Table A.1), and look up the <em>area beyond z</em>. Then, because you tested both tails, you will take that area and multiply it by 2. This will give you your exact <em>p</em> value or probability.</p> <p class="import-Normal">In our example, our <em>z</em> = −2.22. Our area beyond <em>z</em> = 0.0132. We tested for a difference in either tail area, so we will multiply our probability by 2. So, 0.0132 × 2 = 0.0264. This means there is a 2.64% probability that your sample came from your population. Because this is less than 5% (your set significance level from Step 2), you would say this is a significant difference. Therefore, your <em>p</em> value statement about significance can be written as follows: “<em>p</em> &lt; .05” or “<em>p</em> = .0264.” Both statements indicate a significant difference. Here’s the APA-style write-up again with the exact <em>p </em>value:</p> <p class="import-Normal" style="padding-left: 40px;">A one-sample <em>z</em>-test was calculated to compare the average number of prior incarcerations from a sample of women who are currently incarcerated in Illinois to the mean found with a large, federal survey. Based on a sample size of 300, women in Illinois who were incarcerated had a significantly different average of prior incarcerations (<em>M</em> = 4.8, <em>SD</em> = 1.9) than the national average (<em>M</em> = 5), <em>z</em> = −2.22, <em>p</em> = .0264.</p> <p class="import-Normal">If you think back to earlier in this chapter, we saw that together, the alpha and confidence areas total 1.00, or 100%. So, if we know our exact <em>p</em> value (alpha area), then we can take 1 – (alpha area) to find our maximum confidence. In our example, alpha = 0.0264, so confidence = 1 – 0.0264 = 0.9736, or 97.36%. This value of 97.36% also exceeds our significance level from Step 2, which said we needed at least 95% confidence. So, our maximum confidence also tells us that we have a significant difference.</p> <p class="import-Normal">Let’s try another hypothesis testing example using a <em>z</em>-test:</p> <h3 class="import-Normal">Example: Suicide Risk in a Co-Response Team Using Hypothesis Testing</h3> <p class="import-Normal">As part of a co-response team, a social worker and a police officer respond to mental health-related dispatch calls. For more information on co-response models and other types of crisis intervention teams, see Eaton et al. (2025) and Watson et al. (2017). The social worker uses a standardized suicide risk assessment; if scores are near 50, then this indicates a low risk for suicide, scores between 60 and 70 indicate increasing risk of suicidal thoughts or behaviors, and scores 70 and above indicate a high risk of suicidal behaviors. The social worker wants to do hypothesis testing to see whether their sample of subjects from the past quarter had different levels of suicidal risk compared with the norm sample. The social worker calculates their sample mean and compares it to the norm sample mean and standard deviation. They will be using a <em>z</em>-test in a hypothesis testing framework.</p> <p class="import-Normal"><strong><em>Research question: </em></strong>Does this sample of subjects have different levels of suicide risk compared with the norm average?</p> <p class="import-Normal" style="text-indent: 36pt;">Population mean and standard deviation: 𝜇 = 56, <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>σ</em> = 3.7.</span></p> <p class="import-Normal" style="text-indent: 36pt;">Your sample: <em><span style="font-size: NaNpt; color: #; text-decoration: none;">x̅ </span></em>= 56.8, <em>s</em> = 3.4, <em>N</em> = 65.</p> <h4 class="import-Normal">Step 1: Hypothesis Pair</h4> <ul><li>Null hypothesis: <em>μ</em><sub>1</sub>= 56.</li> <li>Alternative hypothesis: <em>μ</em><sub>1</sub> <span style="font-size: 14pt;">≠ 56.</span></li> </ul> <p class="import-Normal">This can also be notated as follows:</p> <ul><li><div><span style="font-size: NaNpt; color: #; text-decoration: none;"><span style="font-size: NaNpt; color: #; text-decoration: none;"><em>H<sub>o</sub></em>: </span></span><em>μ</em><sub>1</sub>= 56.</div> </li> <li><div><span style="font-size: NaNpt; color: #; text-decoration: none;"><span style="font-size: NaNpt; color: #; text-decoration: none;"><em>H<sub>a</sub></em>: </span></span><em>μ</em><sub>1</sub> <span style="font-size: 14pt;">≠ 56.</span></div> </li> </ul> <h4 class="import-Normal">Step 2: Set-up for the Test</h4> <ul><li>What inferential test are you using? We will use the <em><strong>z</strong></em><strong>-test</strong> (because we want to compare one sample mean (<em>x̅</em>) to a population mean (<em>μ</em>).</li> <li>Set your confidence/alpha: <strong>Confidence = .95, and alpha = .05.</strong></li> <li>Find your critical value(s): <strong><em>z</em><sub>c</sub> = ±1.96.</strong></li> </ul> <h4 class="import-Normal">Step 3: Test Statistic Computation</h4> <p class="import-Normal">First, solve for the standard error, using the population standard deviation (3.7) divided by the square root of your sample size (65). Then, use that value to find your <em>z</em>-obtained value.</p> <p class="import-Normal" style="text-indent: 36pt;">Population mean and standard deviation: 𝜇 = 56, <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>σ </em>= 3.7.</span></p> <p class="import-Normal" style="text-indent: 36pt;">Your sample: <em><span style="font-size: NaNpt; color: #; text-decoration: none;">x̅ </span></em>= 56.8, <em>s</em> = 3.4, <em>N</em> = 65.</p> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 12.2. Finding the Standard Error and z-Obtained Values</h5> </div> <div class="textbox__content"><p><strong>Formula for standard error:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fSA9IFxmcmFje1xzaWdtYX17XHNxcnR7Tn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" title="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" class="latex mathjax" /></p> <p><strong>Formula for <em>z</em>-obtained value (for the <em>z</em>-test):&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyhcYmFye3h9IC0gXG11KX17XHNpZ21hX3tcYmFye3h9fX0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(\bar{x} - \mu)}{\sigma_{\bar{x}}}" title="z = \frac{(\bar{x} - \mu)}{\sigma_{\bar{x}}}" class="latex mathjax" /></p> <p><strong>Our example standard error:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fSA9IFxmcmFjezMuN317XHNxcnR7NjV9fT0wLjQ2&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}} = \frac{3.7}{\sqrt{65}}=0.46" title="\sigma_{\bar{x}} = \frac{3.7}{\sqrt{65}}=0.46" class="latex mathjax" /></p> <p><strong>Our example <em>z</em>-obtained value (for the <em>z</em>-test):&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyg1Ni44LTU2KX17MC40Nn0gPSAxLjc0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(56.8-56)}{0.46} = 1.74" title="z = \frac{(56.8-56)}{0.46} = 1.74" class="latex mathjax" /></p> </div> </div> <div class="chapter-12:-hypothesis-testing-(with-the-z-test)"><p class="import-Normal">For our example, the <em>z</em>-obtained value is 1.74.</p> <h4 class="import-Normal">Step 4: Make a Decision</h4> <p class="import-Normal">If we plot where our <em>z</em>-obtained value (<em>z</em> = 1.74) falls in relation to the confidence and alpha areas (as defined in Step 2), we see that our obtained value falls in the confidence area of the distribution (see Figure 12.4).</p> <div class="wp-caption aligncenter" id="attachment_1223" aria-describedby="caption-attachment-1223" style="width: 700px"><img class="wp-image-1223" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-12.4R-1.png" alt="Standard normal distribution, with alphas shaded (areas beyond -1.96 and 1.96). The z-obtained falls on the positive side of the distribution in the confidence area." width="700" height="396" title="" /><div class="wp-caption-text" id="caption-attachment-1223">Figure 12.4. Plotting our <em>z</em>-obtained value on our distribution (which we set-up in Step 2 of the hypothesis test).</div></div> <p class="import-Normal">This means that we will <strong>fail to reject the null hypothesis</strong>, which means that our sample is <em>not</em> significantly different from the norm sample mean. This sample of subjects has an average score that falls in the confidence area of the distribution, meaning that it falls in the area we would expect a sample pulled from the population to fall. So, we <em>fail</em> to be able to reject our null hypothesis (which states that our sample is no different from our population mean).</p> <p class="import-Normal">Let’s go ahead and find our exact <em>p</em> value and maximum confidence level, before writing up the results for our report. To find exact <em>p </em>value, we will look up our <em>z</em>-obtained value in Table A.1. The <em>area beyond z</em> = 0.0409. We tested both tails, so our total alpha area = .0409 × 2 = 0.0818. This is not less than (&lt;) .05 (our set significance level), so we do <em>not</em> have a significant difference. For our maximum confidence, we will take 1 – alpha, so 1 – 0.0818, which equals 0.9182, or 91.82%. This is not greater than 95%, so again, we do not have a significant difference.</p> <div class="wp-caption aligncenter" id="attachment_402" aria-describedby="caption-attachment-402" style="width: 612px"><img class="wp-image-402 size-full" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/12.4-1.jpg" alt="A police officer talks to a person who is standing next to them." width="612" height="408" title="" /><div class="wp-caption-text" id="caption-attachment-402">Figure 12.5. “<a href="https://www.pexels.com/photo/man-and-policewoman-talking-in-the-street-7714790/" target="_blank" rel="noopener" data-url="https://www.pexels.com/photo/man-and-policewoman-talking-in-the-street-7714790/">Man and Policewoman Talking in the Street</a>”&nbsp;by <a href="https://www.pexels.com/@kindelmedia/" target="_blank" rel="noopener" data-url="https://www.pexels.com/@kindelmedia/">Kindel Media</a>, via <a href="https://www.pexels.com/" target="_blank" rel="noopener" data-url="https://www.pexels.com/">Pexels</a>, 2021. <a href="https://www.pexels.com/license/" target="_blank" rel="noopener" data-url="https://www.pexels.com/license/">Pexels license</a>.</div></div> <h4 class="import-Normal">APA Write-up</h4> <p>Our APA-style write-up would be as follows:</p> <p class="import-Normal" style="padding-left: 40px;">A one-sample <em>z</em>-test was calculated to compare the average suicidal risk assessment scores from a sample of dispatch call subjects with the norm average. Based on mental health-related calls from the previous quarter (<em>N</em> = 65), this sample did not have significantly different levels of suicidal risk (<em>M</em> = 56.8, <em>SD</em> = 3.4) than the norm average (<em>M</em> = 56), <em>z</em> = 1.74, <em>p</em> &gt; .05.</p> <p class="import-Normal">The second sentence could also state the exact <em>p</em> value rather than “<em>p</em> &gt; 0.05”:</p> <p class="import-Normal" style="padding-left: 40px;">Based on mental health-related calls from the previous quarter (<em>N</em> = 65), this sample did not have significantly different levels of suicidal risk (<em>M</em> = 56.8, <em>SD</em> = 3.4) than the norm average (<em>M</em> = 56), <em>z</em> = 1.74, <em>p</em> = .0818.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">This chapter outlined the four steps of the hypothesis test framework while also introducing the language used throughout the steps. We reviewed the <em>z</em>-test using hypothesis testing and found a significant difference (<span class="TextRun SCXW67479708 BCX0" xml:lang="EN-US" data-contrast="auto"><span class="NormalTextRun SCXW67479708 BCX0">“</span></span>rejected the null hypothesis<span class="TextRun SCXW258811468 BCX0" xml:lang="EN-US" data-contrast="auto"><span class="NormalTextRun SCXW258811468 BCX0">”</span></span>) in the first example, but we didn’t find a significant difference (<span class="TextRun SCXW67479708 BCX0" xml:lang="EN-US" data-contrast="auto"><span class="NormalTextRun SCXW67479708 BCX0">“</span></span>failed to reject the null hypothesis<span class="TextRun SCXW258811468 BCX0" xml:lang="EN-US" data-contrast="auto"><span class="NormalTextRun SCXW258811468 BCX0">”</span></span>) in the second example. We reviewed the differences between these two outcomes in terms of language and <em>p</em> values. We concluded this chapter with APA-style statements about how to write about these findings in a report, including how to find and report <em>p</em> values and maximum confidence level.</p> </div> 
	</div>
			
				
				
	</div>
<div class="chapter standard " id="chapter-chapter-13-additional-hypothesis-testing-considerations" title="Chapter 13: Additional Hypothesis Testing Considerations">
	<div class="chapter-title-wrap">
		<p class="chapter-number">33</p>
		<h1 class="chapter-title">Chapter 13: Additional Hypothesis Testing Considerations</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-13:-additional-hypothesis-testing-considerations"><p class="import-Normal">In the previous chapter, we learned about the hypothesis testing framework, which includes the four steps for testing a research question using the <em>z</em>-test. This chapter continues to discuss hypothesis testing with the <em>z</em>-test, highlighting directional hypotheses, as well as errors and limitations that can occur when using an inferential test within the hypothesis testing framework.</p> <h2 class="import-Normal">Directional Hypothesis</h2> <p class="import-Normal">In Chapter 12, we tested research questions where we split our alpha areas into two tails; in other words, we tested whether there was a difference, but we weren’t sure if our sample mean would be higher (positive <em>z</em>-score) or lower (negative <em>z</em>-score) than the population mean. By using a two-tailed test, this gives us two areas (2.5% in each tail) where we could potentially see a significant difference (see Figure 13.1).</p> <div class="wp-caption aligncenter" id="attachment_259" aria-describedby="caption-attachment-259" style="width: 700px"><img class="wp-image-1221" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-12.2R-1.png" alt="A standard normal distribution with the alpha area split between the two tails (2.5% on each side). z-critical values separate the alpha and confidence areas (at -1.96 and 1.96)." width="700" height="396" title="" /><div class="wp-caption-text" id="caption-attachment-259">Figure 13.1. Two-tailed test set-up.</div></div> <p class="import-Normal">A <strong><em><span class="glossary-term">directional hypothesis</span></em></strong> test can also be written, which is also referred to as a <em>one-tailed test</em>. When you have a strong reason to believe that your sample mean will fall higher or lower in relation to your population mean, you can indicate this throughout your hypothesis test. This means you have just one alpha area, or one tail that you are testing.</p> <p class="import-Normal">As shown in Figure 13.2, you may hypothesize that your sample mean is higher than the population mean, in which case you would have just the alpha area on the positive side of the distribution (and as shown later, your <em>z</em>-critical would be 1.65). Or you may hypothesize that your sample mean is lower than the population mean, in which case you would have just the alpha area on the negative side of the distribution (<em>z</em>-critical = −1.65), as shown in Figure 13.3. In both figures, your alpha area is only on one side, so the total 5% is in that area (rather than split, as in a two-tailed test).</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-259" style="width: 700px"><img class="wp-image-259" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-13.2R-1024x616.png" alt="A standard normal distribution, with all 5% of alpha area shaded on right side of distribution. The z-critical is 1.65 separating alpha and confidence." width="700" height="421" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-13.2R-1024x616.png 1024w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-13.2R-300x180.png 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-13.2R-768x462.png 768w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-13.2R-65x39.png 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-13.2R-225x135.png 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-13.2R-350x211.png 350w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-13.2R.png 1503w" sizes="auto, (max-width: 700px) 100vw, 700px" title="" /><div class="wp-caption-text">Figure 13.2. One-tailed test (positive).</div></div> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-259" style="width: 700px"><img class="wp-image-1226" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-13.3R-1.png" alt="A standard normal distribution, with all 5% of alpha area shaded on left side of distribution. The z-critical is -1.65 separating alpha and confidence." width="700" height="419" title="" /><div class="wp-caption-text">Figure 13.3. One-tailed test (negative).</div></div> <p class="import-Normal">Next, we will see how directional hypotheses affect the hypothesis testing steps.</p> <p class="import-Normal">First, in Step 1, you will indicate a directional hypothesis with your alternative hypothesis statement. Rather than using “≠”, you will use “&lt;” or “&gt;,” depending on your hypothesis.</p> <ul><li>Null hypothesis: <em>μ</em><sub>1 </sub><span style="font-size: 14pt;">=____</span>(value of your population mean)</li> <li>Alternative hypothesis: <em>μ</em><sub>1 </sub>&gt;_____ (value of your population mean)</li> </ul> <p><em>or</em></p> <ul><li>Alternative hypothesis: <em>μ</em><sub>1 </sub>&lt;_____ (value of your population mean)</li> </ul> <h3>Example: Prior Incarcerations with a Directional Hypothesis</h3> <p class="import-Normal">Let’s use our example from Chapter 12, where your research question was as follows: Do females incarcerated in Illinois have different levels of prior incarcerations compared with the national average? Recall that the federal population mean is 𝜇 = 5 and the standard deviation is 𝜎 = 1.9. You’ve tested a sample from Illinois for several years in a row, and you continually see that your sample has significantly lower levels than the national average. Thus, if you have strong reason to believe that this year you will again have a sample with lower levels than the national average, you could use a directional hypothesis test.</p> <h4 class="import-Normal">Step 1: Hypothesis Pair</h4> <p class="import-Normal">For your hypothesis pair you would write the following:</p> <ul><li>Null hypothesis: <em>μ</em><sub>1 </sub>= 5.</li> <li>Alternative hypothesis: <em>μ</em><sub>1 </sub>&lt; 5.</li> </ul> <p class="import-Normal">Again, the difference for a one-tailed test, or a directional hypothesis, is seen in your alternative hypothesis statement: “&lt;” indicates that you hypothesize that scores will be lower than the population mean of 5.</p> <h4 class="import-Normal">Step 2: Set-up for the Test</h4> <ul><li>What inferential test are you using? We will use the <em><strong>z</strong></em><strong>-test</strong> because we want to compare one sample mean (<em>x̅</em>) to a population mean (𝜇).</li> <li>Set your confidence/alpha: <strong>Confidence = .95, and alpha = .05.</strong></li> <li>Find your critical value(s):<strong><em>z</em><sub>c</sub> = −1.65.</strong></li> </ul> <p class="import-Normal">Most of this set-up is the same; however, you are testing only one tail. So, your alpha area (0.05) is <em>all</em> on one side of your distribution (see Figure 13.4). So, we need a single critical value to separate our alpha and confidence areas on the side we are testing. In this example, we’ll need a negative critical value to separate our areas. We need to find a <em>z</em>-score that gives us the <em>area beyond z</em> for 0.05. In Table A.1, we see that <em>z</em> = 1.65 gives us that area. So, we will use that <em>z</em>-score, but on the negative side (<em>z</em> = −1.65), to separate our alpha and confidence areas.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-259" style="width: 700px"><img class="wp-image-1226" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-13.3R-1.png" alt="A standard normal distribution, with all 5% of alpha area shaded on left side of distribution. The z-critical is -1.65 separating alpha and confidence." width="700" height="419" title="" /><div class="wp-caption-text">Figure 13.4. One-tailed test set-up (hypothesizing that your sample mean is lower than the population mean).</div></div> <p class="import-Normal">Please note that if you were testing a directional hypothesis where you were hypothesizing that your sample would have <em>higher</em> levels than the norm average, you would use <em>z</em> = 1.65 and mark the alpha area on the positive side of the distribution.</p> <p class="import-Normal">Because your alpha is all on one side of the distribution, that means the alpha area is larger (0.05 on one side versus split into 0.025 on each side). So, the likelihood of rejecting the null hypothesis (i.e., finding a significant difference) increases. However, it is cautioned that if you are not sure where your sample mean will fall, you should conduct a two-tailed test. In our example, what if the sample was taken during 2020–2021, the years of the COVID-19 pandemic? Do you think our sample would have different (or higher) averages, even if they had lower averages for the 5 years prior to this? In these cases where we aren’t sure, and a result may be in the opposite direction of what we’d expect, testing both tails is recommended.</p> <h4 class="import-Normal">Step 3: Test Statistic Computation</h4> <p class="import-Normal">Your <em>z</em>-obtained calculation remains the same for a directional hypothesis. Let’s look at another year of data: Your sample: <em><span style="font-size: NaNpt; color: #; text-decoration: none;">x̅ </span></em>= 4.7, <em>s</em> = 1.7, <em>N</em> = 264; our population data: 𝜇 = 5, 𝜎 = 1.9.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 13.1. Calculating Standard Error and z-Obtained Values</h5> </div> <div class="textbox__content"><p><strong>Formula for standard error:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fSA9IFxmcmFje1xzaWdtYX17XHNxcnR7Tn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" title="\sigma_{\bar{x}} = \frac{\sigma}{\sqrt{N}}" class="latex mathjax" /></p> <p><strong>Formula for <em>z</em>-obtained value (for the <em>z</em>-test):&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyhcYmFye3h9IC0gXG11KX17XHNpZ21hX3tcYmFye3h9fX0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(\bar{x} - \mu)}{\sigma_{\bar{x}}}" title="z = \frac{(\bar{x} - \mu)}{\sigma_{\bar{x}}}" class="latex mathjax" /></p> <p><strong>Our example s</strong><strong>tandard error:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hX3tcYmFye3h9fSA9IFxmcmFjezEuOX17XHNxcnR7MjY0fX09MC4xMg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_{\bar{x}} = \frac{1.9}{\sqrt{264}}=0.12" title="\sigma_{\bar{x}} = \frac{1.9}{\sqrt{264}}=0.12" class="latex mathjax" /></p> <p><strong>Our example <em>z</em>-obtained value (for the <em>z</em>-test):&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=eiA9IFxmcmFjeyg0LjcgLSA1KX17MC4xMn0gPSAtMi41&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="z = \frac{(4.7 - 5)}{0.12} = -2.5" title="z = \frac{(4.7 - 5)}{0.12} = -2.5" class="latex mathjax" /></p> </div> </div> <h4 class="import-Normal">Step 4: Make a Decision</h4> <p class="import-Normal">Based on the set-up from Step 2, you’ll see in Figure 13.5 that your <em>z</em>-obtained value (<em>z</em> = −2.5) falls in your alpha area (i.e., it exceeds your critical value of −1.65).</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-259" style="width: 700px"><img class="wp-image-1227" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-13.5R-1.png" alt="A standard normal distribution, with all 5% of alpha area shaded on left side of distribution. The z-critical is -1.65 separating alpha and confidence. The z-obtained (-2.5) is labeled and shown in the alpha area." width="700" height="421" title="" /><div class="wp-caption-text">Figure 13.5. Results from hypothesis test showing <em>z</em>-obtained value in the alpha area.</div></div> <p class="import-Normal">So, you’ll <strong>reject the null hypothesis.</strong> This means that your sample is significantly <em>lower</em> than the national average, which is what you hypothesized with your one-tailed test.</p> <p class="import-Normal">Let’s go ahead and find our exact <em>p</em> value and maximum confidence level before writing up the results for our report. To find exact <em>p</em> value, we will look up our <em>z</em>-obtained in Table A.1. The <em>area beyond z</em> = 0.0062. We only tested one tail, so our total alpha area = .0062. This is less than (&lt;) 0.05 (our set significance level), so we do have a significant difference. For our maximum confidence level, we will take 1 – alpha, so 1 – 0.0062, which equals 0.9938, or 99.38%. This is greater than 95%, so again, we do have a significant difference.</p> <h4 class="import-Normal">APA-Style Write-Up</h4> <p>Our American Psychological Association (APA, 2020)-style write-up would be as follows:</p> <p class="import-Normal" style="padding-left: 40px;">A one-sample <em>z</em>-test was calculated to compare the average number of prior incarcerations from a sample of women who are currently incarcerated in Illinois to the mean found with a large, federal survey. Based on a sample size of 264, women in Illinois who were incarcerated had a significantly <strong>lower </strong>average of prior incarcerations (<em>M</em> = 4.7, <em>SD</em> = 1.9) than the national average (<em>M</em> = 5), <em>z</em> = −2.5, <em>p</em> &lt; .05.</p> <p class="import-Normal">The second sentence could include the exact <em>p</em> value instead of “<em>p</em> &lt; .05”:</p> <p class="import-Normal" style="padding-left: 40px;">Based on a sample size of 264, women in Illinois who were incarcerated had a significantly <strong>lower </strong>average of prior incarcerations (<em>M</em> = 4.7, <em>SD</em> = 1.9) than the national average (<em>M</em> = 5), <em>z</em> = −2.5, <em>p</em> = .0062.</p> <p class="import-Normal">In both statements, we can indicate that we had a directional hypothesis by also using the phrase “significantly lower” rather than “significantly different.”</p> <p class="import-Normal">To summarize, a directional hypothesis or one-tailed test increases the likelihood of rejecting the null hypothesis or finding a significant difference. This test can be used when expectations of findings are solid. Differences between one-tailed and two-tailed hypothesis tests can be found in the following steps:</p> <ul><li>Alternative hypothesis statement: “&lt;” or “&gt;” rather than “≠”</li> <li>Alpha is still 0.05, but it is not divided between two tails, so the critical value is <em>z</em> = 1.65 (if hypothesized higher) or <em>z</em> = −1.65 (if hypothesized lower) for a one-tailed test. The alpha is all on one side of the distribution.</li> <li>Your exact <em>p</em> value is just the <em>area beyond z</em>. You don’t have to multiply by 2 because you only tested one tail.</li> </ul> <h2 class="import-Normal">Errors in Hypothesis Testing</h2> <p class="import-Normal">Another topic in using the hypothesis testing framework is examining errors that can occur. Because we are working with confidence levels (95% or 99%) and we are making inferences based on our level of confidence, there is room for error. For example, with 95% confidence, there is a 5% chance of error. There are two types of error that can occur:</p> <ul><li>First, you have a chance of making a <strong><em><span class="glossary-term">Type I error</span></em></strong> when you reject the null hypothesis. This is when you say there is a difference, but there actually isn’t a difference. You may see this referred to as a <em>false positive</em>.</li> <li>Second, you have a chance of making a <strong><em><span class="glossary-term">Type II error</span> </em></strong>when you fail to reject the null hypothesis. This is when you say there is no difference, but there actually is a difference. You may see this referred to as a <em>false negative</em>.</li> </ul> <p class="import-Normal">You always have the chance of one or the other type of error. As you move the confidence level up (to 99%) or down (to 95%), there’s still a chance of error. Again, you will never have 100% confidence because you are working with samples to make inferences about the populations from which they came. You can try to reduce the amount of sampling error by increasing your sample size (which will reduce your standard error estimate), but you will still have Type I or Type II error to account for. Table 13.1 summarizes hypothesis testing and Type I and II errors.</p> <table style="width: 810px; height: 320px;"><caption>Table 13.1. Summary of Type I and Type II Errors Based on Hypothesis Testing Conclusion and Reality</caption> <thead><tr style="height: 29.05pt;"><th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 331.406px;" scope="col"><strong>When you conclude:</strong></th> <th class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 194.906px;" scope="col"><p class="import-Normal" style="text-align: center;">But in reality, there is <strong>no relationship, effect, or difference</strong></p> <p class="import-Normal" style="text-align: center;">(i.e., the null is true)</p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 234.406px;" scope="col"><p class="import-Normal" style="text-align: center;">But in reality, there <strong>is a significant relationship, effect, or difference</strong></p> <p class="import-Normal" style="text-align: center;">(i.e., the null is false)</p> </th> </tr> <tr class="TableGrid-R" style="height: 46pt;"><th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 331.406px; vertical-align: middle;" scope="row"><p class="import-Normal"><strong>“Fail to Reject the Null Hypothesis”</strong>&nbsp;(no relationship, effect, or difference)</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 194.906px;"><p class="import-Normal" style="text-align: center;">No error</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 234.406px;"><p class="import-Normal" style="text-align: center;"><strong>Type II error</strong></p> </td> </tr> <tr class="TableGrid-R" style="height: 45.15pt;"><th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 331.406px;" scope="row"><p class="import-Normal"><strong>“Reject the Null Hypothesis” </strong>(there is a relationship, effect, or difference)</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 194.906px;"><p class="import-Normal" style="text-align: center;"><strong>Type I error</strong></p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 234.406px;"><p class="import-Normal" style="text-align: center;">No error</p> </td> </tr> </thead> </table> <h2 class="import-Normal">Limitations to Hypothesis Testing</h2> <p class="import-Normal">Although the hypothesis testing framework is helpful for using inferential statistics and drawing conclusions, there are also limitations worth considering, in addition to the chances of error.</p> <p class="import-Normal">In Step 4 of the hypothesis test we either reject or fail to reject the null hypothesis. Let’s look at the following example. We have two samples, and their means are extremely close (<em>M</em> = 101.97 and <em>M</em> = 101.95). When we compare each of these samples to the population mean (<em>M</em> = 100), we would go through the four steps of the hypothesis test to make a conclusion. As you see in the example Comparing Sample 1 and Sample 2, Sample 1 has a <em>z</em>-obtained value of 1.97, and Sample 2 has a <em>z</em>-obtained value of 1.95. These obtained values are very close to each other, but they are on either side of your critical value of 1.96. So, you’d make different decisions about these samples. Thus, it is important to use caution with results f rom hypothesis testing when your obtained values are close to a critical value.</p> <p class="import-Normal">Similarly, if we think about the conclusions we drew from these tests, we would say that Sample 1 has a “significant difference,” whereas Sample 2 “did not have a significant difference.” There are absolute decisions and conclusions based on a small difference between your obtained values and where they fall in relation to your critical value.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h3 class="textbox__title">Example 13.2. Comparing Sample 1 and Sample 2</h3> </div> <div class="textbox__content"><p>Sample 1 (<em>N</em> = 225): <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅ </em>= 101.97</span>, <em>s</em> = 15</p> <ul><li><em>z</em>-critical value = ±1.96.</li> <li><em>z</em>-obtained value = 1.97.</li> <li>Reject the null hypothesis: There is a significant difference (i.e., <em>z</em>-obtained value of 1.97 exceeds <em>z</em>-critical value of 1.96).</li> </ul> <p>Sample 2 (N = 225): <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅ </em>= 101.95</span>, <em>s</em> = 15</p> <ul><li>z-critical value = ±1.96.</li> <li>z-obtained value = 1.95.</li> <li>Fail to reject the null hypothesis: There is not a significant difference (i.e., <em>z</em>-obtained value of 1.95 does not exceed <em>z</em>-critical value of 1.96).</li> </ul> </div> </div> <p class="import-Normal">In addition, hypothesis tests do not directly address the magnitude of your result. For example, if we have a <em>z</em>-obtained value of 3.2 and a <em>z</em>-obtained value of 16.8, we would make the same inference for both of these obtained values (i.e., we would reject the null hypothesis, stating that there is a significant difference). Thus, although hypothesis testing can be useful, it is important to keep these limitations in mind, especially if you have a marginal result that borders the critical value.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">When you have strong expectations about the direction of your result, you can use directional hypothesis testing (i.e., a one-tailed test), which can increase the likelihood of rejecting the null hypothesis. Differences between one-tailed and two-tailed hypothesis tests can be found in the following steps:</p> <ul><li>Alternative hypothesis statement: “&lt;” or “&gt;” rather than “≠”</li> <li>Alpha is still 0.05, but it is not divided between two tails, so the critical value is 1.65 (if hypothesized higher) or −1.65 (if hypothesized lower) for a one-tailed test.</li> <li>Your exact <em>p </em>value is just the <em>area beyond z</em>. You don’t have to multiply by 2 because you only tested one tail.</li> </ul> <p class="import-Normal">When using hypothesis testing, there is a chance for two errors to occur, as well as a few limitations to keep in mind:</p> <ul><li>Type I error: when you reject the null hypothesis when there actually isn’t a difference (false positive).</li> <li>Type II error: when you fail to reject the null hypothesis when there actually is a difference (false negative).</li> <li>Limitations: with an all-or-nothing decision and the inability to address the magnitude of the results, it is important to keep these limitations in mind. Use caution when interpreting and reporting results that fall near a critical value.</li> </ul> </div> 
	</div>
			
				
				
	</div>

</div>
<div class="part-wrapper" id="part-unit-v-inferential-statistics-looking-at-differences-wrapper">
    <div class="part  " id="part-unit-v-inferential-statistics-looking-at-differences">
	<div class="part-title-wrap">
		<p class="part-number">V</p>
		<h1 class="part-title">Unit 5. Inferential Statistics: Looking at Differences</h1>
	</div>
	<div class="ugc part-ugc">
		<p>This unit examines four types of inferential statistics that answer research questions around differences. For example, we will be testing differences between two or more groups or differences within participants across time. These tests include three types of <em>t</em>-tests, as well as the analysis of variance (ANOVA). The accompanying table provides a summary of these tests.</p> <table style="width: 891px; height: 282px;"><caption>Table V.1. Summary of Inferential Statistical Tests and Research Questions in Unit 5</caption> <thead><tr style="height: 53px;"><th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 168.016px; height: 53px;" scope="col"><p class="import-Normal"><strong>Inferential Statistical Test</strong></p> </th> <th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 689.797px; height: 53px; vertical-align: middle;" scope="col"><p class="import-Normal"><strong>Research </strong><strong>Question</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 54.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 168.016px; height: 70px;" scope="row"><p class="import-Normal">One-sample t-test</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 689.797px; height: 70px;"><p class="import-Normal">Allows you to compare one sample mean to a population mean (when population standard deviation is unknown and/or you have a small sample)</p> </td> </tr> <tr class="TableGrid-R" style="height: 18.4pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 168.016px; height: 53px;" scope="row"><p class="import-Normal">Independent samples t-test</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 689.797px; height: 53px;"><p class="import-Normal">Allows you to compare differences between two independent sample means</p> </td> </tr> <tr class="TableGrid-R" style="height: 17.35pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 168.016px; height: 53px;" scope="row"><p class="import-Normal">Dependent samples t-test</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 689.797px; height: 53px;"><p class="import-Normal">Allows you to compare differences within two dependent sample means</p> </td> </tr> <tr style="height: 53px;"><th style="vertical-align: middle; border: 0.5pt solid windowtext; width: 168.016px; height: 53px;" scope="row"><p class="import-Normal">Analysis of variance (ANOVA)</p> </th> <td style="vertical-align: middle; border: 0.5pt solid windowtext; width: 689.797px; height: 53px;"><p class="import-Normal">Allows you to compare three or more independent sample means (with a one-way ANOVA)</p> </td> </tr> </tbody> </table>
	</div>
			
				
	</div>
<div class="chapter standard " id="chapter-chapter-14-an-introduction-to-t-tests-the-one-sample-t-test" title="Chapter 14: An Introduction to t-Tests and the One-Sample t-test">
	<div class="chapter-title-wrap">
		<p class="chapter-number">34</p>
		<h1 class="chapter-title">Chapter 14: An Introduction to t-Tests and the One-Sample t-test</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-14:-an-introduction-to-t-tests-&amp;-the-one-sample-t-test"><p class="import-Normal">In previous chapters, we have seen the <em>z</em>-test as our first type of inferential test. We compared one sample mean to a population mean. Our next type of inferential test is the <strong><em><span class="glossary-term">one-sample t-test</span></em></strong>; this test is very similar to the <em>z</em>-test because we are still comparing one sample mean to a mean of a population. The key differences are what information is known about the population and your sample size. In this chapter, we will first introduce the<strong><em><span class="glossary-term">t-test</span></em></strong>, which allows us to test inferential hypotheses with smaller samples and when we do not know our population standard deviation. The <em>t</em>-test allows us to calculate the expected sampling error (i.e., standard error) using our sample standard deviation and make adjustments to our analyses based on our sample size. Using a <em>t</em>-test will have impacts on hypothesis testing, including the test you select in Step 2, the critical values you use, and the distribution you use.</p> <h2 class="import-Normal">The <em>t</em>-Distribution and Degrees of Freedom</h2> <p class="import-Normal">The <em>t</em>-test uses the <strong><em><span class="glossary-term">t distribution</span></em></strong>, which looks very similar to the standard normal distribution (see Figure 14.1). You still have an area of 1.00 under the bell-shaped curve; the mean is still 0 at the center of your distribution. If your sample size is around 100 or greater, the shape of your distribution looks normal (i.e., it approximates the normal distribution). However, if your sample size is smaller (typically less than 100), the shape changes slightly as a function of your degrees of freedom. Thus, <em>t</em> distributions are a family of distributions; each distribution looks slightly different for each different degree of freedom.</p> <div class="wp-caption aligncenter" id="attachment_266" aria-describedby="caption-attachment-266" style="width: 700px"><img class="wp-image-266" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-14.1R.png" alt="Three distributions are shown that are each slightly different depending on degrees of freedom. This figure has degrees of freedom = 5, 50 and 100 to show the slight differences to the distributional shape." width="700" height="347" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-14.1R.png 1354w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-14.1R-300x149.png 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-14.1R-1024x507.png 1024w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-14.1R-768x381.png 768w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-14.1R-65x32.png 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-14.1R-225x112.png 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-14.1R-350x173.png 350w" sizes="auto, (max-width: 700px) 100vw, 700px" title="" /><div class="wp-caption-text" id="caption-attachment-266">Figure 14.1. <em>t</em> Distributions are a family of distributions, that adjust to your degrees of freedom (<em>df</em>).</div></div> <p>The term <em>degrees of freedom</em> is defined as the number of observations or values in the data that are free to vary. To illustrate degrees of freedom, let’s say you have seven clients. Across their cognitive assessment scores, the total score was 30. Scores ranged from 2 (low cognitive difficulties) to 6 (high cognitive difficulties). You decide to assign each client to a case manager for follow-ups.&nbsp;To keep things fair, you have case managers pull a client letter out of a bag:</p> <ul><li>Case Manager 1 has seven clients they may get; they pull Client A out of the bag, and this client has a score of 4.</li> <li>Case Manager 2 now has six clients they may get; they pull Client B out of the bag, and this client has a score of 6.</li> <li>Case Manager 3 now has five clients they may get; they pull Client C out of the bag, and this client has a score of 3.</li> <li>Case Manager 4 now has four clients they may get; they pull Client D out of the bag, and this client has a score of 4.</li> <li>Case Manager 5 now has three clients they may get; they pull Client E out of the bag, and this client has a score of 5.</li> <li>Case Manager 6 now has two clients they may get; they pull Client F out of the bag, and this client has a score of 6.</li> <li>Now, Case Manager 7 does not have any “degrees of freedom”; in other words, they only have one client left to pull out of the bag. We would also already know what Client G’s score would be. Again, the total was 30, and if you add the rest of the clients’ scores that were already selected (4 + 6 + 3 + 4 + 5 + 6 = 28), you can see that this client’s score is 2. So, although each case manager had client scores that were “free to vary” for Clients A to F, the case manager who gets the final client score would have to be the client with a score of 2.</li> </ul> <p class="import-Normal">This example helps illustrate how we find degrees of freedom. Across statistical tests, you may be estimating one parameter, or you may be estimating multiple parameters. So, your calculation of degrees of freedom&nbsp; will differ depending on your test. However, in this chapter, we will be estimating one parameter (i.e., the population mean with a one-sample <em>t</em>-test). So, to calculate our degrees of freedom, we will use <img src="https://mathjax.library.illinois.edu/latex?latex=TiDigJMgMQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N – 1" title="N – 1" class="latex mathjax" />. Just like in our earlier example above, if we have seven scores, we have 7 – 1, or 6 degrees of freedom (i.e., 6 client scores are free to vary); the last client score is constrained to be 2, so it is not free to vary.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-266" style="width: 612px"><img class="wp-image-412 size-full" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/14.2-1.jpg" alt="Two older individuals are sitting and conversing at a table." width="612" height="408" title="" /><div class="wp-caption-text">Figure 14.2. “<a href="https://www.pexels.com/photo/woman-smiling-while-looking-at-her-man-6787761/" target="_blank" rel="noopener" data-url="https://www.pexels.com/photo/woman-smiling-while-looking-at-her-man-6787761/">Woman Smiling While Looking at her Man</a>” by <a href="https://www.pexels.com/@marcus-aurelius/" target="_blank" rel="noopener" data-url="https://www.pexels.com/@marcus-aurelius/">Marcus Aurelius</a>, via <a href="https://www.pexels.com/" target="_blank" rel="noopener" data-url="https://www.pexels.com/">Pexels</a>, 2021. <a href="https://www.pexels.com/license/" target="_blank" rel="noopener" data-url="https://www.pexels.com/license/">Pexels license</a>.</div></div> <p class="import-Normal">As you’ll see later in this chapter, we will be using our degrees of freedom calculation <img src="https://mathjax.library.illinois.edu/latex?latex=KE4g4oCTIDEp&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(N – 1)" title="(N – 1)" class="latex mathjax" /> to help us find the <em>t </em>distribution that adjusts for sample size and corresponding degrees of freedom. For example, if your <em>N</em> = 5, your degrees of freedom would be 4 (often notated as <em>df</em>), or <em>df</em> = 4. This distribution would be adjusted for the smaller size compared with a sample where <em>N</em> = 100, with 99 degrees of freedom. If you look at Table A.2 in the Appendix, you’ll see the degrees of freedom listed to help you find the corresponding critical values for your <em>t</em> distribution.</p> <p class="import-Normal">Unlike the <em>z</em>-test, which for 95% confidence could always use <em>z</em> = ±1.96 as the critical values, you’ll need to adjust for sample size and degrees of freedom when using the <em>t</em>-test. Therefore, you’ll need to look up <em>t</em>-test critical values for every hypothesis test you conduct, based on your degrees of freedom (e.g., <img src="https://mathjax.library.illinois.edu/latex?latex=TiAtIDE&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N - 1" title="N - 1" class="latex mathjax" />).</p> <p class="import-Normal">Again, if your sample size is around 100 or greater, the shape of your <em>t</em> distribution approximates the normal distribution shape. Thus, as your sample size (and degrees of freedom) increase, the <em>t</em> distribution approximates the standard normal distribution. You can see this approximation when you look at the critical values for 100 degrees of freedom. With 95% confidence for a two-tailed test, your <em>t</em>-critical values would be ±1.984. These values are close to ±1.96 for <em>z</em>-critical values. When you have 500 degrees of freedom, you’re even closer to approximating the standard normal distribution, with <em>t-</em>critical values of ±1.965.</p> <p class="import-Normal">By adjusting the distribution shape by degrees of freedom, the <em>t</em> distribution adjusts for the likely amount of error that is involved with smaller samples. This variation by degrees of freedom (and corresponding <em>t</em>-critical value[s]) is what allows <em>t</em>-tests to be able to make more accurate inferences; we end up with a more precise estimation.</p> <h2 class="import-Normal">One-Sample <em>t</em>-Test</h2> <p class="import-Normal">The first type of <em>t</em>-test we’ll conduct is a <strong><em>one-sample t-test</em></strong>. This test answers research questions like you asked when using a <em>z</em>-test. However, as shown in the decision tree in Figure 14.3, if you do not know your population mean and standard deviation, and/or you have a small sample size, then you will be using a <em>t</em>-test. As we go through the four steps of the one-sample <em>t</em>-test hypothesis test, the differences for a <em>t</em>-test versus a <em>z</em>-test will be highlighted.</p> <p><img class="wp-image-1230" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-14.3R-1.png" alt="&amp;quot;A" title="" /></p> <h3 class="import-Normal">Example: Hypothesis Test of Post-Traumatic Stress Symptoms Among Parents</h3> <p class="import-Normal">You are a medical social worker who works in a hospital integrated care unit (for more information on the role of social workers in integrated care, see Milano et al. [2022]). You are assigned to the neonatal intensive care unit (NICU) and are helping assess levels of post-traumatic stress symptoms (PTSS) among parents who had an infant in the NICU. Your unit supervisor wants to know if this sample of parents (<em>N</em> = 35) has different levels of PTSS compared with a norm sample of parents who also experienced similar events.</p> <p class="import-Normal"><strong>Research question: </strong>Does this sample of parents have different levels of PTSS compared with the norm?</p> <p class="import-Normal">From the assessment manual, you find that 𝜇 = 70. Right away, you might be able to think about the type of test we can use here. There is no population standard deviation provided, and you have a small sample (<em>N</em> = 35). These should be clues that you’ll be running a type of <em>t</em>-test.</p> <h4 class="import-Normal">Step 1: Hypothesis Pair</h4> <p>There are no differences in the hypothesis pair statements between one-sample <em>z</em>-tests and <em>t</em>-tests because our research questions are similar (i.e., comparing one sample mean to a population mean). We will be running a two-tailed test in this example, so we will use “≠” in our alternative hypothesis.</p> <ul><li>Null hypothesis: <em>μ</em><sub>1 </sub>= 70.</li> <li>Alternative hypothesis: <em>μ</em><sub>1 </sub>≠ 70.</li> </ul> <p class="import-Normal">This can also be notated as follows:</p> <ul><li><div><span style="font-size: NaNpt; color: #; text-decoration: none;"><span style="font-size: NaNpt; color: #; text-decoration: none;"><em>H</em><sub>o</sub>: </span></span><em>μ</em><sub>1 </sub>= 70.</div> </li> <li><div><span style="font-size: NaNpt; color: #; text-decoration: none;"><span style="font-size: NaNpt; color: #; text-decoration: none;"><em>H</em><sub>a</sub>: </span></span><em>μ</em><sub>1 </sub>≠ 70.</div> </li> </ul> <h4 class="import-Normal">Step 2: Setup for the Test</h4> <ul><li>What inferential test are you using? <strong>We will use a one sample <em>t</em>-test. Why? Because we want to compare one sample mean (<em>x̅</em>) to a population mean (<em>μ</em>). However, we do not know our population standard deviation in this example, and we have a small sample size (<em>N</em> = 35). So, we will use a one-sample <em>t</em>-test (instead of the <em>z</em>-test) to test our question.</strong></li> <li>Set your confidence/alpha: C<strong>onfidence = .95, and alpha = .05.</strong></li> <li>Find your critical value(s): <strong><em>t</em>-critical values (t<sub>c</sub>)= ±2.032.</strong></li> </ul> <p class="import-Normal">To find our <em>t</em>-critical values, we’ll use Table A.2. First, we must calculate our degrees of freedom (<em>df</em>). We will take <img src="https://mathjax.library.illinois.edu/latex?latex=TiDigJMgMQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N – 1" title="N – 1" class="latex mathjax" /> to find this. In our example, <em>N</em> = 35, so our <img src="https://mathjax.library.illinois.edu/latex?latex=ZGYgPSAzNSDigJMgMSA9IDM0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df = 35 – 1 = 34" title="df = 35 – 1 = 34" class="latex mathjax" />. If we go to Table A.2, we will find 34 in the first column. Then, we will find the column for a two-tailed test, with 0.05 for our alpha (significance level), which is our second column. In this book, examples always use two-tailed tests with 0.05 significance.</p> <p class="import-Normal">When we find <em>df</em> = 34, our critical value is 2.032. Again, we are testing both tails, so our critical values are ±2.032. See Figure 14.4.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-266" style="width: 700px"><img class="wp-image-1231" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-14.4R-1.png" alt="Set-up for our one sample t-test example is shown on a t-distribution, with critical values (at -2.032 and 2.032) separating our alpha and confidence areas." width="700" height="398" title="" /><div class="wp-caption-text">Figure 14.4. Set-up for our one-sample <em>t</em>-test example, with critical values separating our alpha and confidence areas.</div></div> <h4 class="import-Normal">Step 3: Test Statistic Computation</h4> <p class="import-Normal">First, solve for the standard error, using your sample standard deviation (8) divided by the square root of your sample size (35). Then, use that value to find your <em>t</em>-obtained value.</p> <p class="import-Normal" style="text-indent: 36pt;">Norm sample: 𝜇 = 70.</p> <p class="import-Normal" style="text-indent: 36pt;">Your sample: <em>N</em> = 35, <em><span style="font-size: NaNpt; color: #; text-decoration: none;">x̅ </span></em>= 74, <em>s</em> = 8.</p> <div class="textbox shaded"><h5>Formula 14.1. Calculating standard error and t-obtained value for one-sample <em>t</em>-test</h5> <p><strong>Formula for standard error:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fX0gPSBcZnJhY3tzfXtcc3FydHtOfX0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}} = \frac{s}{\sqrt{N}}" title="s_{\bar{x}} = \frac{s}{\sqrt{N}}" class="latex mathjax" /></p> <p><strong>Formula for <em>t</em>-obtained value (for the one-sample <em>t</em>-test):</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjeyhcYmFye3h9IC0gXG11KX17c197XGJhcnt4fX19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{(\bar{x} - \mu)}{s_{\bar{x}}}" title="t = \frac{(\bar{x} - \mu)}{s_{\bar{x}}}" class="latex mathjax" /></p> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 14.1. Calculating Standard Error and <em>t</em>-Obtained Values</h5> </div> <div class="textbox__content"><p><strong>Formula for standard error:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fX0gPSBcZnJhY3tzfXtcc3FydHtOfX0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}} = \frac{s}{\sqrt{N}}" title="s_{\bar{x}} = \frac{s}{\sqrt{N}}" class="latex mathjax" /></p> <p><strong>Formula for <em>t</em>-obtained (for the one-sample <em>t</em>-test):&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjeyhcYmFye3h9IC0gXG11KX17c197XGJhcnt4fX19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{(\bar{x} - \mu)}{s_{\bar{x}}}" title="t = \frac{(\bar{x} - \mu)}{s_{\bar{x}}}" class="latex mathjax" /></p> <p><strong>Our example–s</strong><strong>tandard error:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fX0gPSBcZnJhY3s4fXtcc3FydHszNX19PTEuMzU&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}} = \frac{8}{\sqrt{35}}=1.35" title="s_{\bar{x}} = \frac{8}{\sqrt{35}}=1.35" class="latex mathjax" /></p> <p><strong>Our example–<em>t</em>-obtained value:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjeyg3NCAtIDcwKX17MS4zNX0gPSAyLjk2&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{(74 - 70)}{1.35} = 2.96" title="t = \frac{(74 - 70)}{1.35} = 2.96" class="latex mathjax" /></p> </div> </div> <p class="import-Normal">For our example, the <em>t-</em>obtained value is 2.96.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-266" style="width: 700px"><img class="wp-image-1232" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-14.5R-1.png" alt="The t-obtained value (t = 2.96) is marked on our t-distribution that we set-up in Step 2. It is shown in the alpha area of the distribution." width="700" height="398" title="" /><div class="wp-caption-text">Figure 14.5. The <em>t-</em>obtained value (<em>t</em> = 2.96) shown on our <em>t</em> distribution that we set-up in Step 2.</div></div> <h4 class="import-Normal">Step 4: Make a Decision</h4> <p class="import-Normal">As shown in Figure 14.5, if we plot where our <em>t</em>-obtained value (<em>t</em> = 2.96) falls in relation to your confidence and alpha areas (as defined in Step 2), we see that our obtained value falls in the alpha area of the distribution (i.e., it also exceeds our critical value of 2.032). This means that we will <strong>reject the null hypothesis</strong>. This result means that our sample is significantly different from the population mean; this sample has an average score that falls beyond the confidence area. This book does not include tables for exact <em>p</em> values, but you can compute this using your <em>t</em>-obtained value and degrees of freedom in Excel or through various online calculators (e.g., Social Science Statistics, n.d.). In our example, our exact <em>p </em>value is .006, so <em>p</em> &lt; .05, which also indicates a statistically significant difference.</p> <h4 class="import-Normal">APA-Style Write-Up</h4> <p>The American Psychological Association (APA, 2020)-style write-up for a one-sample <em>t</em>-test is very similar to that for the <em>z</em>-test. One noted difference is that when you write the <em>t</em>-obtained value, you now include your degrees of freedom in parentheses (in this example, “34”), after the <em>t</em>, and then include the obtained value:</p> <p class="import-Normal" style="padding-left: 40px;">A one-sample <em>t</em>-test was calculated to compare the average levels of PTSS among NICU parents with the norm average. Based on a sample of 35 parents, this sample did have significantly different levels of PTSS (mean [<em>M</em>] = 74, standard deviation [<em>SD</em>] = 8), than the norm average (<em>M</em> = 70), <em>t</em>(34) = 2.96, <em>p</em> &lt; .05.</p> <p class="import-Normal">If you calculate the exact <em>p</em> value, the second sentence could also include the exact <em>p</em> value:</p> <p class="import-Normal" style="padding-left: 40px;">Based on a sample of 35 parents, this sample did have significantly different levels of PTSS (<em>M</em> = 74, <em>SD</em> = 8) than the norm average (<em>M</em> = 70), <em>t(</em>34) = 2.96, <em>p</em> = .006.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">When we do not know our population parameter (<em>𝜎</em>), and we have small sample sizes (<em>N</em> &lt; 100), we can conduct inferential statistics using the <em>t </em>distribution. This is a family of distributions; each distribution looks slightly different for each different degree of freedom. In this chapter, we highlighted the one-sample <em>t</em>-test, which compares a sample mean to a population mean. However, this <em>t</em>-test is unique from the <em>z</em>-test because we do not know our population standard deviation, and we had a small sample size.</p> </div> 
	</div>
			
				
				
	</div>
<div class="chapter standard " id="chapter-chapter-15-independent-samples-t-tests" title="Chapter 15: Independent Samples t-Tests">
	<div class="chapter-title-wrap">
		<p class="chapter-number">35</p>
		<h1 class="chapter-title">Chapter 15: Independent Samples t-Tests</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-15:-independent-samples-t-tests"><p class="import-Normal">In Chapter 14, the <em>t</em>-test, with <em>t </em>distributions based on degrees of freedom, was introduced. Across the next two chapters, we will examine two additional types of <em>t-</em>tests: independent and dependent samples <em>t</em>-tests. Both tests continue to assess research questions that examine differences. To keep our research questions organized, Table 15.1 shows the three types of <em>t-</em>tests and the questions we will test across Chapters 14 to 16.</p> <table style="width: 994px;"><caption>Table 15.1. Summary of <em>t</em>-Tests and Research Questions</caption> <thead><tr style="height: 18.4pt;"><th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 173.297px; vertical-align: middle;" scope="col"><p class="import-Normal"><strong>Inferential Statistical Test</strong></p> </th> <th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 787.516px; vertical-align: middle;" scope="col"><p class="import-Normal"><strong>Research </strong><strong>Question</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 54.15pt;"><th style="border: 0.5pt solid windowtext; width: 173.297px; vertical-align: middle;" scope="row"><p class="import-Normal">One-sample <em>t</em>-test</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 787.516px;"><p class="import-Normal">Allows you to compare one sample mean to a population mean (when population standard deviation is unknown and/or you have a small sample)</p> </td> </tr> <tr class="TableGrid-R" style="height: 18.4pt;"><th style="border: 0.5pt solid windowtext; width: 173.297px; vertical-align: middle;" scope="row"><p class="import-Normal">Independent samples <em>t</em>-test</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 787.516px;"><p class="import-Normal">Allows you to compare differences between two independent sample means</p> </td> </tr> <tr class="TableGrid-R" style="height: 17.35pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 173.297px;" scope="row"><p class="import-Normal">Dependent samples <em>t</em>-test</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 787.516px;"><p class="import-Normal">Allows you to compare differences within two dependent sample means</p> </td> </tr> </tbody> </table> <h2 class="import-Normal">Independent Samples <em>t</em>-Test</h2> <p class="import-Normal">The <strong><em><span class="glossary-term">independent samples t-test</span></em></strong> compares means between two samples, each randomly selected from a different population. If you have two independent groups and you want to see if they are significantly different from one another, this is the <em>t</em>-test to use to help answer this question.</p> <h3 class="import-Normal">Example: Comparing Types of After-School Programming</h3> <p class="import-Normal">For example, if you are running an after-school program for young children, you may be curious to compare mean levels of communication skills between those who participate in the theater-based activities (Group 1) and those who participate in sports-based activities (Group 2). For each group, you could calculate a sample mean and then use an independent samples <em>t</em>-test to see if there is a significant difference between these two groups in their levels of communication skills.</p> <p class="import-Normal">As we continue in this book, levels of measurement will become important to assess before selecting an inferential test. By identifying our variables’ levels of measurement, we can then appropriately select the correct inferential test to answer our question. For an independent samples <em>t</em>-test, you will have research questions that have a categorical independent variable, with two groups or samples. Your dependent variable will be continuous (because you will be looking at means). In our example, here is our research question, along with our variables and their levels of measurement identified:</p> <p class="import-Normal"><strong>Research question: </strong>Are levels of communication skills dependent on the students’ activity group in the after-school program?</p> <ul><li><strong>Independent variable</strong>: Activity group type–categorical variable that has two groups: (1) theater-based activities or (2) sports-based activities)</li> <li><strong>Dependent variable:</strong> Communication skills–continuous variable with a mean score for each group</li> </ul> <p class="import-Normal">The independent samples <em>t</em>-test will examine the mean differences in a variable between two groups. The test will compare a sample mean from each group: Group 1 (<span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em><sub>1</sub>) </span>and Group 2 (<span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em><sub>2</sub>)</span>. Both of these groups have their own population means that they are sampled from and making inferences about (<span style="font-size: NaNpt; color: #; text-decoration: none;"><em>μ</em><sub>1 </sub></span>and <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>μ</em><sub>2</sub></span>). We can use a subscript “1” and “2” to identify our two groups. We will be testing a sampling distribution of <span style="font-size: NaNpt; color: #; text-decoration: none;">(<em>x̅</em><sub>1 </sub>– <em>x̅</em><sub>2</sub>) </span>and testing whether there is a significant difference between two means (see Figure 15.1).</p> <p>&nbsp;</p> <div class="wp-caption aligncenter" id="attachment_273" aria-describedby="caption-attachment-273" style="width: 700px"><img class="wp-image-273" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-15.1R.png" alt="This shows a sample mean (x-bar, subscript 1) being used from it&amp;#039;s population mean (mu, subscript 1), and comparing it to another sample mean (x-bar, subscript 2) being used from it&amp;#039;s population mean (mu, subscript 2). Between the two sample means, the sampling distribution for this analysis is shown, which is x-bar subscript 1 minus x-bar subscript 2, asking &amp;quot;is there a significant difference between these two means?&amp;quot;" width="700" height="487" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-15.1R.png 1017w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-15.1R-300x209.png 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-15.1R-768x534.png 768w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-15.1R-65x45.png 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-15.1R-225x156.png 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-15.1R-350x243.png 350w" sizes="auto, (max-width: 700px) 100vw, 700px" title="" /><div class="wp-caption-text" id="caption-attachment-273">Figure 15.1. An independent samples <em>t</em>-test examines the difference between two sample means, making inferences about the population difference.</div></div> <p class="import-Normal">Let’s go through our example with a full hypothesis test for an independent samples <em>t</em>-test. Here’s some information we’ll need to conduct this hypothesis test (i.e., mean, sum of squares, and sample size for each group). Remember, we use a subscript “1” and “2” with our notation to distinguish information between our two groups.</p> <ul><li class="import-Normal">Group 1 (theater-based group): <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em><sub>1 </sub></span>= 13.78, <em>SS</em><sub>1</sub> = 310, <em>N</em><sub>1</sub> = 36</li> <li class="import-Normal">Group 2 (sports-based group): <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em><sub>2 </sub></span>= 11.60, <em>SS</em><sub>2</sub> = 272, <em>N</em><sub>2</sub> = 36</li> </ul> <h4 class="import-Normal">Step 1: Hypothesis Pair</h4> <p class="import-Normal">We are comparing two sample means, both of which came from their own population. So, we are making inferences about <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>μ</em><sub>1 </sub></span>and <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>μ</em><sub>2</sub></span>, and will refer to them in our hypothesis pair. Our null hypothesis states that the mean of the population from which Sample 1 was selected is equal to the mean of the population from which Sample 2 was selected.</p> <p class="import-Normal">The alternative hypothesis states that the mean of the population from which sample 1 was selected is not equal to or different from the mean of the population from which sample 2 was selected. Your hypothesis pair for an independent samples <em>t</em>-test will always look like this because you are comparing two samples and populations to each other rather than to a comparison value (e.g., population average), in contrast to the <em>z</em>-test and one-sample <em>t</em>-test.</p> <p class="import-Normal">So, your hypothesis pair for an independent samples <em>t</em>-test is as follows:</p> <ul><li>Null hypothesis: μ<sub>1</sub> = μ<sub>2</sub>.</li> <li>Alternative hypothesis: μ<sub>1</sub> <span style="font-size: 14pt;">≠ μ</span><sub>2</sub>.</li> </ul> <p class="import-Normal">This can also be written as follows:</p> <ul><li><em>H</em><sub>0</sub>:&nbsp;μ<sub>1</sub> = μ<sub>2</sub>.</li> <li><em>H</em><sub>a</sub>: <em>μ<sub>1</sub> <span style="font-size: 14pt;">≠ μ</span><sub>2</sub>.</em></li> </ul> <h4 class="import-Normal">Step 2: Setup for the Test</h4> <ul><li>What inferential test are you using? <strong>Independent samples <em>t</em>-test</strong> <ul><li>Reasons for selecting this test: <ul><li><strong>Your research question involves testing mean differences between two independent groups.</strong></li> <li><strong>You have a categorical independent variable with two groups (theater-based versus sports-based activity groups) and a continuous dependent variable (mean levels of communication).</strong></li> </ul> </li> </ul> </li> <li>Set your confidence/alpha: <strong>Confidence = .95, and alpha = .05.</strong></li> </ul> <p class="import-Normal">Before we finish step 2 by finding our critical values, we first must review the two types of independent samples <em>t</em>-tests: one that assumes the two population variances are equal (i.e., <strong><em><span class="glossary-term">pooled variance t-test</span></em></strong>) and one that does not assume the population variances are equal (i.e.,<strong><em><span class="glossary-term">separate variance t-test or Welch’s t-test</span></em></strong>). There is an <em>F</em>-test (testing <img src="https://mathjax.library.illinois.edu/latex?latex=XHNpZ21hXzFeMiA9IFxzaWdtYV8yXjIgXHRleHR7IHRvIH0gXHNpZ21hXzFeMiBcbmVxIFxzaWdtYV8yXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sigma_1^2 = \sigma_2^2 \text{ to } \sigma_1^2 \neq \sigma_2^2" title="\sigma_1^2 = \sigma_2^2 \text{ to } \sigma_1^2 \neq \sigma_2^2" class="latex mathjax" />), that determines whether the two variances are significantly different from one another. When the group sample sizes are equal or very similar in size, variances are likely to be equal (and a pooled variance <em>t</em>-test would be fine to use). However, when sample sizes differ and you want a more conservative estimate to account for each group’s variance, then the separate variance <em>t</em>-test is recommended.</p> <p class="import-Normal">The process of finding your degrees of freedom (which then will help you find your critical values) will differ depending on which independent samples <em>t</em>-test you select. For calculating the degrees of freedom with a pooled variance <em>t</em>-test, we take away 1 degree of freedom for each sample we have. Because we have two samples in this type of test, we will take away 2 degrees of freedom: <img src="https://mathjax.library.illinois.edu/latex?latex=ZGYgPSAoTl8xICsgTl8yKSAtIDI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df = (N_1 + N_2) - 2" title="df = (N_1 + N_2) - 2" class="latex mathjax" /></p> <div class="textbox shaded"><h5>Formula 15.1. Calculating degrees of freedom (pooled variance t-test)</h5> <p class="import-Normal" style="text-align: left;"><b>Formula for degrees of freedom </b><b>(df; </b><strong>pooled variance <em>t-</em>test):</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=ZGYgPSAoTl8xICsgTl8yKSAtIDI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df = (N_1 + N_2) - 2" title="df = (N_1 + N_2) - 2" class="latex mathjax" /></p> </div> <p class="import-Normal">You’ll add the sample size from Group 1 (<em>N</em><sub>1</sub>) and the sample size from Group 2 (<em>N</em><sub>2</sub>). Then, you’ll subtract 2 degrees of freedom. You’ll use this value to look up your critical values in Table A.2.</p> <p class="import-Normal">In our example, <em>N</em><sub>1</sub> = 36, and <em>N</em><sub>2</sub> = 36.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 15.1. Calculating Degrees of Freedom (Pooled Variance <em>t</em>-Test)</h5> </div> <div class="textbox__content"><p class="import-Normal" style="text-align: left;"><b>Formula for degrees of freedom </b><b>(df; </b><strong>pooled variance <em>t</em>-test):</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=ZGYgPSAoTl8xICsgTl8yKSAtIDI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df = (N_1 + N_2) - 2" title="df = (N_1 + N_2) - 2" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=ZGYgPSAoMzYgKyAzNikgLSAyID0gNzA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df = (36 + 36) - 2 = 70" title="df = (36 + 36) - 2 = 70" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">In Table A.2, <em>df</em> = 70 gives us a <em>t</em>-critical value of ±1.994. This gives you what you need for the third part of Step 2 if you are running a pooled variance independent samples <em>t</em>-test (see Figure 15.2):</span></p> <ul><li>Find your critical value(s):<strong><em>t</em><sub>c</sub> = ±1.994.</strong></li> </ul> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-273" style="width: 700px"><img class="wp-image-1235" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-15.2R-1.png" alt="Set-up for our independent samples t-test example shown; t-critical values (-1.994 and 1.994) are shown separating confidence and alpha areas." width="700" height="398" title="" /><div class="wp-caption-text">Figure 15.2. Setup for our independent samples <em>t</em>-test example.</div></div> <p class="import-Normal">For a separate variance <em>t</em>-test, your equation for finding the degrees of freedom is more complicated, often producing a noninteger value. The website <a href="https://www.statskingdom.com/150MeanT2uneq.html" data-url="https://www.statskingdom.com/150MeanT2uneq.html">Stats Kingdom</a> will calculate your degrees of freedom for you.</p> <p class="import-Normal">In our example, <em>df</em> = 69.70. This would round up to 70 when looking up your critical values in Table A.2, so you would have the same critical values, <em>t</em><sub>c</sub> = 1.994.</p> <h4 class="import-Normal">Step 3: Test Statistic Computation</h4> <p class="import-Normal">To calculate your <em>t</em>-obtained value for an independent samples t-test, you first need to conduct an <em>F</em>-test for variance. If you found that your variances were significantly different, then you would run a separate variance <em>t</em>-test. If you found that your variances were not significantly different, then you would run a pooled variance <em>t</em>-test. In this book, the <em>F</em>-test is not shown. Again, when the group sample sizes are equal or very similar in size, variances are likely to be equal (and a pooled variance <em>t</em>-test would be fine to use). However, when sample sizes differ and you want a more conservative estimate to account for each group’s variance, then the separate variance <em>t</em>-test is recommended. Many software programs that calculate independent samples <em>t</em>-tests (e.g., Excel, SPSS) give you results for both pooled and separate variance <em>t</em>-tests that you can choose from.</p> <p class="import-Normal">The steps and formulas for the pooled and separate variance independent samples <em>t</em>-tests are shown here for your reference.</p> <div class="textbox shaded"><h5>Formula 15.2. Calculating pooled variance t-test</h5> <p><strong>Steps and formulas for pooled variance <em>t</em>-test:</strong></p> <ol><li><strong>Calculate variance (pooled, <img src="https://mathjax.library.illinois.edu/latex?latex=c19wXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_p^2" title="s_p^2" class="latex mathjax" />) or variances (separate, <img src="https://mathjax.library.illinois.edu/latex?latex=c18xXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_1^2" title="s_1^2" class="latex mathjax" /> and <img src="https://mathjax.library.illinois.edu/latex?latex=c18yXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_2^2" title="s_2^2" class="latex mathjax" />):</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=c19wXjIgPSBcZnJhY3soU1NfMSArIFNTXzIpfXsoZGZfMSArIGRmXzIpfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_p^2 = \frac{(SS_1 + SS_2)}{(df_1 + df_2)}" title="s_p^2 = \frac{(SS_1 + SS_2)}{(df_1 + df_2)}" class="latex mathjax" /></li> <li><strong>Find your standard error (<img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2}" title="s_{\bar{x}_1 - \bar{x}_2}" class="latex mathjax" />):</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfSA9IFxzcXJ0e1xmcmFje3NfcF4yfXtOXzF9ICsgXGZyYWN7c19wXjJ9e05fMn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{s_p^2}{N_1} + \frac{s_p^2}{N_2}}" title="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{s_p^2}{N_1} + \frac{s_p^2}{N_2}}" class="latex mathjax" />.</li> <li><strong>Solve for t-obtained value:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjeyhcYmFye3h9XzEgLSBcYmFye3h9XzIpfXtzX3tcYmFye3h9XzEgLSBcYmFye3h9XzJ9fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{(\bar{x}_1 - \bar{x}_2)}{s_{\bar{x}_1 - \bar{x}_2}}" title="t = \frac{(\bar{x}_1 - \bar{x}_2)}{s_{\bar{x}_1 - \bar{x}_2}}" class="latex mathjax" /></li> </ol> </div> <div class="textbox shaded"><h5>Formula 15.3. Calculating separate variance t-test</h5> <p><strong>Steps and formulas for separate variance <em>t</em>-test</strong></p> <ol><li><strong>Calculate variance (pooled, <img src="https://mathjax.library.illinois.edu/latex?latex=c19wXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_p^2" title="s_p^2" class="latex mathjax" />) or variances (separate, <img src="https://mathjax.library.illinois.edu/latex?latex=c18xXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_1^2" title="s_1^2" class="latex mathjax" /> and <img src="https://mathjax.library.illinois.edu/latex?latex=c18yXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_2^2" title="s_2^2" class="latex mathjax" />):</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfXNfMV4yID0gXGZyYWN7U1NfMX17ZGZfMX0gXFwgc18yXjIgPSBcZnJhY3tTU18yfXtkZl8yfVxlbmR7Z2F0aGVyZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered}s_1^2 = \frac{SS_1}{df_1} \\ s_2^2 = \frac{SS_2}{df_2}\end{gathered}" title="\begin{gathered}s_1^2 = \frac{SS_1}{df_1} \\ s_2^2 = \frac{SS_2}{df_2}\end{gathered}" class="latex mathjax" /></li> <li><strong>Find your standard error (<img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2}" title="s_{\bar{x}_1 - \bar{x}_2}" class="latex mathjax" />):</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfSA9IFxzcXJ0e1xmcmFje3NfMV4yfXtOXzF9ICsgXGZyYWN7c18yXjJ9e05fMn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{s_1^2}{N_1} + \frac{s_2^2}{N_2}}" title="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{s_1^2}{N_1} + \frac{s_2^2}{N_2}}" class="latex mathjax" /></li> <li><strong>Solve for t-obtained value:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjeyhcYmFye3h9XzEgLSBcYmFye3h9XzIpfXtzX3tcYmFye3h9XzEgLSBcYmFye3h9XzJ9fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{(\bar{x}_1 - \bar{x}_2)}{s_{\bar{x}_1 - \bar{x}_2}}" title="t = \frac{(\bar{x}_1 - \bar{x}_2)}{s_{\bar{x}_1 - \bar{x}_2}}" class="latex mathjax" /></li> </ol> </div> <p class="import-Normal">First, you will calculate variance or variances. For the pooled variance <em>t</em>-test, you are combining information from both samples for a “pooled” variance. For separate variance <em>t</em>-test, you are calculating variance for each sample separately, so you’ll end up with two variance values (one for each sample).</p> <p class="import-Normal">Second, you’ll use these variance estimates to calculate your standard error of the sampling distribution of the difference between means; the notation for this standard error is: <img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2}" title="s_{\bar{x}_1 - \bar{x}_2}" class="latex mathjax" />. For your pooled variance standard error, you are using the pooled variance estimate from the previous step in the equation. For the separate variance standard error, you are using each of the variance values for each sample.</p> <p class="import-Normal">Third, you will look at the difference between your two sample means <img src="https://mathjax.library.illinois.edu/latex?latex=KFxiYXJ7eH1fMSAtIFxiYXJ7eH1fMik&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(\bar{x}_1 - \bar{x}_2)" title="(\bar{x}_1 - \bar{x}_2)" class="latex mathjax" /> and divide by the standard error value you found in the previous step. This will give you your <em>t</em>-obtained value.</p> <p class="import-Normal">Let’s calculate a <em>t</em>-obtained value with both methods using our example:</p> <ul><li class="import-Normal">Group 1 (theater-based group): <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em><sub>1 </sub></span>= 13.78, <em>SS</em><sub>1</sub> = 310, <em>N</em><sub>1</sub> = 36.</li> <li class="import-Normal">Group 2 (sports-based group): <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em><sub>2 </sub></span>= 11.60, <em>SS</em><sub>2</sub> = 272, <em>N</em><sub>2</sub> = 36.</li> </ul> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 15.2. Calculating <em>t</em>-Obtained Value with the Pooled Variance t-Test</h5> </div> <div class="textbox__content"><p><strong>Steps and formulas for pooled variance <em>t</em>-test:</strong></p> <ol><li><strong>Calculate variance (pooled, <img src="https://mathjax.library.illinois.edu/latex?latex=c19wXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_p^2" title="s_p^2" class="latex mathjax" />) or variances (separate, <img src="https://mathjax.library.illinois.edu/latex?latex=c18xXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_1^2" title="s_1^2" class="latex mathjax" /> and <img src="https://mathjax.library.illinois.edu/latex?latex=c18yXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_2^2" title="s_2^2" class="latex mathjax" />)</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=c19wXjIgPSBcZnJhY3soU1NfMSArIFNTXzIpfXsoZGZfMSArIGRmXzIpfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_p^2 = \frac{(SS_1 + SS_2)}{(df_1 + df_2)}" title="s_p^2 = \frac{(SS_1 + SS_2)}{(df_1 + df_2)}" class="latex mathjax" /></li> <li><strong>Find your standard error (<img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2}" title="s_{\bar{x}_1 - \bar{x}_2}" class="latex mathjax" />):</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfSA9IFxzcXJ0e1xmcmFje3NfcF4yfXtOXzF9ICsgXGZyYWN7c19wXjJ9e05fMn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{s_p^2}{N_1} + \frac{s_p^2}{N_2}}" title="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{s_p^2}{N_1} + \frac{s_p^2}{N_2}}" class="latex mathjax" /></li> <li><strong>Solve for <em>t</em>-obtained value:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjeyhcYmFye3h9XzEgLSBcYmFye3h9XzIpfXtzX3tcYmFye3h9XzEgLSBcYmFye3h9XzJ9fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{(\bar{x}_1 - \bar{x}_2)}{s_{\bar{x}_1 - \bar{x}_2}}" title="t = \frac{(\bar{x}_1 - \bar{x}_2)}{s_{\bar{x}_1 - \bar{x}_2}}" class="latex mathjax" /></li> </ol> <p><strong>Our example:&nbsp;</strong></p> <ol><li><strong>Calculate variance (pooled, <img src="https://mathjax.library.illinois.edu/latex?latex=c19wXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_p^2" title="s_p^2" class="latex mathjax" />) or variances (separate, <img src="https://mathjax.library.illinois.edu/latex?latex=c18xXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_1^2" title="s_1^2" class="latex mathjax" /> and <img src="https://mathjax.library.illinois.edu/latex?latex=c18yXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_2^2" title="s_2^2" class="latex mathjax" />):</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=c19wXjIgPSBcZnJhY3soMzEwICsgMjcyKX17KDM1ICsgMzUpfT04LjMx&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_p^2 = \frac{(310 + 272)}{(35 + 35)}=8.31" title="s_p^2 = \frac{(310 + 272)}{(35 + 35)}=8.31" class="latex mathjax" /></li> <li><strong>Find your standard error (<img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2}" title="s_{\bar{x}_1 - \bar{x}_2}" class="latex mathjax" />):</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfSA9IFxzcXJ0e1xmcmFjezguMzF9ezM2fSArIFxmcmFjezguMzF9ezM2fX09MC42OA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{8.31}{36} + \frac{8.31}{36}}=0.68" title="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{8.31}{36} + \frac{8.31}{36}}=0.68" class="latex mathjax" /></li> <li><strong>Solve for t-obtained value:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjeygxMy43OCAtIDExLjYwKX17MC42OH09My4yMQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{(13.78 - 11.60)}{0.68}=3.21" title="t = \frac{(13.78 - 11.60)}{0.68}=3.21" class="latex mathjax" /></li> </ol> </div> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 15.3. Calculating t-Obtained Value with the Separate Variance <em>t</em>-Test</h5> </div> <div class="textbox__content"><p><strong>Steps and formulas for separate variance <em>t</em>-test:</strong></p> <ol><li><strong>Calculate variance (pooled, <img src="https://mathjax.library.illinois.edu/latex?latex=c19wXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_p^2" title="s_p^2" class="latex mathjax" />) or variances (separate, <img src="https://mathjax.library.illinois.edu/latex?latex=c18xXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_1^2" title="s_1^2" class="latex mathjax" /> and <img src="https://mathjax.library.illinois.edu/latex?latex=c18yXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_2^2" title="s_2^2" class="latex mathjax" />):</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfXNfMV4yID0gXGZyYWN7U1NfMX17ZGZfMX0gXFwgc18yXjIgPSBcZnJhY3tTU18yfXtkZl8yfVxlbmR7Z2F0aGVyZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered}s_1^2 = \frac{SS_1}{df_1} \\ s_2^2 = \frac{SS_2}{df_2}\end{gathered}" title="\begin{gathered}s_1^2 = \frac{SS_1}{df_1} \\ s_2^2 = \frac{SS_2}{df_2}\end{gathered}" class="latex mathjax" /></li> <li><strong>Find your standard error (<img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2}" title="s_{\bar{x}_1 - \bar{x}_2}" class="latex mathjax" />):</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfSA9IFxzcXJ0e1xmcmFje3NfMV4yfXtOXzF9ICsgXGZyYWN7c18yXjJ9e05fMn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{s_1^2}{N_1} + \frac{s_2^2}{N_2}}" title="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{s_1^2}{N_1} + \frac{s_2^2}{N_2}}" class="latex mathjax" /></li> <li><strong>Solve for <em>t</em>-obtained value:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjeyhcYmFye3h9XzEgLSBcYmFye3h9XzIpfXtzX3tcYmFye3h9XzEgLSBcYmFye3h9XzJ9fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{(\bar{x}_1 - \bar{x}_2)}{s_{\bar{x}_1 - \bar{x}_2}}" title="t = \frac{(\bar{x}_1 - \bar{x}_2)}{s_{\bar{x}_1 - \bar{x}_2}}" class="latex mathjax" /></li> </ol> <p><strong>Our example:&nbsp;</strong></p> <ol><li><strong>Calculate variance (pooled, <img src="https://mathjax.library.illinois.edu/latex?latex=c19wXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_p^2" title="s_p^2" class="latex mathjax" />) or variances (separate, <img src="https://mathjax.library.illinois.edu/latex?latex=c18xXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_1^2" title="s_1^2" class="latex mathjax" /> and <img src="https://mathjax.library.illinois.edu/latex?latex=c18yXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_2^2" title="s_2^2" class="latex mathjax" />):</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfXNfMV4yID0gXGZyYWN7MzEwfXszNX09OC44NiBcXCBzXzJeMiA9IFxmcmFjezI3Mn17MzV9PTcuNzdcZW5ke2dhdGhlcmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered}s_1^2 = \frac{310}{35}=8.86 \\ s_2^2 = \frac{272}{35}=7.77\end{gathered}" title="\begin{gathered}s_1^2 = \frac{310}{35}=8.86 \\ s_2^2 = \frac{272}{35}=7.77\end{gathered}" class="latex mathjax" /></li> <li><strong>Find your standard error (<img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2}" title="s_{\bar{x}_1 - \bar{x}_2}" class="latex mathjax" />):</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV8xIC0gXGJhcnt4fV8yfSA9IFxzcXJ0e1xmcmFjezguODZ9ezM2fSArIFxmcmFjezcuNzd9ezM2fX09MC42OA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{8.86}{36} + \frac{7.77}{36}}=0.68" title="s_{\bar{x}_1 - \bar{x}_2} = \sqrt{\frac{8.86}{36} + \frac{7.77}{36}}=0.68" class="latex mathjax" /></li> <li><strong>Solve for <em>t-</em>obtained value:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjeygxMy43OCAtIDExLjYwKX17MC42OH09My4yMQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{(13.78 - 11.60)}{0.68}=3.21" title="t = \frac{(13.78 - 11.60)}{0.68}=3.21" class="latex mathjax" /></li> </ol> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">You end up with the same <em>t</em>-obtained value (see Figure 15.3). If you were comparing two samples with different sample sizes, then you would likely see different <em>t</em>-obtained values. The separate variance test will give you a more conservative estimate, adjusting for each sample’s variance.</span></p> <div class="chapter-15:-independent-samples-t-tests"><div class="wp-caption aligncenter" id="attachment_1236" aria-describedby="caption-attachment-1236" style="width: 700px"><img class="wp-image-1236" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-15.3R-1.png" alt="The t-obtained value (t = 3.21) shown on the t-distribution that was set up in Step 2. The obtained values fall in the alpha region of the distribution." width="700" height="398" title="" /><div class="wp-caption-text" id="caption-attachment-1236">Figure 15.3. The <em>t</em>-obtained (<em>t</em> = 3.21) is marked on our <em>t</em> distribution.</div></div> <h4 class="import-Normal">Step 4: Make a Decision</h4> <p class="import-Normal">Based on this example, you would then make a decision to reject or fail to reject the null hypothesis. In both the pooled and separate variance <em>t</em>-tests, you would <strong>reject the null hypothesis</strong>. Your obtained value (regardless of whether you use the pooled or separate variance tests) exceeds the critical value and is in the alpha area. This means that there is a significant difference in communication skills between children who participate in the theater group compared with the sports group in the after-school program.</p> <h4 class="import-Normal">APA-Style Write-up</h4> <p class="import-Normal">For your American Psychological Association [APA]-style write-up, you will include information about the sample means you are comparing, and again, because you’re using the <em>t</em> distribution, you will include information about your degrees of freedom:</p> <p class="import-Normal" style="padding-left: 40px;">An independent samples <em>t</em>-test was conducted to compare communication skills between those who participated in the theater-based activity group and those who participated in the sports-based activity group. There was a significant difference between those who participated in the theater-based activity group (mean [<em>M</em>]&nbsp;= 13.78) and those who participated in the sports-based activity group (<em>M</em> = 11.60), <em>t</em>(70) = 3.21, <em>p</em> &lt; .05.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">This chapter introduced the independent samples <em>t</em>-test. With this type of test, you have a categorical independent variable (with two independent groups) and a continuous dependent variable, and you are looking at mean differences. There are two types of independent samples <em>t</em>-tests, pooled and separate variance <em>t</em>-tests, which allow you to compare two groups regardless of whether they are similar in size or not.</p> </div> 
	</div>
			
				
				
	</div>
<div class="chapter standard " id="chapter-chapter-16-dependent-samples-t-test" title="Chapter 16: Dependent Samples t-test">
	<div class="chapter-title-wrap">
		<p class="chapter-number">36</p>
		<h1 class="chapter-title">Chapter 16: Dependent Samples t-test</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-16:-dependent-samples-t-test"><p class="import-Normal">In Chapters 14 and 15, we saw two types of <em>t</em>-tests: the one-sample <em>t</em>-test and the independent samples <em>t</em>-test. This chapter introduces our final type in this book, which is called the <em>dependent samples </em>t<em>-test</em>. As a reminder, Table 16.1 summarizes the three types of <em>t</em>-tests and the research questions they can answer.</p> <table style="width: 891px;"><caption>Table 16.1. Summary of <em>t</em>-Tests and Research Questions</caption> <thead><tr style="height: 18.4pt;"><th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 172px; vertical-align: middle;" scope="col"><p class="import-Normal"><strong>Inferential Statistical Test</strong></p> </th> <th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 719px; vertical-align: middle;" scope="col"><p class="import-Normal"><strong>Research </strong><strong>Question</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 54.15pt;"><th style="border: 0.5pt solid windowtext; width: 172px; vertical-align: middle;" scope="row"><p class="import-Normal">One-sample <em>t</em>-test</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 719px;"><p class="import-Normal">Allows you to compare one sample mean to a population mean (when population standard deviation is unknown and/or you have a small sample)</p> </td> </tr> <tr class="TableGrid-R" style="height: 18.4pt;"><th style="border: 0.5pt solid windowtext; width: 172px; vertical-align: middle;" scope="row"><p class="import-Normal">Independent samples <em>t</em>-test</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 719px;"><p class="import-Normal">Allows you to compare differences between two independent sample means</p> </td> </tr> <tr class="TableGrid-R" style="height: 17.35pt;"><th style="border: 0.5pt solid windowtext; width: 172px; vertical-align: middle;" scope="row"><p class="import-Normal">Dependent samples <em>t</em>-test</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 719px;"><p class="import-Normal">Allows you to compare differences within two dependent sample means</p> </td> </tr> </tbody> </table> <h2 class="import-Normal">Dependent Samples <em>t</em>-Test</h2> <p class="import-Normal">The <strong><em><span class="glossary-term">dependent samples t-test</span></em></strong>, sometimes referred to as a paired samples <em>t</em>-test, is when you compare two dependent sample means. These samples are dependent because they come from some type of pair: two samples of scores from the same person (i.e., so their second score is dependent on their first) or two samples of scores from the same couple (e.g., a married couple’s score is dependent on each of the partners’ scores). Thus, we want to compare means within two groups or samples that are dependent to see if they are significantly different from each other.</p> <p class="import-Normal">One of the most common applications of this test in social work is using this test for a <em>pre-/posttest research design</em>. These designs include a Time 1 pretest (sometimes called a <em>baseline assessment</em>), participation in some type of intervention, and then a Time 2 posttest (sometimes called a <em>follow-up assessment</em>). You have the same people in both samples (Time 1 sample and Time 2 sample), and you then compare their pairs of scores (e.g., do we see increases in scores from Time 1 to Time 2 for each participant?). Thus, the overall goal of dependent samples t-tests is to examine mean differences <em>within </em>a pair of scores.</p> <h3 class="import-Normal">Example: Evaluating a Parenting Program</h3> <p class="import-Normal">A group of clinical social workers is implementing a parenting program in which participants learn parenting strategies and skills. The social workers are interested in finding out whether parents show a significant change in their parent-child relationship quality because of this program. All participants receive a parenting practices scale that assesses parent-child relationship quality; scores range from 0 (poor quality) to 50 (strong quality). Conducting a dependent samples <em>t</em>-test will allow you to answer the following research question: Do parents who participate in the parenting program show improvements in their parent-child relationship quality from Time 1 (before they participate in the program) to Time 2 (after they participate in the program)?</p> <p class="import-Normal">Research methods courses will highlight an array of other research designs that allow you to keep testing these types of program evaluation questions. However, most program evaluations in the setting of community-based organization start with this pre-/posttest research design.</p> <div class="wp-caption aligncenter" id="attachment_278" aria-describedby="caption-attachment-278" style="width: 514px"><img class="wp-image-278 size-full" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/16.1.jpg" alt="Two caregivers and their child sit together in the grass smiling." width="514" height="342" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/16.1.jpg 514w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/16.1-300x200.jpg 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/16.1-65x43.jpg 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/16.1-225x150.jpg 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/16.1-350x233.jpg 350w" sizes="auto, (max-width: 514px) 100vw, 514px" title="" /><div class="wp-caption-text" id="caption-attachment-278">Figure 16.1. “<a href="https://www.pexels.com/photo/a-happy-family-sitting-on-the-grass-7403357/" target="_blank" rel="noopener" data-url="https://www.pexels.com/photo/a-happy-family-sitting-on-the-grass-7403357/">A Happy Family Sitting on the Grass</a>” by <a href="https://www.pexels.com/@rdne/" target="_blank" rel="noopener" data-url="https://www.pexels.com/@rdne/">RDNE Stock project</a>, via <a href="https://www.pexels.com/" target="_blank" rel="noopener" data-url="https://www.pexels.com/">Pexels</a>, 2021. <a href="https://www.pexels.com/license/" target="_blank" rel="noopener" data-url="https://www.pexels.com/license/">Pexels license</a>.</div></div> <p class="import-Normal">Let’s look at our level of measurement for our variables in this example. For a dependent samples <em>t</em>-test, you will have research questions that have a categorical independent variable, with two dependent groups or samples. Your dependent variable will be continuous (because you will be looking at means). In our example, here is our research question, with variables and their levels of measurement identified:</p> <p class="import-Normal"><strong><em>Research question:</em></strong> Do parents who participate in the parenting program show improvements in their parent-child relationship quality from Time 1 (before they participate in the program) to Time 2 (after they participate in the program)?</p> <ul><li><strong>Independent variable</strong>: Time (the two categories are Time 1 and Time 2)</li> <li><strong>Dependent variable</strong>: Parenting skills (continuous variable with a mean score for each time point)</li> </ul> <p class="import-Normal">With a pre-/posttest design, your outcome depends on time. You may hypothesize that participants at Time 2 (after participation) would have significantly different levels of parenting skills than they did at Time 1 (before participation).</p> <p>Note: If you were to conduct a dependent samples <em>t</em>-test with other paired data, you might have your independent variable be “Couple,” with Partner 1 and Partner 2 as your two categories.</p> <p class="import-Normal">Before we examine the hypothesis test for the dependent samples <em>t</em>-test, let’s look at the data for our example, as shown in Table 16.2. This will highlight a key element of this test, which is to account for the dependence of the data.</p> <table><caption>Table 16.2. Relationship Quality Participant Scores at Time 1 and Time 2</caption> <thead><tr style="height: 51.35pt;"><th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; vertical-align: middle;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Participant</strong></p> </th> <th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; vertical-align: middle;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Relationship Quality at Time 1</strong></p> <p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=eF9B&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x_A" title="x_A" class="latex mathjax" /></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Relationship Quality at Time 2</strong></p> <p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=eF9C&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x_B" title="x_B" class="latex mathjax" /></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 12.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">A</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">36</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">40</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">B</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">40</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">44</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">C</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">37</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">36</p> </td> </tr> <tr class="TableGrid-R" style="height: 12.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">D</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">38</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">45</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">E</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">33</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">37</p> </td> </tr> <tr class="TableGrid-R" style="height: 12.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">F</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">39</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">G</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">40</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">41</p> </td> </tr> <tr class="TableGrid-R" style="height: 12.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">H</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">49</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">46</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">I</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">37</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">40</p> </td> </tr> <tr class="TableGrid-R" style="height: 12.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">J</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">38</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">41</p> </td> </tr> </tbody> </table> <p class="import-Normal">For each participant (i.e., each row), you have two scores: their pretest score or score at Time 1 (notated by <img src="https://mathjax.library.illinois.edu/latex?latex=eF9B&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x_A" title="x_A" class="latex mathjax" />) and their posttest score or score at Time 2 (notated by <img src="https://mathjax.library.illinois.edu/latex?latex=eF9C&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x_B" title="x_B" class="latex mathjax" />). We will be looking at difference scores (D) within each pair: <img src="https://mathjax.library.illinois.edu/latex?latex=RCA9IHhfQSAtIHhfQg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="D = x_A - x_B" title="D = x_A - x_B" class="latex mathjax" /></p> <p class="import-Normal">These data are dependent, in that you have paired data: The Time 1 and Time 2 scores that you are comparing are from within the same person. For example, Participant A scored 36 at Time 1 and 40 at Time 2. Participant F had a score of 25 at Time 1 and 39 at Time 2. These differences within a person are what we are interested in testing. So, the inferences related to differences are for the population mean at Time 1 (<img src="https://mathjax.library.illinois.edu/latex?latex=XG11X0E&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu_A" title="\mu_A" class="latex mathjax" />) and Time 2 (<img src="https://mathjax.library.illinois.edu/latex?latex=XG11X0I&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu_B" title="\mu_B" class="latex mathjax" />). We’ll be looking at difference scores within a person from Time 1 to Time 2 (<img src="https://mathjax.library.illinois.edu/latex?latex=eF9BIC0geF9C&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x_A - x_B" title="x_A - x_B" class="latex mathjax" />) to make inferences about <img src="https://mathjax.library.illinois.edu/latex?latex=XG11X0EgLSBcbXVfQg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu_A - \mu_B" title="\mu_A - \mu_B" class="latex mathjax" />. We notate the dependence of these samples by using the subscript letters “A” and “B” to identify our two groups; notice that we are using letters instead of numbers to identify our groups. We will be testing a sampling distribution of (<img src="https://mathjax.library.illinois.edu/latex?latex=XG11X0EgLSBcbXVfQg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu_A - \mu_B" title="\mu_A - \mu_B" class="latex mathjax" /> or notated as mu “sub-D” for difference, <img src="https://mathjax.library.illinois.edu/latex?latex=XG11X0Q&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\mu_D" title="\mu_D" class="latex mathjax" />) and testing whether there is a significant difference within individuals (see Figure 16.2).</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-278" style="width: 638px"><img class="wp-image-262" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/076_depend-1.png" alt="A sample mean (x-bar subscript A) comes from population mean (mu subscript A); another sample mean (x-bar subscript B) comes from population mean (mu subscript B); these paired data come from the same person or pair." width="638" height="471" title="" /><div class="wp-caption-text">Figure 16.2. We will take samples from paired data (A and B), both of which come from their own population.</div></div> <h4 class="import-Normal">Step 1: Hypothesis Pair</h4> <p class="import-Normal">We are comparing two dependent sample means, both of which came from their own population, so we are making inferences about 𝜇<sub>A</sub> and 𝜇<sub>B</sub> and referring to them in our hypothesis pair. Because our means are dependent, we are interested in the difference within each pair, so we will be referring to difference scores (<em>D</em>) throughout the hypothesis test. So, you’ll have options for writing your hypothesis pair.</p> <p class="import-Normal">Our null hypothesis states that the difference between the paired sample means is equal to 0. The two samples (from a pair) came from a population where the mean difference was 0. You’ll compare this hypothesis to the alternative hypothesis, which would state that the difference between the paired sample means was not equal to 0. The paired sample came from a population where the mean difference was not 0. Your hypothesis pair for dependent samples <em>t-</em>test will always look like this:</p> <ul><li>Null hypothesis: <em>μ</em><sub>A</sub> – <em>μ</em><sub>B </sub>= 0.</li> <li>Alternative hypothesis: <em>μ</em><sub>A</sub> – <em>μ</em><sub>B</sub> ≠ 0.</li> </ul> <p class="import-Normal">This can also be written as follows:</p> <ul><li><em>H</em><sub>0</sub>:&nbsp;<em>μ</em><sub>A</sub> – <em>μ</em><sub>B </sub>= 0.</li> <li><em>H</em><sub>a</sub>:&nbsp;<em>μ</em><sub>A</sub> – <em>μ</em><sub>B</sub> ≠ 0.</li> </ul> <p class="import-Normal">The other ways you can write your hypothesis pairs refer to the difference scores with “<em>D</em>” as the notation:</p> <ul><li>Null hypothesis: <em>μ<sub>D</sub></em> = 0.</li> <li>Alternative hypothesis: <em>μ</em><sub>D</sub> ≠ 0.</li> </ul> <p class="import-Normal">This can also be written as follows:</p> <ul><li><em>H</em><sub>0</sub>: <em>μ</em><sub>D</sub> = 0.</li> <li><em>H</em><sub>a</sub>: <em>μ</em><sub>D</sub> ≠ 0.</li> </ul> <h4 class="import-Normal">Step 2: Setup for the Test</h4> <ul><li>What inferential test are you using? <strong>Dependent samples <em>t</em>-test</strong> <ul><li>Reasons for selecting this test: <ul><li><strong>Your research question involves testing differences within paired sample or dependent means (i.e., means from the same person).</strong></li> <li><strong>You have a categorical independent variable with two groups (Time 1 and Time 2) and a continuous dependent variable (mean levels of parent-child relationship quality).</strong></li> </ul> </li> </ul> </li> <li>Set your confidence/alpha: <strong>Confidence = .95, and alpha = .05.&nbsp;</strong></li> </ul> <p class="import-Normal">Finding your degrees of freedom will then set you up for determining your critical values. You will take <em>N,</em> or your total sample size, and subtract 1 (<img src="https://mathjax.library.illinois.edu/latex?latex=Ti0x&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N-1" title="N-1" class="latex mathjax" />). This is the number of pairs of scores in your data. In our example, we had 10 pairs of scores, so we will take 10 – 1 to find our degrees of freedom.</p> <div class="textbox shaded"><h5>Formula 16.1. Calculating degrees of freedom (dependent samples t-test)</h5> <p class="import-Normal" style="text-align: left;"><strong>Formula for degrees of freedom (df) </strong><strong>for dependent samples <em>t</em>-test:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=ZGYgPSBOIOKAkyAx&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df = N – 1" title="df = N – 1" class="latex mathjax" /></p> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 16.1. Calculating Degrees of Freedom for Dependent Samples t-Test</h5> </div> <div class="textbox__content"><p class="import-Normal" style="text-align: left;"><strong>Formula for degrees of freedom (df) </strong><strong>for dependent samples <em>t</em>-test:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=ZGYgPSBOIOKAkyAx&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df = N – 1" title="df = N – 1" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=ZGYgPSAxMCAtIDEgPSA5&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df = 10 - 1 = 9" title="df = 10 - 1 = 9" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">In Table A.2, <em>df</em> = 9 gives us a <em>t</em>-critical value of ±2.262. This gives what we need for the third part of our Step 2:</span></p> <ul><li>Find your critical value(s): <strong><em>t</em><sub>c</sub> = ±2.262</strong> (see Figure 16.3).</li> </ul> </div> <div class="wp-caption aligncenter" id="attachment_1238" aria-describedby="caption-attachment-1238" style="width: 700px"><img class="wp-image-1238" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-16.3R-1.png" alt="t-distribution shown with t-critical values labeled (-2.262 and 2.262) and separating the alpha and confidence areas." width="700" height="399" title="" /><div class="wp-caption-text" id="caption-attachment-1238">Figure 16.3. Set-up for dependent samples <em>t</em>-test.</div></div> <div class="chapter-16:-dependent-samples-t-test"><h4 class="import-Normal">Step 3: Test Statistic Computation</h4> <p class="import-Normal">To find our <em>t</em>-obtained value for a dependent samples <em>t</em>-test, we will again focus on the differences within pairs: <img src="https://mathjax.library.illinois.edu/latex?latex=RCA9IHhfQSAtIHhfQg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="D = x_A - x_B" title="D = x_A - x_B" class="latex mathjax" />.</p> <div class="textbox shaded"><h5>Formula 16.2. Calculating t-obtained value for dependent samples t-test</h5> <p><strong>Steps and formulas for calculating dependent samples <em>t</em>-test:</strong></p> <ol><li><strong>Calculate average differences between paired scores:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fV9EID0gXGZyYWN7XHN1bSBEfXtOfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}_D = \frac{\sum D}{N}" title="\bar{x}_D = \frac{\sum D}{N}" class="latex mathjax" /> also written as:&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcntEfSA9IFxmcmFje1xzdW0gRH17Tn0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{D} = \frac{\sum D}{N}" title="\bar{D} = \frac{\sum D}{N}" class="latex mathjax" /></li> <li><strong>Find your standard error:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV9EfSA9IFxmcmFje3NfRH17XHNxcnR7Tn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_D} = \frac{s_D}{\sqrt{N}}" title="s_{\bar{x}_D} = \frac{s_D}{\sqrt{N}}" class="latex mathjax" /> also written as: <img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcntEfX0gPSBcZnJhY3tzX0R9e1xzcXJ0e059fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{D}} = \frac{s_D}{\sqrt{N}}" title="s_{\bar{D}} = \frac{s_D}{\sqrt{N}}" class="latex mathjax" /></li> <li><strong>Solve for t-obtained value:</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFje1xiYXJ7eH1fRH17c197XGJhcnt4fV9EfX0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{\bar{x}_D}{s_{\bar{x}_D}}" title="t = \frac{\bar{x}_D}{s_{\bar{x}_D}}" class="latex mathjax" /> also written as: <img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFje1xiYXJ7RH19e3Nfe1xiYXJ7RH19fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{\bar{D}}{s_{\bar{D}}}" title="t = \frac{\bar{D}}{s_{\bar{D}}}" class="latex mathjax" /></li> </ol> </div> <p><span style="text-align: initial; font-size: 14pt;">Let’s pull our data table here and add a few columns to help us get the values we need for these equations, as well as a summary row at the bottom (see Table 16.3). The fourth column includes the difference score for each pair. Because we are interested in differences within a pair of scores (i.e., difference between Time 1 and Time 2 score for each participant), we will first calculate these scores for each participant. For example, Participant A scored 36 (Time 1) and then 40 (Time 2); this difference score is −4. The bottom row of the “Difference Score” column adds all of the difference scores; we’ll use that value in calculating the average differences between paired scores. Let’s do that calculation first; we will return to the fifth column after we calculate the average differences between paired scores.</span></p> <table style="height: 660px; width: 1054px;"><caption>Table 16.3. Difference Score and Other Summary Information for Relationship Quality Example</caption> <thead><tr style="height: 51.35pt;"><th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; height: 89px; width: 81.1932px; vertical-align: middle;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Participant</strong></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; height: 89px; width: 202.401px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Relationship Quality at Time 1</strong></p> <p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=eF9B&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x_A" title="x_A" class="latex mathjax" /></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; height: 89px; width: 201.57px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Relationship Quality at Time 2</strong></p> <p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=eF9C&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x_B" title="x_B" class="latex mathjax" /></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; height: 89px; width: 94.4318px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Difference</strong> <strong>Score</strong></p> <p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=RCA9IHhfQSAtIHhfQg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="D = x_A - x_B" title="D = x_A - x_B" class="latex mathjax" /></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; height: 89px; width: 144.837px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Difference </strong><strong>Score Minus Average </strong><strong>of Differences </strong><strong>Squared</strong></p> <p style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=KEQgLSBcYmFye0R9KV4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(D - \bar{D})^2" title="(D - \bar{D})^2" class="latex mathjax" /></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 12.45pt;"><th style="border: 0.5pt solid windowtext; height: 35px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">A</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 202.401px;"><p class="import-Normal" style="text-align: center;">36</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 201.57px;"><p class="import-Normal" style="text-align: center;">40</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;"><span style="text-align: initial; font-size: 14pt;">−</span>4</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 144.837px;"><p class="import-Normal" style="text-align: center;">0.16</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">B</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 202.401px;"><p class="import-Normal" style="text-align: center;">40</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 201.57px;"><p class="import-Normal" style="text-align: center;">44</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;"><span style="text-align: initial; font-size: 14pt;">−</span>4</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 144.837px;"><p class="import-Normal" style="text-align: center;">0.16</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">C</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 202.401px;"><p class="import-Normal" style="text-align: center;">37</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 201.57px;"><p class="import-Normal" style="text-align: center;">36</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;">1</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 144.837px;"><p class="import-Normal" style="text-align: center;">21.16</p> </td> </tr> <tr class="TableGrid-R" style="height: 12.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">D</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 202.401px;"><p class="import-Normal" style="text-align: center;">38</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 201.57px;"><p class="import-Normal" style="text-align: center;">45</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;"><span style="text-align: initial; font-size: 14pt;">−</span>7</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 144.837px;"><p class="import-Normal" style="text-align: center;">11.56</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">E</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 202.401px;"><p class="import-Normal" style="text-align: center;">33</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 201.57px;"><p class="import-Normal" style="text-align: center;">37</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;"><span style="text-align: initial; font-size: 14pt;">−</span>4</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 144.837px;"><p class="import-Normal" style="text-align: center;">0.16</p> </td> </tr> <tr class="TableGrid-R" style="height: 12.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">F</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 202.401px;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 201.57px;"><p class="import-Normal" style="text-align: center;">39</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;"><span style="text-align: initial; font-size: 14pt;">−</span>14</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 144.837px;"><p class="import-Normal" style="text-align: center;">108.16</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">G</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 202.401px;"><p class="import-Normal" style="text-align: center;">40</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 201.57px;"><p class="import-Normal" style="text-align: center;">41</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;"><span style="text-align: initial; font-size: 14pt;">−</span>1</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 144.837px;"><p class="import-Normal" style="text-align: center;">6.76</p> </td> </tr> <tr class="TableGrid-R" style="height: 12.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">H</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 202.401px;"><p class="import-Normal" style="text-align: center;">49</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 201.57px;"><p class="import-Normal" style="text-align: center;">46</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;">3</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 144.837px;"><p class="import-Normal" style="text-align: center;">43.56</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">I</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 202.401px;"><p class="import-Normal" style="text-align: center;">37</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 201.57px;"><p class="import-Normal" style="text-align: center;">40</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;"><span style="text-align: initial; font-size: 14pt;">−</span>3</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 144.837px;"><p class="import-Normal" style="text-align: center;">0.36</p> </td> </tr> <tr class="TableGrid-R" style="height: 12.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">J</p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 202.401px;"><p class="import-Normal" style="text-align: center;">38</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 201.57px;"><p class="import-Normal" style="text-align: center;">41</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;"><span style="text-align: initial; font-size: 14pt;">−</span>3</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 144.837px;"><p class="import-Normal" style="text-align: center;">0.36</p> </td> </tr> <tr class="TableGrid-R" style="height: 12.45pt;"><th class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; height: 89px; width: 81.1932px;" scope="row"><p class="import-Normal" style="text-align: center;">N = 10</p> </th> <td class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; height: 89px; width: 202.401px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fV9BPTM3LjM&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}_A=37.3" title="\bar{x}_A=37.3" class="latex mathjax" /></td> <td class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; height: 89px; width: 201.57px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fV9CPTQwLjk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}_B=40.9" title="\bar{x}_B=40.9" class="latex mathjax" /></td> <td class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; height: 89px; width: 94.4318px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSBEPSAtMzY&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum D= -36" title="\sum D= -36" class="latex mathjax" /></p> </td> <td class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; height: 89px; width: 144.837px;"><p style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSAoRCAtIFxiYXJ7RH0pXjIgPSAxOTIuNA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum (D - \bar{D})^2 = 192.4" title="\sum (D - \bar{D})^2 = 192.4" class="latex mathjax" /></p> </td> </tr> </tbody> </table> <p class="import-Normal">So, first we will calculate the average difference (<img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcntEfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{D}" title="\bar{D}" class="latex mathjax" />) within participants on levels of parent-child relationship quality. We use the sum of difference scores (pulled from the bottom row of fourth column of the table, which is <span style="text-align: initial; font-size: 14pt;">−</span>36) and divide by the number of participants (or pairs of scores, which is 10) that we have. This tells that on average, there was a difference within participants of <span style="text-align: initial; font-size: 14pt;">−</span>3.6 points on the parent-child relationship quality assessment from Time 1 to Time 2. We will use this value to find our final column of Table 16.3, which will be used in our standard error calculation. We will also use this value in our third equation of this step to solve for the <em>t</em>-obtained value.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 16.2. Calculating the Average Difference</h5> </div> <div class="textbox__content"><p><strong>Formula for average difference:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fV9EID0gXGZyYWN7XHN1bSBEfXtOfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}_D = \frac{\sum D}{N}" title="\bar{x}_D = \frac{\sum D}{N}" class="latex mathjax" /></p> <p>also written as:</p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcntEfSA9IFxmcmFje1xzdW0gRH17Tn0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{D} = \frac{\sum D}{N}" title="\bar{D} = \frac{\sum D}{N}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fV9EID0gXGZyYWN7LTM2fXsxMH09LTMuNg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}_D = \frac{-36}{10}=-3.6" title="\bar{x}_D = \frac{-36}{10}=-3.6" class="latex mathjax" /></p> <p>also written as:</p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcntEfSA9IFxmcmFjey0zNn17MTB9PS0zLjY&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{D} = \frac{-36}{10}=-3.6" title="\bar{D} = \frac{-36}{10}=-3.6" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">Now that we know the average difference score was −3.6, we can use this in our calculation to find the standard error of the difference scores. The fifth column of the table takes each participant’s difference score, minus the average of our difference scores (−3.6, which we just calculated in our first step), squared, in the equation for the standard error. For example, </span><span style="text-align: initial; font-size: 14pt;">Participant A had a difference score of −4, so we take <img src="https://mathjax.library.illinois.edu/latex?latex=LTQg4oCTICgtMy42KSA9IC0wLjQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="-4 – (-3.6) = -0.4" title="-4 – (-3.6) = -0.4" class="latex mathjax" />, and then we square it to get a value of 0.16. We then do this for each of our participants to fill out that final column.&nbsp;</span></p> </div> <p class="import-Normal">Again, along the bottom of the table is a summary row, where we have average scores at Time 1 and Time 2, as well as sums of our difference scores and our squared difference scores.</p> <p><span style="text-align: initial; font-size: 14pt;">Next, we will find the standard error of the difference scores. Before we can solve for the standard error of the difference scores, we have to calculate the standard deviation of the difference scores. If this is not provided to you, here’s how you would find this value: You would first take the variance (the sum of difference scores minus average difference score squared and divided by <em>N</em> – 1). Then, to find the standard deviation, take the square root of this value.</span></p> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 16.3. Calculating Standard Deviation of Difference Scores</h5> </div> <div class="textbox__content"><p><strong>Formula for standard deviation of difference scores:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=c19EID0gXHNxcnR7XGxlZnQoXGZyYWN7XHN1bSBEXjJ9e04tMX1ccmlnaHQpfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_D = \sqrt{\left(\frac{\sum D^2}{N-1}\right)}" title="s_D = \sqrt{\left(\frac{\sum D^2}{N-1}\right)}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=c19EID0gXHNxcnR7XGxlZnQoXGZyYWN7MTkyLjR9ezl9XHJpZ2h0KX09NC42Mg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_D = \sqrt{\left(\frac{192.4}{9}\right)}=4.62" title="s_D = \sqrt{\left(\frac{192.4}{9}\right)}=4.62" class="latex mathjax" /></p> </div> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 16.4. Calculating Standard Error of Difference Scores</h5> </div> <div class="textbox__content"><p><strong>Formula for standard error of difference scores:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV9EfSA9IFxmcmFje3NfRH17XHNxcnR7Tn19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_D} = \frac{s_D}{\sqrt{N}}" title="s_{\bar{x}_D} = \frac{s_D}{\sqrt{N}}" class="latex mathjax" /></p> <p>also written as:</p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcntEfX0gPSBcZnJhY3tzX0R9e1xzcXJ0e059fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{D}} = \frac{s_D}{\sqrt{N}}" title="s_{\bar{D}} = \frac{s_D}{\sqrt{N}}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcnt4fV9EfSA9IFxmcmFjezQuNjJ9e1xzcXJ0ezEwfX09MS40Ng&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{x}_D} = \frac{4.62}{\sqrt{10}}=1.46" title="s_{\bar{x}_D} = \frac{4.62}{\sqrt{10}}=1.46" class="latex mathjax" /></p> <p style="text-align: left;">also written as:</p> <p style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=c197XGJhcntEfX0gPSBcZnJhY3s0LjYyfXtcc3FydHsxMH19PTEuNDY&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="s_{\bar{D}} = \frac{4.62}{\sqrt{10}}=1.46" title="s_{\bar{D}} = \frac{4.62}{\sqrt{10}}=1.46" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">Then, to find the standard error, you’ll take the standard deviation of the difference scores (4.62) and divide by the square root of <em>N</em>, which in this case is 10. So, your standard error of the difference scores is 1.46.</span></p> <div class="chapter-16:-dependent-samples-t-test"><p class="import-Normal">Finally, you have the information you need to solve for your <em>t</em>-obtained value. You will take your average difference score and divide it by your standard error of the difference scores.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 16.5. Calculating <em>t</em>-Obtained Value</h5> </div> <div class="textbox__content"><p><strong>Formula for t-obtained value:&nbsp;</strong></p> <p style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFje1xiYXJ7eH1fRH17c197XGJhcnt4fV9EfX0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{\bar{x}_D}{s_{\bar{x}_D}}" title="t = \frac{\bar{x}_D}{s_{\bar{x}_D}}" class="latex mathjax" /></p> <p style="text-align: left;">also written as:</p> <p style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFje1xiYXJ7RH19e3Nfe1xiYXJ7RH19fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{\bar{D}}{s_{\bar{D}}}" title="t = \frac{\bar{D}}{s_{\bar{D}}}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjey0zLjZ9ezEuNDZ9ID0gLTIuNDc&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{-3.6}{1.46} = -2.47" title="t = \frac{-3.6}{1.46} = -2.47" class="latex mathjax" /></p> <p style="text-align: left;">also written as:</p> <p style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=dCA9IFxmcmFjey0zLjZ9ezEuNDZ9PSAtMi40Nw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="t = \frac{-3.6}{1.46}= -2.47" title="t = \frac{-3.6}{1.46}= -2.47" class="latex mathjax" /></p> </div> </div> <p class="import-Normal">From this equation, your <em>t</em>-obtained value is −2.47 (see Figure 16.4).</p> <div class="wp-caption aligncenter" id="attachment_1240" aria-describedby="caption-attachment-1240" style="width: 700px"><img class="wp-image-1240" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-16.4R-1-1.png" alt="The t-obtained value of -2.47 is shown on our t-distribution that was set-up in Step 2. The obtained value falls in the alpha area of the distribution." width="700" height="399" title="" /><div class="wp-caption-text" id="caption-attachment-1240">Figure 16.4. Our <em>t</em>-obtained value is shown on our <em>t</em> distribution.</div></div> <h4 class="import-Normal">Step 4: Make a Decision</h4> <p class="import-Normal">Based on this example, you would then make a decision to reject or fail to reject the null hypothesis. Your <em>t</em>-obtained value falls in the alpha area, so you would <strong>reject the null hypothesis</strong>.&nbsp;Your obtained value exceeds the critical value and is in the alpha area. This means that there is a significant difference within participants from Time 1 to Time 2 on levels of parent-child relationship quality.</p> <p class="import-Normal">Often you are looking at differences within people from Time 1 to Time 2. If this is the case, keep the following in mind:</p> <ul><li><strong>Negative <em>t</em>-obtained value</strong>: This means that Time 2 has higher scores than Time 1. In our example, we would want to see higher scores at Time 2 because this would mean they showed improvements in their relationship quality from Time 1 to Time 2.</li> <li><strong>Positive <em>t</em>-obtained value</strong>: This means that Time 2 has lower scores than Time 1. You might want to see this if you’re measuring an adverse outcome, such as depressive symptoms. You’d want to see declines in scores at Time 2 from Time 1, so a positive, significant, <em>t</em>-obtained value would help you interpret that as an impactful program.</li> </ul> <h4 class="import-Normal">APA-Style Write-up</h4> <p class="import-Normal">The American Psychological Association [APA]-style write-up for a dependent samples <em>t</em>-test follows; you’ll report your average levels at Time 1 and Time 2, even though you don’t use these means in any of the equations. However, this descriptive information can still be helpful in understanding your sample.</p> <p class="import-Normal" style="padding-left: 40px;">A dependent samples <em>t</em>-test was conducted to compare levels of parent-child relationship quality from pretest (Time 1) to posttest (Time 2) within clients who participated in a parenting program. Based on a sample of 10 clients, individuals showed significantly higher relationship quality at posttest (mean [<em>M</em>] = 40.9) than at pretest (<em>M</em> = 37.3), <em>t</em>(9) = −2.47, <em>p</em> &lt; .05. These findings suggest that the parenting program was effective in improving parent-child relationship quality.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">This chapter introduced the dependent samples <em>t</em>-test, which examines difference scores within paired data (e.g., Time 1 and Time 2 scores from the same person). This is a common <em>t</em>-test when social workers use a pre-/posttest research design to evaluate a program or intervention.</p> </div> 
	</div>
			
				
				
	</div>
<div class="chapter standard " id="chapter-chapter-17-one-way-analysis-of-variance-anova" title="Chapter 17: (One-Way) Analysis of Variance (ANOVA)">
	<div class="chapter-title-wrap">
		<p class="chapter-number">37</p>
		<h1 class="chapter-title">Chapter 17: (One-Way) Analysis of Variance (ANOVA)</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-17:-(one-way)-analysis-of-variance-(anova)"><p class="import-Normal">Our final type of inferential statistic that looks at differences in this book is the <span style="text-decoration: underline;">an</span>alysis <span style="text-decoration: underline;">o</span>f <span style="text-decoration: underline;">va</span>riance, or ANOVA. We will be focusing on the one-way ANOVA, which examines differences between the means of three or more groups or categories (of one independent variable) and one dependent variable. More advanced statistics books will highlight other types of ANOVAs, where you can have multiple independent and/or dependent variables.</p> <h2 class="import-Normal">One-Way ANOVA</h2> <p class="import-Normal">The <strong><em>one-way ANOVA</em></strong> examines differences between three or more categories of one independent variable on a continuous dependent variable. Research questions are very similar to those of an independent variable t-test (Chapter 15); the key difference is the number of levels, or categories of your independent variable. If you have two levels, you can use the independent samples t-test; if you have three or more levels, then you can use the one-way ANOVA.</p> <h3 class="import-Normal">Example: Comparing Conflict Resolution Skills of Participants in Restorative Justice Programs</h3> <p class="import-Normal">Let’s say you are interested in comparing levels of conflict resolution skills among youth who participate in one of three types of evidence-based restorative justice programs (for more information on restorative justice programs, please see Kimbrell et al. [2022] for a review). Your team collects youth self-reported conflict resolution skills after they participate in the program. You end up with a mean for each of the three groups: <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em><sub>1</sub>,</span>&nbsp;<span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em><sub>2</sub>, </span>and <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em><sub>3</sub></span>. Because you have three levels in this example (i.e., three independent programs), you would conduct an ANOVA.</p> <div class="wp-caption aligncenter" id="attachment_284" aria-describedby="caption-attachment-284" style="width: 612px"><img class="wp-image-284 size-full" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/17.1.jpg" alt="One person is showing another person something in a book." width="612" height="408" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/17.1.jpg 612w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/17.1-300x200.jpg 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/17.1-65x43.jpg 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/17.1-225x150.jpg 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/17.1-350x233.jpg 350w" sizes="auto, (max-width: 612px) 100vw, 612px" title="" /><div class="wp-caption-text" id="caption-attachment-284">Figure 17.1. “<a href="https://www.pexels.com/photo/man-showing-a-document-on-a-woman-7963825/" target="_blank" rel="noopener" data-url="https://www.pexels.com/photo/man-showing-a-document-on-a-woman-7963825/">Man Showing a Document on a Woman</a>” by <a href="https://www.pexels.com/@felicity-tai/" target="_blank" rel="noopener" data-url="https://www.pexels.com/@felicity-tai/">Felicity Tai</a>, via <a href="https://www.pexels.com/" target="_blank" rel="noopener" data-url="https://www.pexels.com/">Pexels</a>, 2021. <a href="https://www.pexels.com/license/" target="_blank" rel="noopener" data-url="https://www.pexels.com/license/">Pexels license</a>.</div></div> <p class="import-Normal">In this example, you now have three comparisons: Program 1 to Program 2, Program 1 to Program 3, and Program 2 to Program 3. You might be wondering why you can’t just run multiple <em>t</em>-tests for each of these comparisons. However, with every <em>t</em>-test, you would increase the risk for a Type I error (see Chapter 13). Across comparisons, you would increase your overall chance of error (also called <em>experiment-wise alpha</em>, which is the probability of making a Type I error across multiple tests). For example, if you had 95% confidence level set for each test, you would then have a 5% chance of error for each comparison:</p> <ol><li>Comparing Program 1 to Program 2: 5% error</li> <li>Comparing Program 1 to Program 3: 5% error</li> <li>Comparing Program 2 to Program 3: 5% error</li> </ol> <p>This would result in a total of 15% error across the three comparisons.</p> <p class="import-Normal">Luckily, ANOVA and additional tests conducted after the initial ANOVA (e.g., <em>post hoc tests</em>), allow you to make these comparisons, while keeping your alpha level at the specified level (e.g., 0.05, or 5%), thus controlling your experiment-wise alpha.</p> <p class="import-Normal">The logic of the ANOVA test examines the total variability within a data set and then partitions the sources of variability: (1) between each group, and (2) within each group. <em>Between-group variability </em>examines differences between the group means. This measures how much each group mean differs from the overall mean (across all groups). <em>Within-group variability</em> examines variability within each group; this variability accounts for the error that each group contributes. Each group is examined separately for the amount of within-group variability it contributes; if there are large variance estimates, there is more room for error, and it makes it harder to detect between group differences because there is more variability within groups.</p> <p class="import-Normal">Our obtained value is <em>F</em>, which is the ratio of between-group to within-group variability.</p> <p class="import-Normal" style="margin-left: 36pt;"><img src="https://mathjax.library.illinois.edu/latex?latex=RiA9IFxmcmFje3ZhcmlhbmNlXDogYmV0d2Vlblw6IGdyb3Vwc317dmFyaWFuY2VcOiB3aXRoaW5cOiBncm91cHN9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="F = \frac{variance\: between\: groups}{variance\: within\: groups}" title="F = \frac{variance\: between\: groups}{variance\: within\: groups}" class="latex mathjax" /></p> <p class="import-Normal">If the ratio is large, then there is more variability between groups, which indicates more of an effect or difference between groups. If the ratio is small, then there is less of a difference, and there is more room for error within a group. If the ratio is 1, then the groups are roughly the same (i.e., the variance between and variance within groups are roughly the same; any differences you can see are likely due to chance).</p> <p class="import-Normal">Because <em>F</em> values are a ratio, they are always positive. The <em>F</em> value that we will calculate in an ANOVA hypothesis test will be plotted using the <em>F distribution</em>, which is scaled by variance rather than standard deviation like the <em>t </em>distribution and standard normal distribution. Thus, the distribution starts at 0, peaks at 1, and then extends a tail for positive critical and obtained values. Like the <em>t</em> distribution, the <em>F</em> distribution is also a family of distributions, where the characteristics and shape vary according to degrees of freedom (see Figure 17.2).</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-284" style="width: 700px"><img class="wp-image-265" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/079_Fdistribution-1.png" alt="A F distribution is shown, which starts at 0, peaks around 1, and then tapers into a long tail region." width="700" height="326" title="" /><div class="wp-caption-text">Figure 17.2. The <em>F</em> distribution.</div></div> <p class="import-Normal">Because we are partitioning the variability for ANOVA, we will have two sources of degrees of freedom: degrees of freedom within groups and degrees of freedom between groups. We will use these two sources of degrees of freedom when looking up our positive critical value (see Table A.3 in the Appendix).</p> <div class="textbox shaded"><h4>Formula 17.1. Calculating degrees of freedom (df) for between and within groups</h4> <p><strong>Formula for degrees of freedom (d</strong><strong>f) between groups:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=ayDigJMgMQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="k – 1" title="k – 1" class="latex mathjax" /></p> <p><strong>Formula for degrees of freedom (df) within groups:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=Tl90wqDigJMgaw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N_t&nbsp;– k" title="N_t&nbsp;– k" class="latex mathjax" /></p> </div> <p><span style="text-align: initial; font-size: 14pt;">To find degrees of freedom between groups, you will take <em>k</em> (which is the number of levels or groups you are examining) and subtract 1. To find degrees of freedom within groups, you will take your total <em>N</em> (across all groups, notated as <em>N</em></span><sub style="text-align: initial;">t</sub><span style="text-align: initial; font-size: 14pt;">) and subtract <em>k</em>.</span></p> <p class="import-Normal">Let’s continue our example comparing conflict resolution skills among participants in one of three restorative justice programs.</p> <h4 class="import-Normal">Step 1: Hypothesis Pair</h4> <p class="import-Normal">Your hypothesis pair for a one-way ANOVA will include a null hypothesis where all your group means are equal. Your ratios of between-to-within variability are expected to be similar. You will compare that hypothesis to the alternative hypothesis, where your group means are not equal. This hypothesis suggests that your sample means differ by more than just sampling error; there is a meaningful difference between your group means.</p> <p class="import-Normal">In our example, we are comparing three programs, so our hypothesis pair will look like this:</p> <ul><li>Null hypothesis: <em>μ</em><sub>1</sub> = <em>μ</em><sub>2</sub> = <em>μ</em><sub>3</sub>.</li> <li>Alternative hypothesis: <em>μ</em><sub>1</sub> ≠ <em>μ</em><sub>2</sub> ≠ <em>μ</em><sub>3</sub>.</li> </ul> <p class="import-Normal">You can also notate your hypotheses as follows:</p> <ul><li><em>H</em><sub>0</sub>: <em>μ</em><sub>1</sub> = <em>μ</em><sub>2</sub> = <em>μ</em><sub>3</sub>.</li> <li><em>H</em><sub>a</sub>: <em>μ<sub>1</sub> ≠ μ<sub>2</sub> ≠ μ<sub>3</sub>.</em></li> </ul> <p class="import-Normal">These hypothesis statements should remind you of the independent samples <em>t</em>-test statements; they just add the third category or level to the statements because you are now comparing three levels.</p> <h4 class="import-Normal">Step 2: Setup for the Test</h4> <ul><li>What inferential test are you using? <strong>One-way ANOVA</strong> <ul><li>Reasons for selecting this test: <ul><li><strong>Your research question involves testing mean differences between three levels (i.e., three programs).</strong></li> <li><strong>You have a categorical independent variable with three levels (Program 1, Program 2, Program 3) and a continuous dependent variable (mean levels of conflict resolution skills).</strong></li> </ul> </li> </ul> </li> <li>Set your confidence/alpha: <strong>Confidence = .95, and alpha = .05.</strong></li> </ul> <p class="import-Normal">To find our critical value, we need to find our degrees of freedom first. You will have just one critical value, which will be positive, because we are using the <em>F </em>distribution.</p> <p class="import-Normal">For our example, we have three levels, so <em>k</em> = 3. Across the three groups in this example, we have a total of 15 participants, so <em>N</em><sub>t</sub> = 15.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 17.1. Calculating Degrees of Freedom Between and Within Groups</h5> </div> <div class="textbox__content"><p><strong>Formula for degrees of freedom (df) between groups:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=ayDigJMgMQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="k – 1" title="k – 1" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=MyDigJMgMSA9IDI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="3 – 1 = 2" title="3 – 1 = 2" class="latex mathjax" /></p> <p>&nbsp;</p> <p><strong>Formula for degrees of freedom (df) within groups:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=Tl90wqDigJMgaw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N_t&nbsp;– k" title="N_t&nbsp;– k" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=MTUg4oCTIDMgPSAxMg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="15 – 3 = 12" title="15 – 3 = 12" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">So, we will use <em>df</em> between groups&nbsp; = 2 and <em>df</em> within groups = 12 to look up our <em>F</em>-critical value in Table A.3. With a significance level of 0.05, we look up our degrees of freedom between groups along the top column and then use the degrees of freedom within groups along the left-hand first column. This shows us that our critical value is 3.89. We will use this value to separate our confidence and alpha areas on the <em>F</em> distribution.</span></p> <ul><li>Find your critical value: <strong><em>F</em><sub>c</sub> = 3.89.&nbsp;</strong></li> </ul> <h4 class="import-Normal">Step 3: Test Statistic Computation</h4> <p class="import-Normal">We will use a summary table to help us find all the pieces we need for our <em>F</em>-obtained value (see Table 17.1). The summary table is useful for illustrating our total variability (bottom row), and how we partition our variability into between-groups (top row) and within-groups (middle row) variability. Then we have columns for sum of squares (<em>SS</em>), degrees of freedom (<em>df</em>), mean square (<em>MS</em>), and <em>F</em> (your obtained value).</p> <table class="grid" style="width: 1080px; height: 480px;"><caption>Table 17.1. One-Way Analysis of Variance (ANOVA) Summary Table</caption> <thead><tr style="height: 17.5pt;"><td class="shaded" style="border: 0.5pt solid windowtext; width: 80.5114px; height: 53px;"><p class="import-Normal"></p></td> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 277.159px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Sum of Squares (<em>SS</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 114.595px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Degrees of Freedom (<em>df</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 154.219px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Mean Square (<em>MS</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 97.9474px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><em><strong>F</strong></em></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 29.25pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 80.5114px; height: 233px;" scope="row"><p class="import-Normal"><strong>Between Groups</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 277.159px; height: 233px;"><p style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfYiA9IFxsZWZ0KFxzdW1fe2k9MX1ee2t9IFxmcmFjeyhcc3VtIHhfaSleMn17Tl9pfVxyaWdodCkgLSBcZnJhY3soXHN1bSB4X3QpXjJ9e05fdH0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_b = \left(\sum_{i=1}^{k} \frac{(\sum x_i)^2}{N_i}\right) - \frac{(\sum x_t)^2}{N_t}" title="SS_b = \left(\sum_{i=1}^{k} \frac{(\sum x_i)^2}{N_i}\right) - \frac{(\sum x_t)^2}{N_t}" class="latex mathjax" /><span class="footnote"><span class="footnote-indirect" data-fnref="288-1"></span></span></p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 114.595px; height: 233px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfYiA9IGsgLSAx&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_b = k - 1" title="df_b = k - 1" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 154.219px; height: 233px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfYiA9IFxmcmFje1NTX2J9e2RmX2J9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_b = \frac{SS_b}{df_b}" title="MS_b = \frac{SS_b}{df_b}" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 97.9474px; height: 233px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=RiA9IFxmcmFje01TX2J9e01TX3d9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="F = \frac{MS_b}{MS_w}" title="F = \frac{MS_b}{MS_w}" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 30.95pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 80.5114px; height: 141px;" scope="row"><p class="import-Normal"><strong>Within Groups</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 277.159px; height: 141px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSBTU193ID0gXHN1bV97aT0xfV57a30gXGxlZnQoXHN1bSB4X2leMiAtIFxmcmFjeyhcc3VtIHhfaSleMn17Tl9pfVxyaWdodCkgXFwgXHRleHR7QWxzbyBub3RhdGVkOn0gXFwgU1NfdyA9IFNTXzEgKyBTU18yICsgU1NfMyBcZW5ke2dhdGhlcmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_w = \sum_{i=1}^{k} \left(\sum x_i^2 - \frac{(\sum x_i)^2}{N_i}\right) \\ \text{Also notated:} \\ SS_w = SS_1 + SS_2 + SS_3 \end{gathered}" title="\begin{gathered} SS_w = \sum_{i=1}^{k} \left(\sum x_i^2 - \frac{(\sum x_i)^2}{N_i}\right) \\ \text{Also notated:} \\ SS_w = SS_1 + SS_2 + SS_3 \end{gathered}" class="latex mathjax" /></p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 114.595px; height: 141px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfdyA9IE5fdCAtIGs&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_w = N_t - k" title="df_w = N_t - k" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 154.219px; height: 141px;"><div style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfdyA9IFxmcmFje1NTX3d9e2RmX3d9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_w = \frac{SS_w}{df_w}" title="MS_w = \frac{SS_w}{df_w}" class="latex mathjax" /></div> <p>&nbsp;</p></td> <td style="height: 141px; width: 97.9474px; text-align: center;">–</td> </tr> <tr class="TableGrid-R" style="height: 45.85pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 80.5114px; height: 53px;" scope="row"><p class="import-Normal"><strong>Total</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 277.159px; height: 53px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfdCA9IFxzdW0geF90XjIgLSBcZnJhY3soXHN1bSB4X3QpXjJ9e05fdH0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_t = \sum x_t^2 - \frac{(\sum x_t)^2}{N_t}" title="SS_t = \sum x_t^2 - \frac{(\sum x_t)^2}{N_t}" class="latex mathjax" /></p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 114.595px; height: 53px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfdCA9IE5fdCAtIDE&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_t = N_t - 1" title="df_t = N_t - 1" class="latex mathjax" /></td> <td style="height: 53px; width: 154.446px; text-align: center;">–</td> <td style="height: 53px; width: 98.1747px; text-align: center;">–</td> </tr> </tbody> </table> <p>Table 17.2.1 shows the data for our example. It is helpful to calculate many of these descriptive statistics (see Table 17.2.2) ahead of time, so that you have this available anytime you go to complete an ANOVA summary table.</p> <table class="grid" style="border-collapse: collapse; width: 100%;"><caption>Table 17.2.1. Data for NOVA Example of Three Programs&nbsp;</caption> <tbody><tr><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 18px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Program 1</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 18px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Program 2</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 18px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Program 3</strong></p> </th> </tr> <tr><td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">4</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">1</p> </td> </tr> <tr><td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">12</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">6</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">3</p> </td> </tr> <tr><td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">4</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">4</p> </td> </tr> <tr><td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">2</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">5</p> </td> </tr> <tr><td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">7</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 25%; height: 35px;"><p class="import-Normal" style="text-align: center;">2</p> </td> </tr> </tbody> </table> <table class="grid" style="border-collapse: collapse; width: 100%;"><caption>Table 17.2.2. Descriptive statistics for ANOVA summary table using Three Programs example&nbsp;</caption> <tbody><tr><td style="width: 20%;"></td> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 20.0221%; height: 18px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Program 1</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 20.0221%; height: 18px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Program 2</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 20.0221%; height: 18px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Program 3</strong></p> </th> </tr> <tr><th style="width: 20%; text-align: left;" scope="row">Sum of values (<img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x" title="\sum x" class="latex mathjax" />)</th> <td style="height: 18px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4XzEgPSA0MA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x_1 = 40" title="\sum x_1 = 40" class="latex mathjax" /></td> <td style="height: 18px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4XzIgPSAzMA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x_2 = 30" title="\sum x_2 = 30" class="latex mathjax" /></td> <td style="height: 18px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4XzMgPSAxNQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x_3 = 15" title="\sum x_3 = 15" class="latex mathjax" /></td> </tr> <tr><th style="width: 20%; text-align: left;" scope="row">Sum of squared values (<img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4XjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x^2" title="\sum x^2" class="latex mathjax" />)</th> <td style="height: 36px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4XzFeMiA9IDM1NA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x_1^2 = 354" title="\sum x_1^2 = 354" class="latex mathjax" /></td> <td style="height: 36px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4XzJeMiA9IDIyMA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x_2^2 = 220" title="\sum x_2^2 = 220" class="latex mathjax" /></td> <td style="height: 36px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4XzNeMiA9IDU1&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x_3^2 = 55" title="\sum x_3^2 = 55" class="latex mathjax" /></td> </tr> <tr><th style="width: 20%; text-align: left;" scope="row">Sample size (<img src="https://mathjax.library.illinois.edu/latex?latex=Tg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N" title="N" class="latex mathjax" />)</th> <td style="height: 18px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=Tl8xID0gNQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N_1 = 5" title="N_1 = 5" class="latex mathjax" /></td> <td style="height: 18px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=Tl8yID0gNQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N_2 = 5" title="N_2 = 5" class="latex mathjax" /></td> <td style="height: 18px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=Tl8zID0gNQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N_3 = 5" title="N_3 = 5" class="latex mathjax" /></td> </tr> <tr><th style="width: 20%; text-align: left;" scope="row">Sample mean (<img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}" title="\bar{x}" class="latex mathjax" />)</th> <td style="height: 36px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fV8xID0gOA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}_1 = 8" title="\bar{x}_1 = 8" class="latex mathjax" /></td> <td style="height: 36px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fV8yID0gNg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}_2 = 6" title="\bar{x}_2 = 6" class="latex mathjax" /></td> <td style="height: 36px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fV8zID0gMw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}_3 = 3" title="\bar{x}_3 = 3" class="latex mathjax" /></td> </tr> <tr><th style="width: 20%; text-align: left;" scope="row">Sum of squares (<img src="https://mathjax.library.illinois.edu/latex?latex=U1M&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS" title="SS" class="latex mathjax" />)</th> <td style="height: 18px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfMSA9IDM0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_1 = 34" title="SS_1 = 34" class="latex mathjax" /></td> <td style="height: 18px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfMiA9IDQw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_2 = 40" title="SS_2 = 40" class="latex mathjax" /></td> <td style="height: 18px; width: 20.0221%; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfMyA9IDEw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_3 = 10" title="SS_3 = 10" class="latex mathjax" /></td> </tr> </tbody> </table> <h5>Totals Using the Three Programs Example</h5> <ul class="study-totals-list"><li>Total Sum of Values: <img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4X3QgPSA4NQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x_t = 85" title="\sum x_t = 85" class="latex mathjax" /></li> <li>Total Sum of Squares: <img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4X3ReMiA9wqA2Mjk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x_t^2 =&nbsp;629" title="\sum x_t^2 =&nbsp;629" class="latex mathjax" /></li> <li>Total Sample Size: <img src="https://mathjax.library.illinois.edu/latex?latex=Tl90ID3CoDE1&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N_t =&nbsp;15" title="N_t =&nbsp;15" class="latex mathjax" /></li> <li>Total Number of Groups: <img src="https://mathjax.library.illinois.edu/latex?latex=az3CoDM&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="k=&nbsp;3" title="k=&nbsp;3" class="latex mathjax" /></li> </ul> <p class="import-Normal">In filling out the summary table, you could start with the degrees of freedom column because you previously calculated two of these values to find your critical values (Step 2). The only additional degrees of freedom to calculate are your total degrees of freedom, which is your total N (across all groups) minus 1 (see Table 17.3).</p> </div> <div class="chapter-17:-(one-way)-analysis-of-variance-(anova)"><table class="grid"><caption>Table 17.3. ANOVA Summary Table with Degrees of Freedom (<em>df</em>) Column Completed</caption> <thead><tr style="height: 17.5pt;"><th class="shaded" style="border: 0.5pt solid windowtext; width: 101.141px; height: 53px;" scope="col"><p class="import-Normal"></p></th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Sum of Squares (<em>SS</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Degrees of Freedom (<em>df</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Mean Square (<em>MS</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 108.281px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><em><strong>F</strong></em></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 29.25pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 233px;" scope="row"><p class="import-Normal"><strong>Between Groups</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 233px;"><p style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfYiA9IFxsZWZ0KFxzdW1fe2k9MX1ee2t9IFxmcmFjeyhcc3VtIHhfaSleMn17Tl9pfVxyaWdodCkgLSBcZnJhY3soXHN1bSB4X3QpXjJ9e05fdH0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_b = \left(\sum_{i=1}^{k} \frac{(\sum x_i)^2}{N_i}\right) - \frac{(\sum x_t)^2}{N_t}" title="SS_b = \left(\sum_{i=1}^{k} \frac{(\sum x_i)^2}{N_i}\right) - \frac{(\sum x_t)^2}{N_t}" class="latex mathjax" /><span class="footnote"><span class="footnote-indirect" data-fnref="288-2"></span></span></p> </td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 233px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfYiA9IDMgLSAxPTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_b = 3 - 1=2" title="df_b = 3 - 1=2" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 233px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfYiA9IFxmcmFje1NTX2J9e2RmX2J9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_b = \frac{SS_b}{df_b}" title="MS_b = \frac{SS_b}{df_b}" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 108.281px; height: 233px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=RiA9IFxmcmFje01TX2J9e01TX3d9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="F = \frac{MS_b}{MS_w}" title="F = \frac{MS_b}{MS_w}" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 30.95pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 141px;" scope="row"><p class="import-Normal"><strong>Within Groups</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 141px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSBTU193ID0gXHN1bV97aT0xfV57a30gXGxlZnQoXHN1bSB4X2leMiAtIFxmcmFjeyhcc3VtIHhfaSleMn17Tl9pfVxyaWdodCkgXFwgXHRleHR7QWxzbyBub3RhdGVkOn0gXFwgU1NfdyA9IFNTXzEgKyBTU18yICsgU1NfMyBcZW5ke2dhdGhlcmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_w = \sum_{i=1}^{k} \left(\sum x_i^2 - \frac{(\sum x_i)^2}{N_i}\right) \\ \text{Also notated:} \\ SS_w = SS_1 + SS_2 + SS_3 \end{gathered}" title="\begin{gathered} SS_w = \sum_{i=1}^{k} \left(\sum x_i^2 - \frac{(\sum x_i)^2}{N_i}\right) \\ \text{Also notated:} \\ SS_w = SS_1 + SS_2 + SS_3 \end{gathered}" class="latex mathjax" /></p> </td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 141px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfdyA9IDE1IC0gMz0xMg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_w = 15 - 3=12" title="df_w = 15 - 3=12" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 141px;"><div style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfdyA9IFxmcmFje1NTX3d9e2RmX3d9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_w = \frac{SS_w}{df_w}" title="MS_w = \frac{SS_w}{df_w}" class="latex mathjax" /></div> </td> <td style="text-align: center;">–</td> </tr> <tr class="TableGrid-R" style="height: 45.85pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 53px;" scope="row"><p class="import-Normal"><strong>Total</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 53px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfdCA9IFxzdW0geF90XjIgLSBcZnJhY3soXHN1bSB4X3QpXjJ9e05fdH0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_t = \sum x_t^2 - \frac{(\sum x_t)^2}{N_t}" title="SS_t = \sum x_t^2 - \frac{(\sum x_t)^2}{N_t}" class="latex mathjax" /></p> </td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 53px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfdCA9IDE1IC0gMT0xNA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_t = 15 - 1=14" title="df_t = 15 - 1=14" class="latex mathjax" /></td> <td style="text-align: center;">–</td> <td style="text-align: center;">–</td> </tr> </tbody> </table> <p class="import-Normal">To check your work, your <em>df</em><sub>b </sub>+ <em>df</em><sub>w </sub>= <em>df</em><sub>t</sub>. So, 2 + 12 = 14, so your degrees of freedom are correctly calculated.</p> <p class="import-Normal">Next, you can move to the sum of squares (<em>SS</em>) column, as shown in Table 17.4.</p> </div> <div class="chapter-17:-(one-way)-analysis-of-variance-(anova)"><table class="grid" style="height: 435px;"><caption>Table 17.4. ANOVA Summary Table with Degrees of Freedom (<em>df</em>) and Sum of Squares (<em>SS</em>) Columns Completed</caption> <thead><tr style="height: 17.5pt;"><th class="shaded" style="border: 0.5pt solid windowtext; width: 101.141px; height: 53px;" scope="col"><p class="import-Normal"></p></th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Sum of Squares (<em>SS</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Degrees of Freedom (<em>df</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Mean Square (<em>MS</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 108.266px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><em><strong>F</strong></em></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 29.25pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 188px;" scope="row"><p class="import-Normal"><strong>Between Groups</strong></p> </th> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 188px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_b = \left(\sum_{i=1}^{k} \frac{(\sum x_i)^2}{N_i}\right) - \frac{(\sum x_t)^2}{N_t} \\ SS_b = \left(\frac{(\sum x_1)^2}{N_1} + \frac{(\sum x_2)^2}{N_2} + \frac{(\sum x_3)^2}{N_3}\right) - \frac{(\sum x_t)^2}{N_t} \\ SS_b = \left(\frac{(40)^2}{5} + \frac{(30)^2}{5} + \frac{(15)^2}{5}\right) - \frac{(85)^2}{15} \\ SS_b = (320 + 180 + 45) - 481.67 = 63.33 \\ \textbf{SS}_{\textbf{b}} = \textbf{63.33} \end{gathered}" title="\begin{gathered} SS_b = \left(\sum_{i=1}^{k} \frac{(\sum x_i)^2}{N_i}\right) - \frac{(\sum x_t)^2}{N_t} \\ SS_b = \left(\frac{(\sum x_1)^2}{N_1} + \frac{(\sum x_2)^2}{N_2} + \frac{(\sum x_3)^2}{N_3}\right) - \frac{(\sum x_t)^2}{N_t} \\ SS_b = \left(\frac{(40)^2}{5} + \frac{(30)^2}{5} + \frac{(15)^2}{5}\right) - \frac{(85)^2}{15} \\ SS_b = (320 + 180 + 45) - 481.67 = 63.33 \\ \textbf{SS}_{\textbf{b}} = \textbf{63.33} \end{gathered}" class="latex mathjax" /></td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 188px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfYiA9Mg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_b =2" title="df_b =2" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 188px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfYiA9IFxmcmFje1NTX2J9e2RmX2J9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_b = \frac{SS_b}{df_b}" title="MS_b = \frac{SS_b}{df_b}" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 108.266px; height: 188px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=RiA9IFxmcmFje01TX2J9e01TX3d9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="F = \frac{MS_b}{MS_w}" title="F = \frac{MS_b}{MS_w}" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 30.95pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 141px;" scope="row"><p class="import-Normal"><strong>Within Groups</strong></p> </th> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 141px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{aligned} SS_w &amp;amp;= \left(\sum x_1^2 - \frac{(\sum x_1)^2}{N_1}\right) + \left(\sum x_2^2 - \frac{(\sum x_2)^2}{N_2}\right) \\ &amp;amp;\quad + \left(\sum x_3^2 - \frac{(\sum x_3)^2}{N_3}\right) \\ SS_w &amp;amp;= \left(354 - \frac{(40)^2}{5}\right) + \left(220 - \frac{(30)^2}{5}\right) + \left(55 - \frac{(15)^2}{5}\right) \\ SS_w &amp;amp;= 34 + 40 + 10 = 84 \\ \textbf{SS}_{\textbf{w}} &amp;amp;= \textbf{84} \end{aligned}" title="\begin{aligned} SS_w &amp;amp;= \left(\sum x_1^2 - \frac{(\sum x_1)^2}{N_1}\right) + \left(\sum x_2^2 - \frac{(\sum x_2)^2}{N_2}\right) \\ &amp;amp;\quad + \left(\sum x_3^2 - \frac{(\sum x_3)^2}{N_3}\right) \\ SS_w &amp;amp;= \left(354 - \frac{(40)^2}{5}\right) + \left(220 - \frac{(30)^2}{5}\right) + \left(55 - \frac{(15)^2}{5}\right) \\ SS_w &amp;amp;= 34 + 40 + 10 = 84 \\ \textbf{SS}_{\textbf{w}} &amp;amp;= \textbf{84} \end{aligned}" class="latex mathjax" /></td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 141px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfdyA9MTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_w =12" title="df_w =12" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 141px;"><div style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfdyA9IFxmcmFje1NTX3d9e2RmX3d9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_w = \frac{SS_w}{df_w}" title="MS_w = \frac{SS_w}{df_w}" class="latex mathjax" /></div> </td> <td style="height: 141px; width: 108.266px; text-align: center;">–</td> </tr> <tr class="TableGrid-R" style="height: 45.85pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 53px;" scope="row"><p class="import-Normal"><strong>Total</strong></p> </th> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 53px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2FsaWduZWR9ICBTU190ICY9IFxzdW0geF90XjIgLSBcZnJhY3soXHN1bSB4X3QpXjJ9e05fdH0gXFwgIFNTX3QgJj0gNjI5IC0gXGZyYWN7KDg1KV4yfXsxNX0gXFwgIFNTX3QgJj0gNjI5IC0gNDgxLjY3ID0gMTQ3LjMzIFxcICBcdGV4dGJme1NTfV97XHRleHRiZnt0fX0gJj0gXHRleHRiZnsxNDcuMzN9ICBcZW5ke2FsaWduZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{aligned} SS_t &amp;amp;= \sum x_t^2 - \frac{(\sum x_t)^2}{N_t} \\ SS_t &amp;amp;= 629 - \frac{(85)^2}{15} \\ SS_t &amp;amp;= 629 - 481.67 = 147.33 \\ \textbf{SS}_{\textbf{t}} &amp;amp;= \textbf{147.33} \end{aligned}" title="\begin{aligned} SS_t &amp;amp;= \sum x_t^2 - \frac{(\sum x_t)^2}{N_t} \\ SS_t &amp;amp;= 629 - \frac{(85)^2}{15} \\ SS_t &amp;amp;= 629 - 481.67 = 147.33 \\ \textbf{SS}_{\textbf{t}} &amp;amp;= \textbf{147.33} \end{aligned}" class="latex mathjax" /></p> </td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 53px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfdCA9MTQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_t =14" title="df_t =14" class="latex mathjax" /></td> <td style="height: 53px; width: 222.797px; text-align: center;">–</td> <td style="height: 53px; width: 108.766px; text-align: center;">–</td> </tr> </tbody> </table> <p class="import-Normal">To check your work, your <em>SS</em><sub>b </sub>+ <em>SS</em><sub>w </sub>= <em>SS</em><sub>t</sub>. So, 63.33 + 84 = 147.33, which means your sum of squares estimates are correctly calculated.</p> <p class="import-Normal">Now that we have the first two columns calculated, we can move on to our final two columns. First, we’ll calculate our mean squares for between and within groups (see Table 17.5). These are ratios of your sum of squares to degrees of freedom for between groups and for within groups. Mean squares are your average variances for both sources of variability.</p> </div> <table class="grid"><caption>Table 17.5. ANOVA Summary Table with Degrees of Freedom (df), Sum of Squares, and Mean Square Columns Completed</caption> <thead><tr style="height: 17.5pt;"><th class="shaded" style="border: 0.5pt solid windowtext; width: 101.141px; height: 53px;" scope="col"><p class="import-Normal"></p></th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Sum of Squares (<em>SS</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Degrees of Freedom (<em>df</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Mean Square (<em>MS</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 108.266px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><em><strong>F</strong></em></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 29.25pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 188px;" scope="row"><p class="import-Normal"><strong>Between Groups</strong></p> </th> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 188px;"><p style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfYiA9IDYzLjMz&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_b = 63.33" title="SS_b = 63.33" class="latex mathjax" /></p> </td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 188px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfYiA9Mg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_b =2" title="df_b =2" class="latex mathjax" /></td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 188px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfYiA9IFxmcmFje1NTX2J9e2RmX2J9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_b = \frac{SS_b}{df_b}" title="MS_b = \frac{SS_b}{df_b}" class="latex mathjax" /> <p><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfYiA9IFxmcmFjezYzLjMzfXsyfT0zMS42Nw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_b = \frac{63.33}{2}=31.67" title="MS_b = \frac{63.33}{2}=31.67" class="latex mathjax" /></p></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 108.266px; height: 188px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=RiA9IFxmcmFje01TX2J9e01TX3d9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="F = \frac{MS_b}{MS_w}" title="F = \frac{MS_b}{MS_w}" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 30.95pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 141px;" scope="row"><p class="import-Normal"><strong>Within Groups</strong></p> </th> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 141px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfdyA9IDg0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_w = 84" title="SS_w = 84" class="latex mathjax" /></td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 141px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfdyA9MTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_w =12" title="df_w =12" class="latex mathjax" /></td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 141px;"><div style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfdyA9IFxmcmFje1NTX3d9e2RmX3d9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_w = \frac{SS_w}{df_w}" title="MS_w = \frac{SS_w}{df_w}" class="latex mathjax" /></div> <div></div> <div style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfdyA9IFxmcmFjezg0fXsxMn09Nw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_w = \frac{84}{12}=7" title="MS_w = \frac{84}{12}=7" class="latex mathjax" /></div> </td> <td style="height: 141px; width: 108.266px; text-align: center;">–</td> </tr> <tr class="TableGrid-R" style="height: 45.85pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 53px;" scope="row"><p class="import-Normal"><strong>Total</strong></p> </th> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 53px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfdCA9IDE0Ny4zMw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_t = 147.33" title="SS_t = 147.33" class="latex mathjax" /></p> </td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 53px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfdCA9MTQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_t =14" title="df_t =14" class="latex mathjax" /></td> <td style="height: 53px; width: 222.797px; text-align: center;">–</td> <td style="height: 53px; width: 108.766px; text-align: center;">–</td> </tr> </tbody> </table> <div class="chapter-17:-(one-way)-analysis-of-variance-(anova)"><p class="import-Normal">We finally have all the information we need to solve for our <em>F</em>-obtained value (the far right column; see Table 17.6). Again, the <em>F</em>-obtained value is a ratio of the variance between groups to the variance within groups. So you will take your <em>MS</em><sub>b</sub>&nbsp;and divide by your <em>MS</em><sub>w</sub>. Remember, this is a ratio, so this will be a positive value.</p> <table class="grid"><caption>Table 17.6. ANOVA Summary Table With All Columns Completed</caption> <thead><tr style="height: 17.5pt;"><th class="shaded" style="border: 0.5pt solid windowtext; width: 101.141px; height: 53px;" scope="col"><p class="import-Normal"></p></th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Sum of Squares (<em>SS</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Degrees of Freedom (<em>df</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Mean Square (<em>MS</em>)</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 108.266px; height: 53px;" scope="col"><p class="import-Normal" style="text-align: center;"><em><strong>F</strong></em></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 29.25pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 188px;" scope="row"><p class="import-Normal"><strong>Between Groups</strong></p> </th> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 188px;"><p style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfYiA9IDYzLjMz&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_b = 63.33" title="SS_b = 63.33" class="latex mathjax" /></p> </td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 188px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfYiA9Mg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_b =2" title="df_b =2" class="latex mathjax" /></td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 188px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfYiA9MzEuNjc&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_b =31.67" title="MS_b =31.67" class="latex mathjax" /></td> <td class="shaded" style="border: 0.5pt solid windowtext; width: 108.266px; height: 188px; vertical-align: middle;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=RiA9IFxmcmFje01TX2J9e01TX3d9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="F = \frac{MS_b}{MS_w}" title="F = \frac{MS_b}{MS_w}" class="latex mathjax" /></p> <p style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=RiA9IFxmcmFjezYzLjMzfXs3fT00LjUywqA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="F = \frac{63.33}{7}=4.52&nbsp;" title="F = \frac{63.33}{7}=4.52&nbsp;" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 30.95pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 141px;" scope="row"><p class="import-Normal"><strong>Within Groups</strong></p> </th> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 141px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfdyA9IDg0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_w = 84" title="SS_w = 84" class="latex mathjax" /></td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 141px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfdyA9MTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_w =12" title="df_w =12" class="latex mathjax" /></td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 222.297px; height: 141px;"><div style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TVNfdyA9Nw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="MS_w =7" title="MS_w =7" class="latex mathjax" /></div> </td> <td style="height: 141px; width: 108.266px; text-align: center;">–</td> </tr> <tr class="TableGrid-R" style="height: 45.85pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 101.141px; height: 53px;" scope="row"><p class="import-Normal"><strong>Total</strong></p> </th> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 414.594px; height: 53px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfdCA9IDE0Ny4zMw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_t = 147.33" title="SS_t = 147.33" class="latex mathjax" /></p> </td> <td class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 152.219px; height: 53px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=ZGZfdCA9MTQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df_t =14" title="df_t =14" class="latex mathjax" /></td> <td style="height: 53px; width: 222.797px; text-align: center;">–</td> <td style="height: 53px; width: 108.766px; text-align: center;">–</td> </tr> </tbody> </table> <p class="import-Normal">Our obtained value in this example is <em>F</em> = 4.52.</p> <p class="import-Normal">We can now plot this on our <em>F </em>distribution (see Figure 17.3), where we labeled our critical value (<em>F</em> = 3.89) to divide our confidence and alpha areas (which were set in Step 2). We see that the <em>F</em>-obtained value exceeds this critical value.</p> <div class="wp-caption aligncenter" id="attachment_1243" aria-describedby="caption-attachment-1243" style="width: 700px"><img class="wp-image-1243" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-17.3R-1.png" alt="F distribution with F critical value of 3.89 separating confidence from alpha areas is shown, with the alpha region shaded in. The obtained value of 4.52 is labeled and it falls in the alpha area." width="700" height="378" title="" /><div class="wp-caption-text" id="caption-attachment-1243">Figure 17.3. <em>F</em> distribution with <em>F</em>-critical value of 3.89 separating confidence from alpha areas; the obtained value of 4.52 is labeled.</div></div> <h4 class="import-Normal">Step 4: Make a Decision</h4> <p class="import-Normal">Based on this example, you would then make a decision to reject or fail to reject the null hypothesis. In this example, you would <strong>reject the null hypothesis</strong>.&nbsp;Your obtained value exceeds the critical value and is in the alpha area. This means that there is a significant difference in conflict resolution skills between youth who participate in these three different groups.</p> <h4 class="import-Normal">APA-Style Write-up</h4> <p class="import-Normal">The American Psychological Association ([APA], 2020)-style write-up is similar to that for the independent samples <em>t</em>-test. The key difference is that you are referring to the <em>F</em>-test, as well as your between- and within-groups degrees of freedom.</p> <p class="import-Normal" style="padding-left: 40px;">A one-way ANOVA was conducted to compare the effect of three restorative justice programs on levels of conflict resolution skills. The three conditions were Program 1, Program 2, and Program 3. There was a significant effect of the restorative justice program on youth conflict resolution skills for the three conditions, <em>F</em>(2, 12) = 4.52, <em>p</em> &lt; .05.</p> <p class="import-Normal">Note that for your degrees of freedom in the write-up, you include both your between-groups (2) and within-groups (12) degrees of freedom. The hypothesis test tells us that there is an overall significant effect. However, you may be curious where the difference is: Is it between Programs 1 and 2? Or Programs 1 and 3? Or Programs 2 and 3? This is where the next part of ANOVA comes into play: the post hoc test.</p> <h2 class="import-Normal">ANOVA Post Hoc Test</h2> <p class="import-Normal"><em>Post hoc</em> (Latin for “after this”) <em>tests </em>allow you to find where the difference exists after you get a significant overall test (with the <em>F</em>-test). The post hoc test will show you which groups are significantly different from each other. There is an array of post hoc tests to choose from, depending on your group sizes, the level of confidence you want, and so forth. This book examines one of the most common, which is used when you have an equal number of participants in each group. This post hoc test is called <em>Tukey’s honestly significant difference (HSD)</em> test. In our example, we have five participants in each level, so we can use the Tukey HSD test to find which programs are significantly different from each other. A bar chart could be a useful image to include to help readers understand the comparisons of means when writing about ANOVA results in a report (see Figure 17.4).</p> <div class="wp-caption aligncenter" id="attachment_1244" aria-describedby="caption-attachment-1244" style="width: 700px"><img class="wp-image-1244" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-17.4R-1.png" alt="A bar graph is shown with the means of each program. Program 1 has a mean of 8, program 2 has a mean of 6, and program 3 has a mean of 3." width="700" height="467" title="" /><div class="wp-caption-text" id="caption-attachment-1244">Figure 17.4. Bar graph comparing means across the three programs (each program is independent of the others, so each color represents a unique program).</div></div> <p class="import-Normal">This post hoc test will allow us to make pairwise comparisons:</p> <ul><li>Program 1 versus Program 2</li> <li>Program 1 versus Program 3</li> <li>Program 2 versus Program 3</li> </ul> <p class="import-Normal">To find where your difference or differences exist, you will calculate the HSD. The HSD will give you a critical value; if the difference between two of your group means exceeds this critical value, then there is a significant difference between the two means.</p> <div class="textbox shaded"><h3>Formula 17.2. Calculating Tukey’s HSD</h3> <p><strong>Formula for Tukey’s HSD:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHRleHR7SFNEfSA9IHFcc3FydHtcZnJhY3tNU197XHRleHR7d2l0aGlufX19e059fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\text{HSD} = q\sqrt{\frac{MS_{\text{within}}}{N}}" title="\text{HSD} = q\sqrt{\frac{MS_{\text{within}}}{N}}" class="latex mathjax" /></p> </div> <p class="import-Normal">If we look at this formula, we’ll notice the following elements:</p> <ul><li>The q value is found in a <em>q</em>-table (known as a <em>Studentized Range Distribution Table</em>; Zaiontz, n.d.). You will look up your <em>q</em> value based on your alpha level, the number of groups you are comparing (<em>k</em>), and your degrees of freedom within groups. A <em>q</em> table is available from <a href="https://real-statistics.com/statistics-tables/studentized-range-q-table/" target="_blank" rel="noopener" data-url="https://real-statistics.com/statistics-tables/studentized-range-q-table/">Real Statistics Using Excel</a>.</li> <li>In our example, we will find the table for alpha = 0.05, then use the <em>k</em> = 3 column, and the row for <em>df</em> within groups = 12. So, the <em>q </em>value in our example is 3.773.</li> <li><em>MS</em><sub>within </sub>has previously been calculated and can be found in your ANOVA summary table. In our example, this value is 7.</li> <li><em>N</em> is the sample size of any group because the Tukey HSD test is used when your group sizes are the same. So, you’ll use <em>N</em> = 5 in our example.</li> </ul> <div class="textbox textbox--examples"><div class="textbox__header"><h3 class="textbox__title">Example 17.2. Calculating Tukey’s HSD</h3> </div> <div class="textbox__content"><p><strong>Formula for Tukey’s HSD:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHRleHR7SFNEfSA9IHFcc3FydHtcZnJhY3tNU197XHRleHR7d2l0aGlufX19e059fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\text{HSD} = q\sqrt{\frac{MS_{\text{within}}}{N}}" title="\text{HSD} = q\sqrt{\frac{MS_{\text{within}}}{N}}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XHRleHR7SFNEfSA9IDMuNzczXHNxcnR7XGZyYWN7N317NX19PTQuNDU&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\text{HSD} = 3.773\sqrt{\frac{7}{5}}=4.45" title="\text{HSD} = 3.773\sqrt{\frac{7}{5}}=4.45" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">So, our Tukey HSD value is ±4.45, which is used as a critical value. We will take the mean differences between each group and if the difference exceeds this critical value, then we know whether there is a significant difference between that pairwise comparison. Here are our three means to compare: <span style="font-size: NaNpt; color: #; text-decoration: none;"><em>x̅</em><sub>1 </sub>= 8, <em>x̅</em><sub>2 </sub>= 6, and <em>x̅</em><sub>3 </sub>= 3.&nbsp;</span></span></p> <p class="import-Normal">After you calculate the difference between program means (middle column in Table 17.7), you’ll determine whether that difference exceeds the HSD critical value. If it does, you’ll indicate a significant difference (“<em>p</em> &lt; .05”). In our example, Program 1 versus 3 has a difference of 5 points; 5 exceeds 4.45, so this difference is significant. Our other comparisons have differences of 2 and 3; neither exceeds 4.45, so they are not significantly different (“<em>p</em> &gt; .05”).</p> <table style="width: 471.85pt;"><caption>Table 17.7. Pairwise Difference Comparisons</caption> <thead><tr style="height: 19.5pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal"><strong>Comparisons</strong></p> </th> <th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Difference</strong></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><em><strong>p</strong></em></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 18.4pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal">Program 1 versus Program 2</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">8 – 6 = 2</p> </td> <td class="TableGrid-C" style="background-color: #e7e6e6; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;"><em>p</em> &gt; .05</p> </td> </tr> <tr class="TableGrid-R" style="height: 19.5pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal">Program 1 versus Program 3</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">8 – 3 = 5</p> </td> <td class="TableGrid-C" style="background-color: #e7e6e6; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;"><em>p</em> &lt; .05</p> </td> </tr> <tr class="TableGrid-R" style="height: 18.4pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal">Program 2 versus Program 3</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">6 – 3 = 3</p> </td> <td class="TableGrid-C" style="background-color: #e7e6e6; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;"><em>p</em> &gt; .05</p> </td> </tr> </tbody> </table> <h3>APA-Style Write-up</h3> <p class="import-Normal">We can now add the information from our post hoc test to our APA-style write-up:</p> <p class="import-Normal" style="padding-left: 40px;">A one-way ANOVA was conducted to compare the effect of three restorative justice programs on levels of conflict resolution skills. The three conditions were Program 1, Program 2, and Program 3. There was a significant effect of the restorative justice program on youth conflict resolution skills for the three conditions, <em>F</em>(2, 12) = 4.52, <em>p</em> &lt; .05.</p> <p class="import-Normal" style="padding-left: 40px;">A Tukey HSD post hoc analysis was used to determine which programs were different. The results of this test indicated that youth who participated in Program 1 had significantly higher levels of conflict resolution skills (mean [<em>M</em>] = 8) than youth who participated in Program 3 (<em>M</em> = 3). No other significant differences were found.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">ANOVA is useful when you want to compare means for three or more groups. ANOVA, using the <em>F</em> distribution, allow you to control experiment-wise alpha by partitioning your variance. The ANOVA hypothesis test tells you if there is an overall significant difference between your groups or not. If there is a significant difference between them, you can follow with a post hoc test. Although there are many options for post hoc tests, the Tukey HSD can be used if your groups are the same size.</p> </div> 
	</div>
			
				
				<div class="footnotes"><div id='288-1'><p><img decoding="async" src="https://mathjax.library.illinois.edu/latex?latex=Tl90&#38;fg=000000&#38;svg=1&#38;isBase64=1" alt="N_t" title="N_t" class="latex mathjax" /> means the number of observations in each group; The notation sign with “<em>k</em>” and “<em>i</em> = 1” means that you will repeat the equation for each group, starting with Group 1, and then add these values together.</p>
</div><div id='288-2'><p><img decoding="async" src="https://mathjax.library.illinois.edu/latex?latex=Tl90&#38;fg=000000&#38;svg=1&#38;isBase64=1" alt="N_t" title="N_t" class="latex mathjax" /> means the number of observations in each group; The notation sign with “<em>k</em>” and “<em>i</em> = 1” means that you will repeat the equation for each group, starting with Group 1, and then add these values together. </p>
</div></div>
	</div>

</div>
<div class="part-wrapper" id="part-unit-vi-inferential-statistics-looking-at-relationships-wrapper">
    <div class="part  " id="part-unit-vi-inferential-statistics-looking-at-relationships">
	<div class="part-title-wrap">
		<p class="part-number">VI</p>
		<h1 class="part-title">Unit 6. Inferential Statistics: Looking at Relationships</h1>
	</div>
	<div class="ugc part-ugc">
		<p>The final unit in this book examines inferential statistics that look at relationships between variables. We will first examine correlation, specifically correlation between two continuous variables (using Pearson’s <em>r</em>). Following correlation, we will examine the basics of linear regression. Finally, we will examine relationships between categorical data using chi-square tests.</p>
	</div>
			
				
	</div>
<div class="chapter standard " id="chapter-chapter-18-correlation-pearsons-r" title="Chapter 18: Correlation (Pearson’s r)">
	<div class="chapter-title-wrap">
		<p class="chapter-number">38</p>
		<h1 class="chapter-title">Chapter 18: Correlation (Pearson’s r)</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-18:-correlation-(pearson’s-r)"><h2>Correlation</h2> <p class="import-Normal">A <strong><em><span class="glossary-term">correlation</span></em></strong> is the degree of a linear relationship between two continuous variables. A linear relationship is one that can be described by a straight line. Correlation allows you to visualize the pattern in bivariate data, examining how the variables move together: Do they move in the same direction or in opposite directions? Or maybe the variables do not have a significant relationship; when you look at the data, it is difficult to draw a line to describe their relationship.</p> <p class="import-Normal">Correlation provides you with an estimate of covariance, which is a measure of how two variables move. Correlation between two continuous variables can be tested using Pearson’s <em>r</em>. This test provides you with a value, referred to as the <em>correlation coefficient</em>, between −1 and 1.</p> <p class="import-Normal">First, variables may have a positive value, or a<strong><em><span class="glossary-term">positive correlation</span></em></strong> (Pearson’s r value between &gt;0 and 1). These variables move in the same direction:</p> <ul><li>As one variable increases, the other variable increases.</li> <li>As one variable decreases, the other variable decreases.</li> </ul> <p class="import-Normal">A perfect positive correlation forms a line; a high positive correlation has scattered data points, but you can visualize drawing a line to describe how these data points are moving together, as shown in Figure 18.1.</p> <div class="wp-caption aligncenter" id="attachment_292" aria-describedby="caption-attachment-292" style="width: 1024px"><img class="wp-image-292 size-large" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/082_pos-correlation-1024x298.png" alt="Two scatter plot graphs are shown. Data points are shown going from the bottom left to top right corner. In the first, the data points could be connected perfectly in a straight line (this would be a perfect correlation). The second shows data points that are clustered in what looks like a line (this would be a strong positive correlation)." width="1024" height="298" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/082_pos-correlation-1024x298.png 1024w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/082_pos-correlation-300x87.png 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/082_pos-correlation-768x223.png 768w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/082_pos-correlation-1536x446.png 1536w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/082_pos-correlation-65x19.png 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/082_pos-correlation-225x65.png 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/082_pos-correlation-350x102.png 350w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/082_pos-correlation.png 1586w" sizes="auto, (max-width: 1024px) 100vw, 1024px" title="" /><div class="wp-caption-text" id="caption-attachment-292">Figure 18.1. Scatterplot graphs showing a perfect positive correlation and a strong positive correlation.</div></div> <p class="import-Normal">Second, variables may have a negative value, or a <strong><em><span class="glossary-term">negative correlation</span></em></strong> (Pearson’s r value between –1 and &lt;0). These variables move in an inverse, or in the opposite, direction:</p> <ul><li>As one variable increases, the other variable decreases.</li> <li>As one variable decreases, the other variable increases.</li> </ul> <p class="import-Normal">A perfect negative correlation forms a line; a high negative correlation has scattered data points, but you can visualize drawing a line to describe how these data points are moving together, as shown in Figure 18.2.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-292" style="width: 1024px"><img class="wp-image-269 size-large" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/083_neg-correlations-1.png" alt="Two scatter plot graphs are shown. Data points are shown going from the top left to bottom right corner. In the first, the data points could be connected perfectly in a straight line (this would be a perfect correlation). The second shows data points that are clustered in what looks like a line (this would be a strong negative correlation)." width="1024" height="294" title="" /><div class="wp-caption-text">Figure 18.2. Scatterplot graphs showing a perfect negative correlation and a strong negative correlation.</div></div> <p class="import-Normal">Third, variables may have<strong><em><span class="glossary-term">no correlation</span></em></strong> (Pearson’s <em>r</em> value of 0), which means that there is no meaningful relationship between the two variables. The data points are scattered, and it is difficult to draw a line to represent how these variables are moving together, as shown in Figure 18.3.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-292" style="width: 464px"><img class="wp-image-270" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/084_zero-1.png" alt="A scatter plot graph where there is no relationship between two variables; data points are spread all over the graph. The data points do not show any linear pattern." width="464" height="278" title="" /><div class="wp-caption-text">Figure 18.3. A scatterplot graph where there is no relationship between two variables. The data points do not show any linear pattern.</div></div> <p class="import-Normal">As you can see from these descriptions, Pearson’s <em>r</em> values help describe direction and magnitude:</p> <ul><li>Negative value (between –1 and &lt;0): Tells you the variables are moving in opposite directions; the closer the value is to –1, the stronger the magnitude. A correlation of –1 is a perfect negative correlation.</li> <li>Positive value (between &gt;0 and 1): Tells you the variables are moving in the same direction; the closer the value is to 1, the stronger the magnitude. A correlation of 1 is a perfect positive correlation.</li> <li>A value of 0: There is no correlation between the variables.</li> </ul> <p class="import-Normal">An important note about correlation is that these <em>correlations</em> <em>do not imply causation</em>. We can see if the variables move together in the same direction or in opposite directions, but we do not know whether one variable is causing the other variable to move in this way. A common example to illustrate that correlation does not imply causation is that there is a correlation between ice cream sales and violent behavior. If you plotted these data, you’d see that as ice cream sales go up, violent behavior also goes up. These variables are correlated. However, we cannot say that eating more ice cream makes someone commit more violent acts. Nor can we say that violence makes someone eat more ice cream. In this example, the variables are correlated, but a third variable is likely the “cause” of the increase in these variables. That third variable is heat. When it is hot outside, people tend to eat more ice cream. When it is hot outside, we often see rates of violence increase (Anderson, 1989).</p> <p class="import-Normal">However, if you can establish an initial correlation between two variables, this may prompt you to conduct further inferential tests to learn more about the relationship. You may choose research designs that allow you to test cause and effect, ruling out other variables that could have explained or affected the relationship.</p> <h3 class="import-Normal">Example: Correlation Between Forms of Victimization</h3> <p class="import-Normal">To illustrate the hypothesis test and calculate Pearson’s <em>r</em> for a correlation, we will examine the relationship between peer victimization and dating violence victimization among middle school students. A violence prevention practitioner collects data on these forms of violence from nine students. For more on violence prevention programs, see Banyard and Hamby (2022). Both assessments are continuous levels of measurement (i.e., they count the number of incidents for both types of victimization; scores range from 0 to 12 victimization experiences).</p> <h4 class="import-Normal">Step 1: Hypothesis Pair</h4> <p class="import-Normal">For our hypothesis pair, we will be using the Greek letter rho (ρ) to represent the population correlation. Because we are still making inferences, we will be writing our hypothesis pair about the population correlation. Our null hypothesis states that there is no correlation (which is a value of 0); our alternative hypothesis states that the correlation is not equal to 0:</p> <ul><li>Null Hypothesis: ρ = 0.</li> <li>Alternative Hypothesis: ρ ≠ 0.</li> </ul> <p class="import-Normal">This can also be written as follows:</p> <ul><li><em>H</em><sub>0</sub>: ρ = 0.</li> <li><em>H</em><sub>a</sub>: ρ ≠ 0.</li> </ul> <h4 class="import-Normal">Step 2: Setup for the Test</h4> <ul><li>What inferential test are you using? <strong>Correlation (Pearson’s <em>r</em>)</strong> <ul><li>Reasons for selecting this test: <ul><li><strong>Your research question involves examining the association between two continuous variables.</strong></li> <li><strong>You have two continuous variables.</strong></li> </ul> </li> </ul> </li> <li>Set your confidence/alpha: <strong>Confidence = .95, and alpha = .05.</strong></li> </ul> <p class="import-Normal">To find your critical values, you will use Table A.4 in the Appendix.&nbsp; Although you are calculating a correlation value using Pearson’s <em>r</em> test, you are still plotting the critical values and obtained value on a <em>t </em>distribution bell-shaped curve. The center of this distribution is 0, which indicates zero correlation.</p> <p class="import-Normal">To look up your critical values, you will use your sample size (<em>N</em>) or your degrees of freedom (<em>df</em>). You’ll notice that in Table A.4 that both <em>N</em> and <em>df</em> are listed in the first two columns. Because Pearson’s <em>r</em> examines the association between&nbsp;<em>two</em> variables, you will always need take <img src="https://mathjax.library.illinois.edu/latex?latex=TiDigJMgMg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N – 2" title="N – 2" class="latex mathjax" /> to find your degrees of freedom.</p> <p class="import-Normal">In our example, we have nine people in our sample, so we can look up <em>N</em> = 9 or we can look up <em>df</em> = 7.</p> <ul><li>Find critical values: <strong><em>r</em> = ±0.666.</strong></li> </ul> <h4 class="import-Normal">Step 3: Test Statistic Computation</h4> <p class="import-Normal">To find our Pearson’s <em>r</em> (obtained value), we will use the data in Table 18.1. We have two variables, and we assign “<em>x</em>” and “<em>y</em>” to the variables; remember, we are not making causal claims, so you can assign either letter to either variable. The bottom row of Table 18.1 includes some summary information, including the sample size (<em>N</em> = 9), the sum of <em>x</em>, and the sum of <em>y</em>.</p> <table style="height: 400px;"><caption>Table 18.1. Scores for Peer Victimization (<em>x</em>) and Dating Violence (<em>y</em>)</caption> <thead><tr class="shaded" style="height: 28pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 50px; width: 140.297px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Participant</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 50px; width: 200.445px;" scope="col"><p class="import-Normal" style="text-align: center;"><em><strong>x </strong></em></p> <p class="import-Normal" style="text-align: center;">(peer victimization)</p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 50px; width: 200.469px;" scope="col"><p class="import-Normal" style="text-align: center;"><em><strong>y </strong></em></p> <p class="import-Normal" style="text-align: center;">(dating violence)</p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 14.4pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 140.297px;" scope="row"><p class="import-Normal" style="text-align: center;">1</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.445px;"><p class="import-Normal" style="text-align: center;">1</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.469px;"><p class="import-Normal" style="text-align: center;">2</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.4pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 140.297px;" scope="row"><p class="import-Normal" style="text-align: center;">2</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.445px;"><p class="import-Normal" style="text-align: center;">2</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.469px;"><p class="import-Normal" style="text-align: center;">4</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.6pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 140.297px;" scope="row"><p class="import-Normal" style="text-align: center;">3</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.445px;"><p class="import-Normal" style="text-align: center;">3</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.469px;"><p class="import-Normal" style="text-align: center;">3</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.4pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 140.297px;" scope="row"><p class="import-Normal" style="text-align: center;">4</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.445px;"><p class="import-Normal" style="text-align: center;">5</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.469px;"><p class="import-Normal" style="text-align: center;">6</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.6pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 140.297px;" scope="row"><p class="import-Normal" style="text-align: center;">5</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.445px;"><p class="import-Normal" style="text-align: center;">4</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.469px;"><p class="import-Normal" style="text-align: center;">5</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.4pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 140.297px;" scope="row"><p class="import-Normal" style="text-align: center;">6</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.445px;"><p class="import-Normal" style="text-align: center;">5</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.469px;"><p class="import-Normal" style="text-align: center;">7</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.6pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 140.297px;" scope="row"><p class="import-Normal" style="text-align: center;">7</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.445px;"><p class="import-Normal" style="text-align: center;">6</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.469px;"><p class="import-Normal" style="text-align: center;">8</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.4pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 140.297px;" scope="row"><p class="import-Normal" style="text-align: center;">8</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.445px;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.469px;"><p class="import-Normal" style="text-align: center;">9</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.4pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 140.297px;" scope="row"><p class="import-Normal" style="text-align: center;">9</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.445px;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.469px;"><p class="import-Normal" style="text-align: center;">11</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.6pt;"><th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 140.297px;" scope="row"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TiA9IDk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N = 9" title="N = 9" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.445px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHggPSA0Mw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma x = 43" title="\Sigma x = 43" class="latex mathjax" /></p> </td> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 200.469px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHkgPSA1NQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma y = 55" title="\Sigma y = 55" class="latex mathjax" /></p> </td> </tr> </tbody> </table> <p class="import-Normal">Before we go further, we can visualize these data points using a <em>scatterplot graph </em>(see Figure 18.4).&nbsp;This can help us visualize our data and see if there’s a linear relationship that appears in the data. We can then find our obtained value and compare our critical values to decide about the significance of this relationship.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-292" style="width: 700px"><img class="wp-image-1246" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-18.4R-1.png" alt="Scatter plot graph showing peer victimization and dating violence victimization. The data points are starting at bottom left and going towards top right corner. If we drew a line to try capture these data points, the data points would be close to the line." width="700" height="406" title="" /><div class="wp-caption-text">Figure 18.4. Scatterplot graph showing peer victimization and dating violence victimization.</div></div> <p class="import-Normal">Next, we’ll expand our table to get the data we need to calculate our obtained value (see Table 18.2). For each variable (<em>x</em> and <em>y</em>), we’ll include their squared values (<img src="https://mathjax.library.illinois.edu/latex?latex=eF4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x^2" title="x^2" class="latex mathjax" />and <img src="https://mathjax.library.illinois.edu/latex?latex=eV4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y^2" title="y^2" class="latex mathjax" />), as well as a column where we multiply their values together (<img src="https://mathjax.library.illinois.edu/latex?latex=eHk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="xy" title="xy" class="latex mathjax" />). Then, we’ll add to the summary row the sum of <em>x</em>-squared, the sum of <em>y</em>-squared and the sum of the product of <em>x</em> and <em>y.</em></p> <table><caption>Table 18.2. Summary Information for Correlation Example</caption> <thead><tr class="shaded" style="height: 29.45pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Participant</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><em><strong><img src="https://mathjax.library.illinois.edu/latex?latex=eA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x" title="x" class="latex mathjax" /></strong></em></p> <p class="import-Normal" style="text-align: center;">(peer victimization)</p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><b><img src="https://mathjax.library.illinois.edu/latex?latex=eF4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x^2" title="x^2" class="latex mathjax" /></b></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=eQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y" title="y" class="latex mathjax" /></strong></p> <p class="import-Normal" style="text-align: center;">(dating violence)</p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><b><img src="https://mathjax.library.illinois.edu/latex?latex=eV4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y^2" title="y^2" class="latex mathjax" /></b></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=eHk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="xy" title="xy" class="latex mathjax" /></strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">1</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">1</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">1</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">2</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">4</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">2</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">2</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">2</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">4</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">4</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">16</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">8</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.3pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">3</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">3</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">3</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">9</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">4</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">5</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">6</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">36</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">30</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.3pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">5</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">4</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">16</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">5</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">20</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">6</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">5</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">7</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">49</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">35</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.3pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">7</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">6</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">36</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">64</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">48</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">8</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">64</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">81</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">72</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">9</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">81</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">11</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">121</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">99</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.3pt;"><th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;" scope="row"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=TiA9IDk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N = 9" title="N = 9" class="latex mathjax" /></strong></th> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHggPSA0Mw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma x = 43" title="\Sigma x = 43" class="latex mathjax" /></td> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHheMiA9IDI2MQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma x^2 = 261" title="\Sigma x^2 = 261" class="latex mathjax" /></strong></td> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHkgPSA1NQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma y = 55" title="\Sigma y = 55" class="latex mathjax" /></td> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHleMiA9IDQwNQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma y^2 = 405" title="\Sigma y^2 = 405" class="latex mathjax" /></strong></td> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHh5ID0gMzIz&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma xy = 323" title="\Sigma xy = 323" class="latex mathjax" /></td> </tr> </tbody> </table> <p class="import-Normal">Now we have all the data points we need for calculating our obtained value. We will go through three steps to find this value.</p> <div class="textbox shaded"><h5>Formula 18.1. Calculating Pearson’s r</h5> <p><strong>Steps and formulas for calculating the obtained value (Pearson’s <em>r</em>):&nbsp;</strong></p> <ol><li><p class="import-Normal"><strong>Calculate the sum of squares for <img src="https://mathjax.library.illinois.edu/latex?latex=eA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x" title="x" class="latex mathjax" />.</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1NfeCA9IFxzdW0geF4yIC0gXGZyYWN7KFxzdW0geCleMn17Tn0gIFxlbmR7Z2F0aGVyZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_x = \sum x^2 - \frac{(\sum x)^2}{N} \end{gathered}" title="\begin{gathered} SS_x = \sum x^2 - \frac{(\sum x)^2}{N} \end{gathered}" class="latex mathjax" /></p> <p class="import-Normal"><strong>Calculate the sum of squares for <img src="https://mathjax.library.illinois.edu/latex?latex=eQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y" title="y" class="latex mathjax" />.</strong></p> <p class="import-Normal" style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1NfeSA9IFxzdW0geV4yIC0gXGZyYWN7KFxzdW0geSleMn17Tn0gIFxlbmR7Z2F0aGVyZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_y = \sum y^2 - \frac{(\sum y)^2}{N} \end{gathered}" title="\begin{gathered} SS_y = \sum y^2 - \frac{(\sum y)^2}{N} \end{gathered}" class="latex mathjax" /></p> </li> <li><strong>Calculate the sum of the products for <em>x</em> and <em>y</em> (<img src="https://mathjax.library.illinois.edu/latex?latex=U1Bfe3h5fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SP_{xy}" title="SP_{xy}" class="latex mathjax" />), which shows you the amount of covariance.</strong> <p class="import-Normal" style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1Bfe3h5fSA9IFxzdW0geHkgLSBcZnJhY3soXHN1bSB4KShcc3VtIHkpfXtOfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SP_{xy} = \sum xy - \frac{(\sum x)(\sum y)}{N}" title="SP_{xy} = \sum xy - \frac{(\sum x)(\sum y)}{N}" class="latex mathjax" /></p> </li> <li><strong>Calculate the <img src="https://mathjax.library.illinois.edu/latex?latex=cg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r" title="r" class="latex mathjax" /> (the obtained value), using the values you found in Steps 1 and 2.</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=ciA9IFxmcmFje1NQX3t4eX19e1xzcXJ0eyhTU194KShTU195KX19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r = \frac{SP_{xy}}{\sqrt{(SS_x)(SS_y)}}" title="r = \frac{SP_{xy}}{\sqrt{(SS_x)(SS_y)}}" class="latex mathjax" /></li> </ol> </div> <p class="import-Normal">The following example works through the steps with our data.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 18.1. Calculating Sum of Squares, Sum of Products, and Obtained Value for Correlation</h5> </div> <div class="textbox__content"><p><strong>Steps and formulas for calculating obtained value (Pearson’s <em>r</em>):&nbsp;</strong></p> <ol><li><p class="import-Normal"><strong>Calculate the sum of squares for <img src="https://mathjax.library.illinois.edu/latex?latex=eA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x" title="x" class="latex mathjax" />.</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1NfeCA9IFxzdW0geF4yIC0gXGZyYWN7KFxzdW0geCleMn17Tn0gIFxlbmR7Z2F0aGVyZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_x = \sum x^2 - \frac{(\sum x)^2}{N} \end{gathered}" title="\begin{gathered} SS_x = \sum x^2 - \frac{(\sum x)^2}{N} \end{gathered}" class="latex mathjax" /></p> <p class="import-Normal"><strong>Calculate the sum of squares for <img src="https://mathjax.library.illinois.edu/latex?latex=eQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y" title="y" class="latex mathjax" />.</strong></p> <p class="import-Normal" style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1NfeSA9IFxzdW0geV4yIC0gXGZyYWN7KFxzdW0geSleMn17Tn0gIFxlbmR7Z2F0aGVyZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_y = \sum y^2 - \frac{(\sum y)^2}{N} \end{gathered}" title="\begin{gathered} SS_y = \sum y^2 - \frac{(\sum y)^2}{N} \end{gathered}" class="latex mathjax" /></p> </li> <li><strong>Calculate the sum of the products for <em>x</em> and <em>y</em> (<img src="https://mathjax.library.illinois.edu/latex?latex=U1Bfe3h5fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SP_{xy}" title="SP_{xy}" class="latex mathjax" />), which shows you the amount of covariance. </strong> <p class="import-Normal" style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1Bfe3h5fSA9IFxzdW0geHkgLSBcZnJhY3soXHN1bSB4KShcc3VtIHkpfXtOfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SP_{xy} = \sum xy - \frac{(\sum x)(\sum y)}{N}" title="SP_{xy} = \sum xy - \frac{(\sum x)(\sum y)}{N}" class="latex mathjax" /></p> </li> <li><strong>Calculate <img src="https://mathjax.library.illinois.edu/latex?latex=cg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r" title="r" class="latex mathjax" /> (the obtained value), using the values you found in Steps 1 and 2.</strong>&nbsp;<img src="https://mathjax.library.illinois.edu/latex?latex=ciA9IFxmcmFje1NQX3t4eX19e1xzcXJ0eyhTU194KShTU195KX19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r = \frac{SP_{xy}}{\sqrt{(SS_x)(SS_y)}}" title="r = \frac{SP_{xy}}{\sqrt{(SS_x)(SS_y)}}" class="latex mathjax" /></li> </ol> <p>Our example:</p> <ol><li><p class="import-Normal"><strong>Calculate the sum of squares for <img src="https://mathjax.library.illinois.edu/latex?latex=eA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x" title="x" class="latex mathjax" />.</strong></p> <p class="import-Normal"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1NfeCA9IDI2MSAtIFxmcmFjeyg0MyleMn17OX0gXFwgIFx0ZXh0YmZ7U1N9X3tcdGV4dGJme3h9fSA9IFx0ZXh0YmZ7NTUuNTZ9IFxcICBcZW5ke2dhdGhlcmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_x = 261 - \frac{(43)^2}{9} \\ \textbf{SS}_{\textbf{x}} = \textbf{55.56} \\ \end{gathered}" title="\begin{gathered} SS_x = 261 - \frac{(43)^2}{9} \\ \textbf{SS}_{\textbf{x}} = \textbf{55.56} \\ \end{gathered}" class="latex mathjax" /></p> <p class="import-Normal"><strong>Calculate the sum of squares for <img src="https://mathjax.library.illinois.edu/latex?latex=eQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y" title="y" class="latex mathjax" />.</strong></p> <p class="import-Normal" style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1NfeSA9IDQwNSAtIFxmcmFjeyg1NSleMn17OX0gXFwgIFx0ZXh0YmZ7U1N9X3tcdGV4dGJme3l9fSA9IFx0ZXh0YmZ7NjguODl9ICBcZW5ke2dhdGhlcmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_y = 405 - \frac{(55)^2}{9} \\ \textbf{SS}_{\textbf{y}} = \textbf{68.89} \end{gathered}" title="\begin{gathered} SS_y = 405 - \frac{(55)^2}{9} \\ \textbf{SS}_{\textbf{y}} = \textbf{68.89} \end{gathered}" class="latex mathjax" /></p> </li> <li><strong>Calculate the sum of the products for <em>x</em> and <em>y</em> (<img src="https://mathjax.library.illinois.edu/latex?latex=U1Bfe3h5fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SP_{xy}" title="SP_{xy}" class="latex mathjax" />), which shows you the amount of covariance.<br /> </strong><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1Bfe3h5fSA9IDMyMyAtIFxmcmFjeyg0MykoNTUpfXs5fSBcXCAgXHRleHRiZntTUH1fe1x0ZXh0YmZ7eHl9fSA9IFx0ZXh0YmZ7NjAuMjJ9ICBcZW5ke2dhdGhlcmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SP_{xy} = 323 - \frac{(43)(55)}{9} \\ \textbf{SP}_{\textbf{xy}} = \textbf{60.22} \end{gathered}" title="\begin{gathered} SP_{xy} = 323 - \frac{(43)(55)}{9} \\ \textbf{SP}_{\textbf{xy}} = \textbf{60.22} \end{gathered}" class="latex mathjax" /></li> <li><strong>Calculate <img src="https://mathjax.library.illinois.edu/latex?latex=cg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r" title="r" class="latex mathjax" /> (the obtained value), using the values you found in Steps 1 and 2:</strong> <img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2FsaWduZWR9ICByICY9IFxmcmFjezYwLjIyfXtcc3FydHsoNTUuNTYpKDY4Ljg5KX19IFxcICByICY9IFxmcmFjezYwLjIyfXtcc3FydHszODI3LjUzfX0gXFwgIHIgJj0gXGZyYWN7NjAuMjJ9ezYxLjg3fSBcXCAgciAmPSBcdGV4dGJmezAuOTd9ICBcZW5ke2FsaWduZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{aligned} r &amp;amp;= \frac{60.22}{\sqrt{(55.56)(68.89)}} \\ r &amp;amp;= \frac{60.22}{\sqrt{3827.53}} \\ r &amp;amp;= \frac{60.22}{61.87} \\ r &amp;amp;= \textbf{0.97} \end{aligned}" title="\begin{aligned} r &amp;amp;= \frac{60.22}{\sqrt{(55.56)(68.89)}} \\ r &amp;amp;= \frac{60.22}{\sqrt{3827.53}} \\ r &amp;amp;= \frac{60.22}{61.87} \\ r &amp;amp;= \textbf{0.97} \end{aligned}" class="latex mathjax" /></li> </ol> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">So, in our example, <em>r</em> = 0.97, which is our obtained value. We’ll plot this data point on our distribution and examine it in relation to our critical values.</span></p> <p class="import-Normal">We can also describe our correlation based on this Pearson’s <em>r</em>. First, it is a positive number, so we have a positive correlation. This means that as one variable increases, the other variable increases; the variables are moving in the same direction. Second, it is closer to 1 than to 0. This tells about the magnitude of the association. An <em>r</em> of 0.97 is very close to 1.00, so the linear relationship is strong; if we impose a line on a scatterplot of the data, the data points are very close to that line, as shown in Figure 18.5.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-292" style="width: 700px"><img class="wp-image-1247" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-18.5R-1.png" alt="The same scatter plot from 18.4 is shown, but now there is a line drawn. Each of the data points are close to that line, illustrating this example has a strong positive correlation." width="700" height="406" title="" /><div class="wp-caption-text">Figure 18.5. Scatterplot graph showing peer victimization and dating violence victimization with a line imposed.</div></div> <h4 class="import-Normal">Step 4: Make a Decision</h4> <p class="import-Normal">Based on this example, you would then make a decision to reject or fail to reject the null hypothesis. In this example, you would <strong>reject the null</strong> hypothesis. Your obtained value (<em>r</em> = .97) exceeds the critical value (±0.666) and is in the alpha area (see Figure 18.6). This means that there is a significant (and positive) correlation between peer victimization and dating violence victimization.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-292" style="width: 700px"><img class="wp-image-1248" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-18.6R-1.png" alt="Distribution is shown with critical values shown (-.666 and .666) which separate the alpha and confidence areas. The obtained value of .97 is shown in the alpha area." width="700" height="383" title="" /><div class="wp-caption-text">Figure 18.6. Distribution with critical values shown, as well as the obtained value of .97.</div></div> <h4 class="import-Normal">APA-Style Write-Up</h4> <p class="import-Normal">The American Psychological Association ([APA], 2020)-style statement for a correlation test includes whether you have a significant correlation or not, the direction of that relationship (positive or negative), the Pearson’s <em>r</em> value and <em>p </em>statement<em>.</em> Because we rejected the null hypothesis and we have a significant correlation, we would write “<em>p</em> &lt; .05”:</p> <p class="import-Normal" style="padding-left: 40px;">There was a statistically significant positive relationship between peer victimization and dating violence victimization, <em>r</em> = .97, <em>p</em> &lt; .05.</p> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">Correlation using Pearson’s r can give you information about the relationship between two variables; it can be negative, positive, or zero, and it can also give you information about magnitude (i.e., there is a stronger correlation the closer you are to –1 or 1). Correlation does not imply causation; it simply assesses how the two variables move together.</p> </div> 
	</div>
			
				
				
	</div>
<div class="chapter standard " id="chapter-chapter-19-linear-regression" title="Chapter 19: Linear Regression">
	<div class="chapter-title-wrap">
		<p class="chapter-number">39</p>
		<h1 class="chapter-title">Chapter 19: Linear Regression</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-19:-linear-regression"><p class="import-Normal">In the previous chapter, you saw how to calculate the Pearson’s <em>r</em> correlation hypothesis test. If you have a significant correlation, then you may want to examine that relationship further. Remember, correlation does not imply causation; you simply know there is a relationship between the two variables. So, you may want to <em>move from describing a relationship to something more predictive</em>. For example, you may have a hypothesis about which of these variables is your independent variable (predictor) and which is your dependent variable (outcome).</p> <h2 class="import-Normal">Linear Regression</h2> <p class="import-Normal">The goal of <strong><em><span class="glossary-term">linear regression</span></em></strong> is to make a prediction, using the line equation (<img src="https://mathjax.library.illinois.edu/latex?latex=eSA9IG14ICsgYg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y = mx + b" title="y = mx + b" class="latex mathjax" />). So, if we know something about <em>x</em> (the predictor), we can then estimate the value of <em>y</em> (the outcome). You will be estimating a line to help in making these predictive estimates. You will be estimating a line that best fits your data points.</p> <p class="import-Normal">We will be examining linear regression with two continuous variables; however, regression analyses can be expanded in different ways (e.g., multiple linear regression allows you to examine two or more independent variables to predict a single dependent variable; logistic regression allows you to examine prediction with a binary dependent variable).</p> <h3 class="import-Normal">Example: Relationship Between Childhood Stressors and Anxiety</h3> <p class="import-Normal">Our example for this chapter will look at the relationship between childhood stressors and symptoms of anxiety. Assume you are a social work PhD student who is interested in the following research question: Do childhood stressors (<img src="https://mathjax.library.illinois.edu/latex?latex=eA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x" title="x" class="latex mathjax" />) predict symptoms of anxiety (<img src="https://mathjax.library.illinois.edu/latex?latex=eQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y" title="y" class="latex mathjax" />)? To measure these variables, you find an assessment of childhood stressors with scores that range from 0 to 10 and an assessment of anxiety with scores that ranges from 0 (no symptoms of anxiety) to 25 (high symptoms of anxiety). Both variables are continuous levels of measurement. The independent variable is childhood stressors, and the dependent variable is anxiety. You collect data from a sample of 10 children. Before you can conduct a linear regression, a significant correlation must be established.</p> <h4 class="import-Normal">Step 1: Hypothesis Pair</h4> <ul><li>Null hypothesis: ρ = 0.</li> <li>Alternative hypothesis: ρ ≠ 0.</li> </ul> <p class="import-Normal">This can also be written as follows:</p> <ul><li><em>H</em><sub>0</sub>: ρ = 0.</li> <li><em>H</em><sub>a</sub>: ρ ≠ 0.</li> </ul> <h4 class="import-Normal">Step 2: Setup for the Test</h4> <ul><li>What inferential test are you using? <strong>Correlation (Pearson’s <em>r</em>)</strong> <ul><li>Reasons for selecting this test: <ul><li>Your research question involves examining the association between two continuous variables.</li> <li>You have two continuous variables.</li> </ul> </li> </ul> </li> <li>Set your confidence/alpha: <strong>Confidence = .95, and alpha = .05.</strong></li> </ul> <p>We have 10 people in our sample, so to find our critical values, we can look up <em>N</em> = 10 or <em>df</em> = 8 in Table A.5 in the Appendix.</p> <ul><li>Critical values:<strong><em>r</em><sub>c</sub> = ±</strong><strong>0.</strong><strong>632.&nbsp;</strong></li> </ul> <h4 class="import-Normal">Step 3: Test Statistic Computation</h4> <p class="import-Normal">Our data and the descriptive statistics we need for calculating Pearson’s <em>r&nbsp;</em>are shown in Table 19.1.</p> <table class="grid" style="width: 1055px;"><caption>Table 19.1. Summary Information for Correlation Example</caption> <thead><tr class="shaded" style="height: 29.45pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Participant</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=eA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x" title="x" class="latex mathjax" /></strong></p> <p class="import-Normal" style="text-align: center;">(childhood stressors)</p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;" scope="col"><p class="import-Normal" style="text-align: center;"><b><img src="https://mathjax.library.illinois.edu/latex?latex=eF4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x^2" title="x^2" class="latex mathjax" /></b></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=eQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y" title="y" class="latex mathjax" /></strong></p> <p class="import-Normal" style="text-align: center;">(anxiety)</p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;" scope="col"><p class="import-Normal" style="text-align: center;"><b><img src="https://mathjax.library.illinois.edu/latex?latex=eV4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y^2" title="y^2" class="latex mathjax" /></b></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=eHk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="xy" title="xy" class="latex mathjax" /></strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="row"><p class="import-Normal" style="text-align: center;">1</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;">100</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;">23</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;">529</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;">230</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="row"><p class="import-Normal" style="text-align: center;">2</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;">64</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;">20</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;">400</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;">160</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.3pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="row"><p class="import-Normal" style="text-align: center;">3</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;">81</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;">20</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;">400</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;">180</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="row"><p class="import-Normal" style="text-align: center;">4</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;">5</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;">16</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;">256</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;">80</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.3pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="row"><p class="import-Normal" style="text-align: center;">5</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;">7</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;">49</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;">17</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;">289</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;">119</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="row"><p class="import-Normal" style="text-align: center;">6</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;">6</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;">36</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;">15</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;">225</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;">90</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.3pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="row"><p class="import-Normal" style="text-align: center;">7</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;">5</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;">18</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;">324</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;">90</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="row"><p class="import-Normal" style="text-align: center;">8</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;">3</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;">13</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;">169</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;">39</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="row"><p class="import-Normal" style="text-align: center;">9</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;">4</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;">16</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;">16</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;">256</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;">64</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.15pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.562px;" scope="row"><p class="import-Normal" style="text-align: center;">10</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;">2</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;">4</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;">12</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;">144</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;">24</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.3pt;"><th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; text-align: center; width: 120.562px;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=TiA9IDEw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N = 10" title="N = 10" class="latex mathjax" /></th> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 147.438px;"><p class="import-Normal" style="text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHggPSA1OQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma x = 59" title="\Sigma x = 59" class="latex mathjax" /></strong></p> </td> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 180.672px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHheMiA9IDQwOQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma x^2 = 409" title="\Sigma x^2 = 409" class="latex mathjax" /></p> </td> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 158.078px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHnCoD0gMTcw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma y&nbsp;= 170" title="\Sigma y&nbsp;= 170" class="latex mathjax" /></p> </td> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 178.391px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHleMiA9IDI5OTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma y^2 = 2992" title="\Sigma y^2 = 2992" class="latex mathjax" /></p> </td> <td class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 172.297px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XFNpZ21hIHh5ID0gMTA3Ng&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\Sigma xy = 1076" title="\Sigma xy = 1076" class="latex mathjax" /></p> </td> </tr> </tbody> </table> <div class="textbox textbox--examples"><div class="textbox__header"><h5 class="textbox__title">Example 19.1. Calculating Pearson’s <em>r</em></h5> </div> <div class="textbox__content"><p><strong>Steps and formulas for calculating the obtained value (Pearson’s <em>r</em>):&nbsp;</strong></p> <ol><li><p class="import-Normal"><strong>Calculate the sum of squares for <img src="https://mathjax.library.illinois.edu/latex?latex=eA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x" title="x" class="latex mathjax" />.</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1NfeCA9IFxzdW0geF4yIC0gXGZyYWN7KFxzdW0geCleMn17Tn0gXFwgIFxlbmR7Z2F0aGVyZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_x = \sum x^2 - \frac{(\sum x)^2}{N} \\ \end{gathered}" title="\begin{gathered} SS_x = \sum x^2 - \frac{(\sum x)^2}{N} \\ \end{gathered}" class="latex mathjax" /></p> <p class="import-Normal"><strong>Calculate the sum of squares for <img src="https://mathjax.library.illinois.edu/latex?latex=eQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y" title="y" class="latex mathjax" />.</strong></p> <p class="import-Normal" style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1NfeSA9IFxzdW0geV4yIC0gXGZyYWN7KFxzdW0geSleMn17Tn0gIFxlbmR7Z2F0aGVyZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_y = \sum y^2 - \frac{(\sum y)^2}{N} \end{gathered}" title="\begin{gathered} SS_y = \sum y^2 - \frac{(\sum y)^2}{N} \end{gathered}" class="latex mathjax" /></p> </li> <li><strong>Calculate the sum of the products for <em>x</em> and <em>y</em> (<img src="https://mathjax.library.illinois.edu/latex?latex=U1Bfe3h5fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SP_{xy}" title="SP_{xy}" class="latex mathjax" />), which shows you the amount of covariance.</strong></li> </ol> <p style="padding-left: 40px;"><img src="https://mathjax.library.illinois.edu/latex?latex=U1Bfe3h5fSA9IFxzdW0geHkgLSBcZnJhY3soXHN1bSB4KShcc3VtIHkpfXtOfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SP_{xy} = \sum xy - \frac{(\sum x)(\sum y)}{N}" title="SP_{xy} = \sum xy - \frac{(\sum x)(\sum y)}{N}" class="latex mathjax" /></p> <p style="padding-left: 40px;">3. <strong>Calculate <img src="https://mathjax.library.illinois.edu/latex?latex=cg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r" title="r" class="latex mathjax" /> (the obtained value), using the values you found in Steps 1 and 2.</strong></p> <p style="padding-left: 40px;"><img src="https://mathjax.library.illinois.edu/latex?latex=ciA9IFxmcmFje1NQX3t4eX19e1xzcXJ0eyhTU194KShTU195KX19&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r = \frac{SP_{xy}}{\sqrt{(SS_x)(SS_y)}}" title="r = \frac{SP_{xy}}{\sqrt{(SS_x)(SS_y)}}" class="latex mathjax" /></p> <p>Our example:</p> <ol><li><p class="import-Normal"><strong>Calculate the sum of squares for <img src="https://mathjax.library.illinois.edu/latex?latex=eA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x" title="x" class="latex mathjax" />.</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1NfeCA9IDQwOSAtIFxmcmFjeyg1OSleMn17MTB9IFxcICBcdGV4dGJme1NTfV97XHRleHRiZnt4fX0gPSBcdGV4dGJmezYwLjl9IFxcICBcZW5ke2dhdGhlcmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_x = 409 - \frac{(59)^2}{10} \\ \textbf{SS}_{\textbf{x}} = \textbf{60.9} \\ \end{gathered}" title="\begin{gathered} SS_x = 409 - \frac{(59)^2}{10} \\ \textbf{SS}_{\textbf{x}} = \textbf{60.9} \\ \end{gathered}" class="latex mathjax" /></p> <p class="import-Normal"><strong>Calculate the sum of squares for <img src="https://mathjax.library.illinois.edu/latex?latex=eQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y" title="y" class="latex mathjax" />.</strong></p> <p class="import-Normal" style="text-align: left;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1NfeSA9IDI5OTIgLSBcZnJhY3soMTcwKV4yfXsxMH0gXFwgIFx0ZXh0YmZ7U1N9X3tcdGV4dGJme3l9fSA9IFx0ZXh0YmZ7MTAyfSAgXGVuZHtnYXRoZXJlZH0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SS_y = 2992 - \frac{(170)^2}{10} \\ \textbf{SS}_{\textbf{y}} = \textbf{102} \end{gathered}" title="\begin{gathered} SS_y = 2992 - \frac{(170)^2}{10} \\ \textbf{SS}_{\textbf{y}} = \textbf{102} \end{gathered}" class="latex mathjax" /></p> </li> <li><strong>Calculate the sum of the products for <em>x</em> and <em>y</em> (<img src="https://mathjax.library.illinois.edu/latex?latex=U1Bfe3h5fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SP_{xy}" title="SP_{xy}" class="latex mathjax" />), which shows you the amount of covariance.</strong></li> </ol> <p style="padding-left: 40px;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2dhdGhlcmVkfSAgU1Bfe3h5fSA9IDEwNzYgLSBcZnJhY3soNTkpKDE3MCl9ezEwfSBcXCAgXHRleHRiZntTUH1fe1x0ZXh0YmZ7eHl9fSA9IFx0ZXh0YmZ7NzN9ICBcZW5ke2dhdGhlcmVkfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{gathered} SP_{xy} = 1076 - \frac{(59)(170)}{10} \\ \textbf{SP}_{\textbf{xy}} = \textbf{73} \end{gathered}" title="\begin{gathered} SP_{xy} = 1076 - \frac{(59)(170)}{10} \\ \textbf{SP}_{\textbf{xy}} = \textbf{73} \end{gathered}" class="latex mathjax" /></p> <p style="padding-left: 40px;">3. <strong>Calculate <img src="https://mathjax.library.illinois.edu/latex?latex=cg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r" title="r" class="latex mathjax" /> (the obtained value), using the values you found in Steps 1 and 2.</strong></p> <p style="padding-left: 40px;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJlZ2lue2FsaWduZWR9ICByICY9IFxmcmFjezczfXtcc3FydHsoNjAuOTApKDEwMil9fSBcXCAgciAmPSBcZnJhY3s3M317XHNxcnR7NjIxMS44fX0gXFwgIHIgJj0gXGZyYWN7NzN9ezc4LjgxfSBcXCAgciAmPSBcdGV4dGJmezAuOTN9ICBcZW5ke2FsaWduZWR9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\begin{aligned} r &amp;amp;= \frac{73}{\sqrt{(60.90)(102)}} \\ r &amp;amp;= \frac{73}{\sqrt{6211.8}} \\ r &amp;amp;= \frac{73}{78.81} \\ r &amp;amp;= \textbf{0.93} \end{aligned}" title="\begin{aligned} r &amp;amp;= \frac{73}{\sqrt{(60.90)(102)}} \\ r &amp;amp;= \frac{73}{\sqrt{6211.8}} \\ r &amp;amp;= \frac{73}{78.81} \\ r &amp;amp;= \textbf{0.93} \end{aligned}" class="latex mathjax" /></p> </div> </div> <p class="import-Normal">So, in our example, <em>r</em> = 0.93, which is our obtained value. We’ll plot this data point on our distribution (see Figure 19.1) and examine it in relation to our critical values.</p> <div class="wp-caption aligncenter" id="attachment_300" aria-describedby="caption-attachment-300" style="width: 700px"><img class="wp-image-300" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-19.1R-1024x560.png" alt="Distribution is shown with critical values (-.632 and .632) to separate confidence and alpha areas. The obtained value (.93) is shown in the alpha area." width="700" height="383" srcset="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-19.1R-1024x560.png 1024w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-19.1R-300x164.png 300w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-19.1R-768x420.png 768w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-19.1R-1536x841.png 1536w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-19.1R-65x36.png 65w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-19.1R-225x123.png 225w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-19.1R-350x192.png 350w, https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2025/10/Figure-19.1R.png 1650w" sizes="auto, (max-width: 700px) 100vw, 700px" title="" /><div class="wp-caption-text" id="caption-attachment-300">Figure 19.1. Distribution showing <em>r</em> critical values and obtained value.</div></div> <p class="import-Normal">We can also describe our correlation based on this Pearson’s <em>r</em> value. First, it is a positive number, so we have a positive correlation. This means that as one variable increases, the other variable increases; the variables are moving in the same direction. Second, it is closer to 1 than to 0. This tells about the magnitude of the association. An <em>r</em> of 0.93 is very close to 1.00, so the linear relationship is strong; if we impose a line on a scatterplot of the data, the data points are very close to that line, as shown in Figure 19.2.</p> <div class="wp-caption aligncenter" aria-describedby="caption-attachment-300" style="width: 700px"><img class="wp-image-1251" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-19.2R-1.png" alt="Scatter plot graph between childhood stressors and anxiety symptoms; the data points go from the bottom left to top right. There is a line superimposed and the data points are close to the line." width="700" height="429" title="" /><div class="wp-caption-text">Figure 19.2. Scatterplot graph between childhood stressors and anxiety symptoms, with a line superimposed.</div></div> <h4 class="import-Normal">Step 4: Make a Decision</h4> <p class="import-Normal">Based on this example, you would then make a decision to reject or fail to reject the null hypothesis. In this example, you would <strong>reject the null hypothesis</strong>. Your obtained value exceeds the critical value (0.632) and is in the alpha area. This means that there is a significant (and positive) correlation between childhood stressors and anxiety.</p> <h4 class="import-Normal">APA-Style Write-up</h4> <p>The American Psychological Association ([APA], 2020)-style write-up would be as follows:</p> <p class="import-Normal" style="padding-left: 40px;">There was a statistically significant positive relationship between childhood stressors and anxiety, <em>r</em> = .93, <em>p</em> &lt; .05.</p> <h2 class="import-Normal">Moving From Correlation to Regression</h2> <p class="import-Normal">Now that we have established a significant relationship between these variables, we can use regression to make a prediction. We will estimate a line that best minimizes errors of prediction, which are called <em>residuals</em>. The <strong><em><span class="glossary-term">residual</span></em></strong> is the distance between the estimated line and each data point.</p> <p class="import-Normal">In algebra, we use <img src="https://mathjax.library.illinois.edu/latex?latex=eSA9IG14ICsgYg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y = mx + b" title="y = mx + b" class="latex mathjax" /> as our <em>linear equation</em>. Because we are now estimating a line, in the world of inferential statistics (with inherent room for error), we will use different linear equation notation, as presented in Table 19.2.</p> <table style="width: 472.7pt; height: 447px;"><caption>Table 19.2. Linear Equation Components and Descriptions</caption> <thead><tr class="shaded" style="height: 14.55pt;"><th style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 154.375px; height: 72px;" scope="col"><p class="import-Normal"><strong>Linear Equation and Components of Equation</strong></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 442.703px; height: 72px;" scope="col"><p class="import-Normal"><strong>Description</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 29.6pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 154.375px; height: 53px;" scope="row"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IGEgKyBieA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = a + bx" title="\hat{y} = a + bx" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 442.703px; height: 53px;"><p class="import-Normal">Linear equation</p> </td> </tr> <tr class="TableGrid-R" style="height: 23.5pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 154.375px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y}" title="\hat{y}" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 442.703px; height: 35px;"><p class="import-Normal">(“y-hat”) Predicted value of your outcome</p> </td> </tr> <tr class="TableGrid-R" style="height: 28.35pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 154.375px; height: 53px;" scope="row"><p class="import-Normal" style="text-align: center;"><span style="font-size: NaNpt; color: #; text-decoration: none;"><img src="https://mathjax.library.illinois.edu/latex?latex=YQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="a" title="a" class="latex mathjax" /></span></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 442.703px; height: 53px;"><p class="import-Normal">Estimated <em><strong><span class="glossary-term">y-intercept</span></strong></em>, which is the predicted value of <em>y</em> when <em>x</em> is equal to 0 (i.e., when the line crosses the <em>y</em>-axis).</p> </td> </tr> <tr class="TableGrid-R" style="height: 115.9pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 154.375px; height: 181px;" scope="row"><p class="import-Normal" style="text-align: center;"><span style="font-size: NaNpt; color: #; text-decoration: none;"><img src="https://mathjax.library.illinois.edu/latex?latex=Yg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="b" title="b" class="latex mathjax" /></span></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 442.703px; height: 181px;"><p class="import-Normal">Estimated <em><strong><span class="glossary-term">slope</span>,</strong></em> which represents the average change in <em>y</em> for every 1-unit increase in <em>x</em>. You may see the slope called the <em>rate of change</em> or described as the <em>rise over run</em> (i.e., how much the line goes up or down, and how much the line moves horizontally).</p> <p class="import-Normal">In statistics, you may also see this referred to as your <em>regression coefficient</em>, which quantifies the direction and magnitude of the relationship between the independent and the dependent variable.</p> </td> </tr> <tr class="TableGrid-R" style="height: 13.75pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 154.375px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;"><span style="font-size: NaNpt; color: #; text-decoration: none;"><img src="https://mathjax.library.illinois.edu/latex?latex=eA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x" title="x" class="latex mathjax" /></span></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; width: 442.703px; height: 35px;"><p class="import-Normal">The predictor variable (independent variable) value.</p> </td> </tr> </tbody> </table> <p class="import-Normal">There are also some additional formulas you’ll need to calculate these components of the linear equation, as described next.</p> <div class="textbox shaded"><h3>Formula 19.1. Calculating Slope and y-Intercept</h3> <p><strong>Slope formula and description:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=YiA9IFxmcmFje1NQX3t4eX19e1NTX3h9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="b = \frac{SP_{xy}}{SS_x}" title="b = \frac{SP_{xy}}{SS_x}" class="latex mathjax" /></p> <p>Slope: The slope uses the sum of products of <em>x</em> and <em>y</em> (which you estimated in Part 2 of the Pearson’s <em>r</em> calculations) and the sum of squares for <em>x</em> (your predictor variable; you estimated this in Part 1 of the Pearson’s <em>r</em> calculations).</p> <p><strong>y-intercept formula and description:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=YSA9IFxiYXJ7eX0gLSAoYilcYmFye3h9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="a = \bar{y} - (b)\bar{x}" title="a = \bar{y} - (b)\bar{x}" class="latex mathjax" /></p> <p><em>y</em>-intercept: The <em>y</em>-intercept uses the mean of <em>y</em> (<span style="font-size: NaNpt; color: #; text-decoration: none;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt5fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{y}" title="\bar{y}" class="latex mathjax" />) </span>and the mean of <em>x</em> (<img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x}" title="\bar{x}" class="latex mathjax" /><span style="font-size: NaNpt; color: #; text-decoration: none;">), </span>as well as your slope estimate.</p> </div> <p class="import-Normal">Table 19.3 presents all the summary information needed for our example.</p> <table style="width: 738px; height: 509px;"><caption>Table 19.3. Summary Information for Example</caption> <thead><tr class="shaded" style="height: 15.3pt;"><th class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; height: 35px; width: 154.641px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Data</strong></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; height: 35px; width: 550.172px;" scope="col"><p class="import-Normal"><strong>Description (and where the value is found or calculated)</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 14.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 154.641px;" scope="row"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=TiA9IDEw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="N = 10" title="N = 10" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 550.172px;"><p class="import-Normal">Total number of people in the sample</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.3pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4ID0gNTk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x = 59" title="\sum x = 59" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 550.172px;"><p class="import-Normal">Sum of <em>x</em> variable values (found in summary table)</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4XjIgPSA0MDk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum x^2 = 409" title="\sum x^2 = 409" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 550.172px;"><p class="import-Normal">Sum of <em>x</em> variable values squared (found in summary table)</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.3pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 53px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt4fSA9IDUuOQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{x} = 5.9" title="\bar{x} = 5.9" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 53px; width: 550.172px;"><p class="import-Normal">Mean of <em>x</em> (found by taking the sum of <em>x </em>and dividing by <em>N</em>; 59/10 = 5.9)</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB5ID0gMTcw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum y = 170" title="\sum y = 170" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 550.172px;"><p class="import-Normal">Sum of <em>y</em> variable values (found in summary table)</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.3pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB5XjIgPSAyOTky&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum y^2 = 2992" title="\sum y^2 = 2992" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 550.172px;"><p class="import-Normal">Sum of <em>y</em> variable values squared (found in summary table)</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.3pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 53px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=XGJhcnt5fSA9IDE3LjA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\bar{y} = 17.0" title="\bar{y} = 17.0" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 53px; width: 550.172px;"><p class="import-Normal">Mean of <em>y</em> (found by taking the sum of <em>y </em>and dividing by <em>N</em>; 170/10 = 17.0)</p> </td> </tr> <tr class="TableGrid-R" style="height: 14.45pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=XHN1bSB4eSA9IDEwNzY&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\sum xy = 1076" title="\sum xy = 1076" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 550.172px;"><p class="import-Normal">Sum of the product of <em>x</em> and <em>y</em> (found in summary table)</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.3pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfeCA9IDYwLjk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_x = 60.9" title="SS_x = 60.9" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 550.172px;"><p class="import-Normal">Sum of squares for <em>x</em> (found in Part 1 of Pearson’s <em>r</em> calculations)</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.3pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=U1NfeSA9IDEwMg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SS_y = 102" title="SS_y = 102" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 550.172px;"><p class="import-Normal">Sum of squares for <em>y</em> (found in Part 1 of Pearson’s <em>r</em> calculations)</p> </td> </tr> <tr class="TableGrid-R" style="height: 16.15pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=U1Bfe3h5fSA9IDcz&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="SP_{xy} = 73" title="SP_{xy} = 73" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 550.172px;"><p class="import-Normal">Sum of products of <em>x</em> and <em>y</em> (found in Part 2 of Pearson’s <em>r</em> calculations)</p> </td> </tr> <tr class="TableGrid-R" style="height: 15.3pt;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 154.641px; text-align: center;" scope="row"><img src="https://mathjax.library.illinois.edu/latex?latex=ciA9IDAuOTM&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r = 0.93" title="r = 0.93" class="latex mathjax" /></th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 550.172px;"><p class="import-Normal">Pearson’s <em>r</em> (found in Part 3 of Pearson’s <em>r</em> calculations)</p> </td> </tr> </tbody> </table> <p class="import-Normal">First, let’s find our slope and <em>y</em>-intercept.</p> <div class="textbox textbox--examples"><div class="textbox__header"><h3 class="textbox__title">Example 19.2. Calculating Slope and <em>y</em>-intercept, With Interpretations</h3> </div> <div class="textbox__content"><p><strong>Slope formula and description:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=YiA9IFxmcmFje1NQX3t4eX19e1NTX3h9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="b = \frac{SP_{xy}}{SS_x}" title="b = \frac{SP_{xy}}{SS_x}" class="latex mathjax" /></p> <p><strong><em>y</em>-Intercept formula and description:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=YSA9IFxiYXJ7eX0gLSAoYilcYmFye3h9&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="a = \bar{y} - (b)\bar{x}" title="a = \bar{y} - (b)\bar{x}" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><strong>Slope:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=YiA9IFxmcmFjezczfXs2MC45fT0xLjIw&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="b = \frac{73}{60.9}=1.20" title="b = \frac{73}{60.9}=1.20" class="latex mathjax" /></p> <p>For every 1-unit increase in childhood stressors, you would predict an estimated 1.20 increase in the anxiety score.</p> <p><strong><em>y</em>-intercept:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=YSA9IDE3LjAgLSAoMS4yMCk1Ljk9OS45Mg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="a = 17.0 - (1.20)5.9=9.92" title="a = 17.0 - (1.20)5.9=9.92" class="latex mathjax" /></p> <p>When the number of childhood stressors equals zero, your <em>y </em>value is predicted to be 9.92. This is where the line would cross (or start at) the <em>y</em>-axis.</p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">Now, we have the information we need to write our regression linear equation.&nbsp;</span></p> <div class="textbox shaded"><h3>Formula 19.2. Calculating Predicted y Value using the Linear Equation</h3> <p><strong>Linear equation:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IGEgKyBieA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = a + bx" title="\hat{y} = a + bx" class="latex mathjax" /></p> </div> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h3 class="textbox__title">Example 19.3. Writing Our Linear Equation</h3> </div> <div class="textbox__content"><p><strong>Linear equation:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IGEgKyBieA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = a + bx" title="\hat{y} = a + bx" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIweA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20x" title="\hat{y} = 9.92 + 1.20x" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">We can use our equation to make predictions about our outcome if we know what our <em>x</em> value is:</span></p> <div class="chapter-19:-linear-regression"><p class="import-Normal"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIweA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20x" title="\hat{y} = 9.92 + 1.20x" class="latex mathjax" /></p> <p class="import-Normal">For example, if you have another participant who scores an 8 on the childhood stressors assessment, you can use this equation to make a prediction about what their anxiety score will be:</p> <p class="import-Normal"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDgp&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(8)" title="\hat{y} = 9.92 + 1.20(8)" class="latex mathjax" /></p> <p class="import-Normal"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDE5LjUy&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 19.52" title="\hat{y} = 19.52" class="latex mathjax" /></p> <p class="import-Normal">So, if you had a participant score an 8 on the childhood stressors assessment, you would predict their anxiety assessment score to be 19.52.</p> <p class="import-Normal">Our goal with linear regression is to estimate a line (and predictions) that reduces the amount of residual distance between actual and predicted values. You can estimate the amount of residual you have for each of your data points (to see how close each <em>y</em> value is to the estimated <img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y}" title="\hat{y}" class="latex mathjax" /> value of the line), as shown in Table 19.4.</p> <table style="width: 1062px; height: 485px;"><caption>Table 19.4. Calculating Residual for Each Participant&nbsp;</caption> <thead><tr class="shaded" style="height: 42.9pt;"><th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 105px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Participant</strong></p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 105px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=eA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="x" title="x" class="latex mathjax" /></strong></p> <p class="import-Normal" style="text-align: center;">(childhood stressors)</p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; border: 0.5pt solid windowtext; width: 225.297px; height: 105px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong><span style="font-size: NaNpt; color: #; text-decoration: none;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y}" title="\hat{y}" class="latex mathjax" /></span></strong></p> <p class="import-Normal" style="text-align: center;">(estimated from linear equation)</p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 105px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong><img src="https://mathjax.library.illinois.edu/latex?latex=eQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="y" title="y" class="latex mathjax" /></strong></p> <p class="import-Normal" style="text-align: center;">(anxiety)</p> </th> <th class="TableGrid-C" style="background-color: #e7e6e6; vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 105px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Residual</strong></p> <p style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=KFxoYXR7eX0gLSB5KQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(\hat{y} - y)" title="(\hat{y} - y)" class="latex mathjax" /></p> <p class="import-Normal" style="text-align: center;"></p></th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 22.05pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 36px;" scope="row"><p class="import-Normal" style="text-align: center;">1</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 36px;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 225.297px; height: 36px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDEwKSA9IDIxLjky&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(10) = 21.92" title="\hat{y} = 9.92 + 1.20(10) = 21.92" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 36px;"><p class="import-Normal" style="text-align: center;">23</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 36px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=MjMg4oCTIDIxLjkyID0gMS4wOA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="23 – 21.92 = 1.08" title="23 – 21.92 = 1.08" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 22.05pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;">2</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 35px;"><p class="import-Normal" style="text-align: center;">8</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 225.297px; height: 35px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDgpID0gMTkuNTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(8) = 19.52" title="\hat{y} = 9.92 + 1.20(8) = 19.52" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 35px;"><p class="import-Normal" style="text-align: center;">20</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 35px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=MjAg4oCTIDE5LjUyID0gMC40OA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="20 – 19.52 = 0.48" title="20 – 19.52 = 0.48" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 20.8pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;">3</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 35px;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 225.297px; height: 35px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDkpID0gMjAuNzI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(9) = 20.72" title="\hat{y} = 9.92 + 1.20(9) = 20.72" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 35px;"><p class="import-Normal" style="text-align: center;">20</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 35px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=MjAg4oCTIDIwLjcyID0gLTAuNzI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="20 – 20.72 = -0.72" title="20 – 20.72 = -0.72" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 22.05pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;">4</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 35px;"><p class="import-Normal" style="text-align: center;">5</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 225.297px; height: 35px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDUpID0gMTUuOTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(5) = 15.92" title="\hat{y} = 9.92 + 1.20(5) = 15.92" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 35px;"><p class="import-Normal" style="text-align: center;">16</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 35px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=MTYg4oCTIDE1LjkyID0gMC4wOA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="16 – 15.92 = 0.08" title="16 – 15.92 = 0.08" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 20.8pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;">5</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 35px;"><p class="import-Normal" style="text-align: center;">7</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 225.297px; height: 35px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDcpID0gMTguMzI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(7) = 18.32" title="\hat{y} = 9.92 + 1.20(7) = 18.32" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 35px;"><p class="import-Normal" style="text-align: center;">17</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 35px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=MTcg4oCTIDE4LjMyID0gLTEuMzI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="17 – 18.32 = -1.32" title="17 – 18.32 = -1.32" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 22.05pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;">6</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 35px;"><p class="import-Normal" style="text-align: center;">6</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 225.297px; height: 35px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDYpID0gMTcuMTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(6) = 17.12" title="\hat{y} = 9.92 + 1.20(6) = 17.12" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 35px;"><p class="import-Normal" style="text-align: center;">15</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 35px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=MTUg4oCTIDE3LjEyID0gLTIuMTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="15 – 17.12 = -2.12" title="15 – 17.12 = -2.12" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 20.8pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;">7</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 35px;"><p class="import-Normal" style="text-align: center;">5</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 225.297px; height: 35px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDUpID0gMTUuOTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(5) = 15.92" title="\hat{y} = 9.92 + 1.20(5) = 15.92" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 35px;"><p class="import-Normal" style="text-align: center;">18</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 35px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=MTgg4oCTIDE1LjkyID0gMi4wOA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="18 – 15.92 = 2.08" title="18 – 15.92 = 2.08" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 22.05pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;">8</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 35px;"><p class="import-Normal" style="text-align: center;">3</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 225.297px; height: 35px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDMpID0gMTMuNTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(3) = 13.52" title="\hat{y} = 9.92 + 1.20(3) = 13.52" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 35px;"><p class="import-Normal" style="text-align: center;">13</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 35px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=MTMg4oCTIDEzLjUyID0gLTAuNTI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="13 – 13.52 = -0.52" title="13 – 13.52 = -0.52" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 22.05pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;">9</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 35px;"><p class="import-Normal" style="text-align: center;">4</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 225.297px; height: 35px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDQpID0gMTQuNzI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(4) = 14.72" title="\hat{y} = 9.92 + 1.20(4) = 14.72" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 35px;"><p class="import-Normal" style="text-align: center;">16</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 35px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=MTYg4oCTIDE0LjcyID0gMS4yOA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="16 – 14.72 = 1.28" title="16 – 14.72 = 1.28" class="latex mathjax" /></p> </td> </tr> <tr class="TableGrid-R" style="height: 22.05pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 120.688px; height: 35px;" scope="row"><p class="import-Normal" style="text-align: center;">10</p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 171.344px; height: 35px;"><p class="import-Normal" style="text-align: center;">2</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 225.297px; height: 35px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGhhdHt5fSA9IDkuOTIgKyAxLjIwKDIpID0gMTIuMzI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\hat{y} = 9.92 + 1.20(2) = 12.32" title="\hat{y} = 9.92 + 1.20(2) = 12.32" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 187.734px; height: 35px;"><p class="import-Normal" style="text-align: center;">12</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 275.469px; height: 35px;"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=MTIg4oCTIDEyLjMyID0gLTAuMzI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="12 – 12.32 = -0.32" title="12 – 12.32 = -0.32" class="latex mathjax" /></p> </td> </tr> </tbody> </table> <p class="import-Normal">Next, you can further evaluate the line by calculating the <em>coefficient of determination</em>.&nbsp;This takes your Pearson’s <em>r</em> correlation value and squares it. So, you’ll end up with a value between 0 and 1; the closer to 1 your <img src="https://mathjax.library.illinois.edu/latex?latex=cl4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r^2" title="r^2" class="latex mathjax" /> is, the better your predictions are (with a smaller amount of residuals). The closer to 0 your <img src="https://mathjax.library.illinois.edu/latex?latex=cl4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r^2" title="r^2" class="latex mathjax" /> is, the less helpful your predictions are (with more residual). An important note for social work and other social science research is that it is difficult and complex to predict human behavior and other outcomes; thus, we may see coefficients of determination that are lower (e.g., between 0.10 and 0.30) and still have a statistically significant and meaningful prediction.</p> <p class="import-Normal">You can also visualize residuals with a residual oval, in which you draw an oval to encompass all of your data points on a scatterplot. If you have a skinny oval (where the oval is close to the line), you have less residual compared with an oval that looks more circular or stretched to include data points that are much further from the line. This would indicate more residual, and your coefficient of determination would be closer to 0.</p> <p class="import-Normal">In our example, <img src="https://mathjax.library.illinois.edu/latex?latex=ciA9IDAuOTM&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r = 0.93" title="r = 0.93" class="latex mathjax" />, so our coefficient of determination would be <img src="https://mathjax.library.illinois.edu/latex?latex=cl4yID0gMC45M14yID0gMC44Ng&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="r^2 = 0.93^2 = 0.86" title="r^2 = 0.93^2 = 0.86" class="latex mathjax" />. As shown in Figure 19.3, our residual oval is fairly oval in shape, and the data points are fairly close to the line.</p> <div class="wp-caption aligncenter" id="attachment_1252" aria-describedby="caption-attachment-1252" style="width: 700px"><img class="wp-image-1252" src="https://pb-sandbox.library.illinois.edu/swstats3/wp-content/uploads/sites/389/2026/07/Figure-19.3R-1.png" alt="The scatter plot and estimated line are graphed. There is now an oval that includes all of the data points; it has an oval, skinny shape, which means there is little residual." width="700" height="406" title="" /><div class="wp-caption-text" id="caption-attachment-1252">Figure 19.3. Scatterplot graph between childhood stressors and anxiety symptoms, with a residual oval around data points.</div></div> <h2 class="import-Normal">Summary</h2> <p class="import-Normal">This chapter introduced the linear regression equation and the ways in which you can use regression analyses to make predictions based on your variables. You may want to continue studying linear regression, for example, by running a hypothesis test to see if you have a significant slope (i.e., is your slope significantly different from a slope of 0?). You may also want to test multiple predictors and see if one or more of these predictors can explain the change in a dependent variable.</p> </div> 
	</div>
			
				
				
	</div>
<div class="chapter standard " id="chapter-chapter-20-chi-square-analyses" title="Chapter 20: Chi-Square Analyses">
	<div class="chapter-title-wrap">
		<p class="chapter-number">40</p>
		<h1 class="chapter-title">Chapter 20: Chi-Square Analyses</h1>
								</div>
	<div class="ugc chapter-ugc">
				 <div class="chapter-20:-chi-square-analyses"><p class="import-Normal">The last type of inferential statistics that is used to examine relationships is <strong><em><span class="glossary-term">chi-square </span></em></strong>(<img src="https://mathjax.library.illinois.edu/latex?latex=XGNoaV4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\chi^2" title="\chi^2" class="latex mathjax" />). This statistic is used to examine frequency distributions when you have nominal (categorical) data. You can test to see whether there is a significant difference between what you observe and what you would expect in a frequency distribution. There is a <em>chi-square goodness-of-fit test</em>, which focuses on an univariate frequency distribution. There is also a <em>chi-square test for independence</em>, which examines the association between two categorical variables. We will discuss both tests in this chapter.</p> <h2 class="import-Normal">Chi-Square Goodness-of-Fit Test</h2> <p>The <strong><em><span class="glossary-term">chi-square goodness-of-fit test </span></em></strong>focuses on an univariate frequency distribution for a nominal variable. We can run a hypothesis test, but keep in mind that because you have a nominal variable, you are running a <em><strong><span class="glossary-term">nonparametric analysis</span></strong></em>. This means that the data do not meet the assumptions (e.g., data are a normal distribution with continuous data) that all of our previous parametric analyses did (e.g., <em>z</em>-test, <em>t</em>-tests, analysis of variance [ANOVA], correlation). However, we can examine distributions of frequencies across nominal categories.</p> <h3>Example: Therapeutic Approaches</h3> <p class="import-Normal">You survey 100 social workers on their favorite therapeutic approach. (Read more about <a href="https://socialwork.buffalo.edu/continuing-education/training-registration/EBP-mental-health/evidence-based-practices/ebp-interventions.html" target="_blank" rel="noopener" data-url="https://socialwork.buffalo.edu/continuing-education/training-registration/EBP-mental-health/evidence-based-practices/ebp-interventions.html">evidence-based therapeutic approaches</a>).</p> <p class="import-Normal">This is what you <em>observe:</em></p> <ul><li>Cognitive-behavioral therapy: 35</li> <li>Person-centered therapy: 25</li> <li>Psychodynamic therapy: 10</li> <li>Systemic therapy: 30</li> </ul> <p class="import-Normal">You want to test whether there are meaningful differences between categories or whether the difference in the distribution is due to chance. You will test what you observe in comparison to <em>expected values</em> (i.e., equal distribution across categories with <em>N</em> = 100):</p> <ul><li>Cognitive-behavioral therapy: 25</li> <li>Person-centered therapy: 25</li> <li>Psychodynamic therapy: 25</li> <li>Systemic therapy: 25</li> </ul> <h2 class="import-Normal">Hypothesis Test for Chi-Square Goodness-of-Fit</h2> <h3 class="import-Normal">Step 1: Hypothesis Pair</h3> <p class="import-Normal">First, you will write your null and alternative hypotheses about the population chi-square distribution. Your null hypothesis would state that your sample’s distribution fits the expected distribution (i.e., observed frequencies are consistent with expected frequencies). Your alternative hypothesis would state that your sample’s distribution does not fit the expected distribution (i.e., observed frequencies are not consistent with the expected frequencies; at least one category has a different proportion than what would be expected).</p> <p class="import-Normal">You are making inferences about population proportions, so your statements will make reference to probability (<em>p</em>). In our example, we have four categories, so your statements would look like this:</p> <ul><li>Null hypothesis: <img src="https://mathjax.library.illinois.edu/latex?latex=cF8xID0gXGZyYWN7MX17NH0sIHBfMiA9IFxmcmFjezF9ezR9LCBwXzMgPSBcZnJhY3sxfXs0fSwgcF80ID0gXGZyYWN7MX17NH0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="p_1 = \frac{1}{4}, p_2 = \frac{1}{4}, p_3 = \frac{1}{4}, p_4 = \frac{1}{4}" title="p_1 = \frac{1}{4}, p_2 = \frac{1}{4}, p_3 = \frac{1}{4}, p_4 = \frac{1}{4}" class="latex mathjax" />.</li> <li>Alternative hypothesis: At least one of the proportions is not equal to <img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7MX17NH0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{1}{4}" title="\frac{1}{4}" class="latex mathjax" />.</li> </ul> <p>You may also see the statements written using “<em>f</em>” for frequencies. In this case, your null hypothesis would state that your observed frequencies are equal to your expected frequencies. Your alternative hypothesis would state that your observed frequencies are <em>not</em> equal to your expected frequencies.</p> <ul><li>Null hypothesis: <img src="https://mathjax.library.illinois.edu/latex?latex=Zl9vID0gZl9l&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="f_o = f_e" title="f_o = f_e" class="latex mathjax" />.</li> <li>Alternative hypothesis: <img src="https://mathjax.library.illinois.edu/latex?latex=Zl9vIFxuZXEgZl9l&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="f_o \neq f_e" title="f_o \neq f_e" class="latex mathjax" />.</li> </ul> <h3 class="import-Normal">Step 2: Setup for the Test</h3> <ul><li>What inferential test are you using? <strong>Chi-square goodness-of-fit test</strong> <ul><li>Reasons for selecting this test: <ul><li><strong>Your research question involves examining the frequency distribution of one nominal variable.</strong></li> </ul> </li> </ul> </li> <li>Set your confidence/alpha: <strong>Confidence = .95, and alpha = .05.</strong></li> </ul> <p>A chi-square test uses the chi-square distribution, which changes shape based on its degrees of freedom; the distribution includes only positive numbers, and it is positively skewed in shape. As the degrees of freedom increase, the distribution shape begins to resemble a normal distribution.</p> <ul><li style="list-style-type: none;"><ul><li>Your degrees of freedom are calculated by taking the number of categories in your nominal variable and subtracting 1. So, in our example, we have four categories, so 4 – 1 = 3 degrees of freedom. We would then use this to look up our critical value (in Table A.5.). Because all chi-square values are numbers squared, we will only see positive chi-square values, including our critical value.</li> </ul> </li> <li>Find your critical value. In our example, <strong><img src="https://mathjax.library.illinois.edu/latex?latex=XGNoaV4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\chi^2" title="\chi^2" class="latex mathjax" /> critical = 7.815</strong>.</li> </ul> <h3 class="import-Normal">Step 3: Test Statistic Computation</h3> <p class="import-Normal">First, you’ll want to find the difference between each category’s observed and expected values (see Table 20.1).</p> <table style="height: 176px;"><caption>Table 20.1. Comparing Observed and Expected Values by Category</caption> <thead><tr style="height: 53px;"><th class="shaded" style="border: 0.5pt solid windowtext; height: 53px; width: 189.828px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Calculation</strong></p> </th> <th class="shaded" style="border: 0.5pt solid windowtext; height: 53px; width: 187.836px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Cognitive Behavioral Therapy</strong></p> </th> <th class="shaded" style="border: 0.5pt solid windowtext; height: 53px; width: 161.016px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Person-Centered Therapy</strong></p> </th> <th class="shaded" style="border: 0.5pt solid windowtext; height: 53px; width: 163.648px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Psychodynamic Therapy</strong></p> </th> <th class="shaded" style="border: 0.5pt solid windowtext; height: 53px; width: 115.125px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Systemic Therapy</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 35px;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 189.828px;" scope="row"><p class="import-Normal" style="text-align: center;">Observed <img src="https://mathjax.library.illinois.edu/latex?latex=KE8p&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(O)" title="(O)" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 187.836px;"><p class="import-Normal" style="text-align: center;">35</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 161.016px;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 163.648px;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 115.125px;"><p class="import-Normal" style="text-align: center;">30</p> </td> </tr> <tr class="TableGrid-R" style="height: 35px;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 189.828px;" scope="row"><p class="import-Normal" style="text-align: center;">Expected <img src="https://mathjax.library.illinois.edu/latex?latex=KEUp&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(E)" title="(E)" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 187.836px;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 161.016px;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 163.648px;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 35px; width: 115.125px;"><p class="import-Normal" style="text-align: center;">25</p> </td> </tr> <tr class="TableGrid-R" style="height: 53px;"><th class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 53px; width: 189.828px;" scope="row"><p class="import-Normal" style="text-align: center;">Difference <img src="https://mathjax.library.illinois.edu/latex?latex=KE8g4oCTIEUp&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(O – E)" title="(O – E)" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 53px; width: 187.836px;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 53px; width: 161.016px;"><p class="import-Normal" style="text-align: center;">0</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 53px; width: 163.648px;"><p class="import-Normal" style="text-align: center;">-15</p> </td> <td class="TableGrid-C" style="border: 0.5pt solid windowtext; height: 53px; width: 115.125px;"><p class="import-Normal" style="text-align: center;">5</p> </td> </tr> </tbody> </table> <p class="import-Normal">Then, you’ll square that difference, as shown in Table 20.2.</p> <table><caption>Table 20.2. Examining Squared Differences (Observed Minus Expected) by Category</caption> <thead><tr class="shaded"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Calculation</strong></p> </th> <th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Cognitive Behavioral Therapy</strong></p> </th> <th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Person-Centered Therapy</strong></p> </th> <th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Psychodynamic Therapy</strong></p> </th> <th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Systemic Therapy</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Observed <img src="https://mathjax.library.illinois.edu/latex?latex=KE8p&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(O)" title="(O)" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">35</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">30</p> </td> </tr> <tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Expected <img src="https://mathjax.library.illinois.edu/latex?latex=KEUp&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(E)" title="(E)" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> </tr> <tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Difference <img src="https://mathjax.library.illinois.edu/latex?latex=KE8g4oCTIEUp&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(O – E)" title="(O – E)" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">0</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">-15</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">5</p> </td> </tr> <tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Difference <img src="https://mathjax.library.illinois.edu/latex?latex=KE8g4oCTIEUpXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(O – E)^2" title="(O – E)^2" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">100</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">0</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">225</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> </tr> </tbody> </table> <p class="import-Normal">Next, you’ll take the difference scores (squared so that there are no negative numbers) and divide by the expected value for each group, as shown in Table 20.3.</p> <table><caption>Table 20.3. Examining Squared Difference Scores Divided by Expected Group Value</caption> <thead><tr class="shaded"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Calculation</strong></p> </th> <th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Cognitive Behavioral Therapy</strong></p> </th> <th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Person-Centered Therapy</strong></p> </th> <th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Psychodynamic Therapy</strong></p> </th> <th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Systemic Therapy</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Observed <img src="https://mathjax.library.illinois.edu/latex?latex=KE8p&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(O)" title="(O)" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">35</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">30</p> </td> </tr> <tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Expected <img src="https://mathjax.library.illinois.edu/latex?latex=KEUp&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(E)" title="(E)" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> </tr> <tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Difference <img src="https://mathjax.library.illinois.edu/latex?latex=KE8g4oCTIEUp&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(O – E)" title="(O – E)" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">0</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">−15</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">5</p> </td> </tr> <tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Difference <img src="https://mathjax.library.illinois.edu/latex?latex=KE8g4oCTIEUpXjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(O – E)^2" title="(O – E)^2" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">100</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">0</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">225</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">25</p> </td> </tr> <tr class="TableGrid-R" style="height: 42.25pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7KE8gLSBFKV4yfXtFfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{(O - E)^2}{E}" title="\frac{(O - E)^2}{E}" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7MTAwfXsyNX0gPSA0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{100}{25} = 4" title="\frac{100}{25} = 4" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7MH17MjV9ID0gMA&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{0}{25} = 0" title="\frac{0}{25} = 0" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7MjI1fXsyNX0gPSA5&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{225}{25} = 9" title="\frac{225}{25} = 9" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7MjV9ezI1fSA9IDE&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{25}{25} = 1" title="\frac{25}{25} = 1" class="latex mathjax" /></td> </tr> </tbody> </table> <p class="import-Normal">Finally, you’ll calculate your <img src="https://mathjax.library.illinois.edu/latex?latex=XGNoaV4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\chi^2" title="\chi^2" class="latex mathjax" /> obtained value, using the values we just found in the bottom row of Table 20.3.</p> <div class="textbox shaded"><h4>Formula 20.1. Calculating Chi-Square Obtained Value</h4> <p><strong>Formula for <img src="https://mathjax.library.illinois.edu/latex?latex=XGNoaV4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\chi^2" title="\chi^2" class="latex mathjax" />:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGNoaV4yID0gXHN1bSBcbGVmdChcZnJhY3soTyAtIEUpXjJ9e0V9XHJpZ2h0KQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\chi^2 = \sum \left(\frac{(O - E)^2}{E}\right)" title="\chi^2 = \sum \left(\frac{(O - E)^2}{E}\right)" class="latex mathjax" /></p> </div> <div class="textbox textbox--examples"><div class="textbox__header"><h4 class="textbox__title">Example 20.1. Calculating Chi-Square Obtained Value</h4> </div> <div class="textbox__content"><p><strong>Formula for <img src="https://mathjax.library.illinois.edu/latex?latex=XGNoaV4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\chi^2" title="\chi^2" class="latex mathjax" />:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGNoaV4yID0gXHN1bSBcbGVmdChcZnJhY3soTyAtIEUpXjJ9e0V9XHJpZ2h0KQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\chi^2 = \sum \left(\frac{(O - E)^2}{E}\right)" title="\chi^2 = \sum \left(\frac{(O - E)^2}{E}\right)" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=NCArIDAgKyA5ICsgMSA9IDE0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="4 + 0 + 9 + 1 = 14" title="4 + 0 + 9 + 1 = 14" class="latex mathjax" /></p> </div> </div> <p class="import-Normal">So, in our example, <img src="https://mathjax.library.illinois.edu/latex?latex=XGNoaV4yPTE0&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\chi^2=14" title="\chi^2=14" class="latex mathjax" />.</p> <h3 class="import-Normal">Step 4: Make a Decision</h3> <p class="import-Normal">Next, you will compare your obtained value (14) to your critical value (7.815). Your obtained value exceeds the critical value, so you would <strong>r</strong><strong>eject the null hypothesis</strong>. This means there is a significant difference in what was observed in your frequency distribution compared with what was expected.</p> <h3 class="import-Normal">APA-Style Write-up</h3> <p class="import-Normal">In your American Psychological Association ([APA], 2020)-style write-up, you will include your decision (significant or not significant difference), your degrees of freedom and sample size in parentheses, your obtained value, and your <em>p</em> statement:</p> <p class="import-Normal" style="padding-left: 40px;">There was a significant difference in preferences for these four therapeutic approaches among social workers, χ<sup>2</sup>(3, <em>N</em> = 100) = 14, <em>p</em> &lt; .05.</p> <h2 class="import-Normal">Pairwise Comparisons</h2> <p class="import-Normal">Like the pairwise comparisons we did after an ANOVA test (see Chapter 17), you can also compare each group to find <em>where </em>the significant difference or differences exists. You can compare each of the groups to each other; because you are doing pairwise comparisons, you will use 1 degree of freedom (2 groups that you are comparing, minus 1) as your critical value (from Table A.5, you see that χ<sup>2 </sup><span style="font-size: NaNpt; color: #; text-decoration: none;">=3.841 </span>with alpha = 0.05).</p> <p class="import-Normal">For example, you could test cognitive-behavioral therapy against systemic therapy. To do so, you’ll need to recalculate your proportions because as you now have <em>N</em> = 65 (35 people chose cognitive-behavioral therapy and 30 chose systemic therapy), as shown in Table 20.4.</p> <table><caption>Table 20.4. Example Pairwise Comparison</caption> <thead><tr><th class="shaded" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Calculations</strong></p> </th> <th class="shaded" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Cognitive Behavioral Therapy</strong></p> </th> <th class="shaded" style="border: 0.5pt solid windowtext;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Systemic Therapy</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Observed (O)</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">35</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">30</p> </td> </tr> <tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Expected (E)</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">32.5</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">32.5</p> </td> </tr> <tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Difference (O – E)</p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">2.5</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">-2.5</p> </td> </tr> <tr class="TableGrid-R"><th class="TableGrid-C" style="border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;">Difference (O – E)<sup>2</sup></p> </th> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">6.25</p> </td> <td class="TableGrid-C" style="border: solid windowtext 0.5pt;"><p class="import-Normal" style="text-align: center;">6.25</p> </td> </tr> <tr class="TableGrid-R" style="height: 42.25pt;"><th class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext;" scope="row"><p class="import-Normal" style="text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7KE8gLSBFKV4yfXtFfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{(O - E)^2}{E}" title="\frac{(O - E)^2}{E}" class="latex mathjax" /></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7Ni4yNX17MzIuNX0gPSAuMTk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{6.25}{32.5} = .19" title="\frac{6.25}{32.5} = .19" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7Ni4yNX17MzIuNX0gPSAuMTk&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{6.25}{32.5} = .19" title="\frac{6.25}{32.5} = .19" class="latex mathjax" /></td> </tr> </tbody> </table> <div class="textbox textbox--examples"><div class="textbox__header"><h3 class="textbox__title">Example 20.2. Calculating Chi-Square Obtained Value (for Pairwise Comparison Example)</h3> </div> <div class="textbox__content"><p><strong>Formula for <img src="https://mathjax.library.illinois.edu/latex?latex=XGNoaV4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\chi^2" title="\chi^2" class="latex mathjax" />:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=XGNoaV4yID0gXHN1bSBcbGVmdChcZnJhY3soTyAtIEUpXjJ9e0V9XHJpZ2h0KQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\chi^2 = \sum \left(\frac{(O - E)^2}{E}\right)" title="\chi^2 = \sum \left(\frac{(O - E)^2}{E}\right)" class="latex mathjax" /></p> <p><strong>Our example:&nbsp;</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=MC4xOSArIDAuMTkgPSAwLjM4&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="0.19 + 0.19 = 0.38" title="0.19 + 0.19 = 0.38" class="latex mathjax" /></p> </div> </div> <p><span style="text-align: initial; font-size: 14pt;">You will compare your obtained value (0.38) to your critical value (3.841). Your obtained value does not exceed the critical value, so you would <strong>fail to reject the null hypothesis</strong>. Your APA-style statement would be as follows:&nbsp;</span></p> <p class="import-Normal" style="padding-left: 40px;">There was not a significant difference between therapists’ preferences for cognitive-behavioral therapy or systemic therapy, χ<sup>2</sup> (1, <em>N</em> = 65) = 0.38, <em>p</em> &gt; .05.</p> <p class="import-Normal">You could then continue testing all your comparisons:</p> <ul><li>Cognitive-behavioral therapy against person-centered therapy</li> <li>Cognitive-behavioral therapy against psychodynamic therapy</li> <li>Person-centered therapy against psychodynamic therapy</li> <li>Person-centered therapy against systemic therapy</li> <li>Psychodynamic therapy against systemic therapy</li> </ul> <p class="import-Normal">These pairwise comparisons can help you find exactly where the significant difference or differences exist.</p> <h2 class="import-Normal">Chi-Square Test of Independence</h2> <p class="import-Normal">Next, we will examine the <em><strong><span class="glossary-term">chi-square test of independence</span></strong></em>, which focuses on bivariate frequency distributions of nominal variables. You can run a hypothesis test, although again, keep in mind that you are running a <em>nonparametric analysis</em>.</p> <h3 class="import-Normal">Example: Relationship Between Race and Preference for Therapeutic Approach</h3> <p>The next time we assessed therapists’ approach, we also collected information on the therapists’ race to see if there was a relationship between race and preference for therapeutic approach (see Table 20.5). You could use a cross-tab table for your frequency distribution (see Chapter 4 for a refresh on cross-tabulation tables).</p> <table style="width: 800px; height: 326px;"><caption>Table 20.5. Summary Information for Therapeutic Approach and Race Example</caption> <thead><tr style="height: 55.25pt;"><th class="shaded" style="border: 0.5pt solid windowtext; height: 72px; width: 123.797px;" scope="col"><p class="import-Normal"><strong>Race</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 137.203px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Cognitive-Behavioral Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 117px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Person-Centered Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 163.266px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Psychodynamic Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 101.078px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Systemic Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 60.0938px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Totals</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 18.75pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 123.797px;" scope="row"><p class="import-Normal"><strong>Asian or Asian American</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 137.203px;"><p class="import-Normal" style="text-align: center;">17</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 117px;"><p class="import-Normal" style="text-align: center;">11</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 163.266px;"><p class="import-Normal" style="text-align: center;">5</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 101.078px;"><p class="import-Normal" style="text-align: center;">15</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 60.0938px;"><p class="import-Normal" style="text-align: center;"><strong>48</strong></p> </td> </tr> <tr class="TableGrid-R" style="height: 18.75pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 123.797px;" scope="row"><p class="import-Normal"><strong>Black or African American</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 137.203px;"><p class="import-Normal" style="text-align: center;">18</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 117px;"><p class="import-Normal" style="text-align: center;">9</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 163.266px;"><p class="import-Normal" style="text-align: center;">10</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 101.078px;"><p class="import-Normal" style="text-align: center;">15</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 72px; width: 60.0938px;"><p class="import-Normal" style="text-align: center;"><strong>52</strong></p> </td> </tr> <tr class="TableGrid-R" style="height: 17.7pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 123.797px;" scope="row"><p class="import-Normal"><strong>Totals</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 137.203px;"><p class="import-Normal" style="text-align: center;">35</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 117px;"><p class="import-Normal" style="text-align: center;">20</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 163.266px;"><p class="import-Normal" style="text-align: center;">15</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 101.078px;"><p class="import-Normal" style="text-align: center;">30</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; height: 35px; width: 60.0938px;"><p class="import-Normal" style="text-align: center;">100</p> </td> </tr> </tbody> </table> <p class="import-Normal">Before we continue, let’s look at these elements of the table. You’ll see that 35 people selected cognitive-behavioral therapy, including 17 of the therapists identified as Asian or Asian American and 18 identified as Black or African American. We can also see that 48 individuals who identified as Asian or Asian American completed this survey, and 52 individuals identified as Black or African American completed the survey. The bottom right cell indicates that a total of 100 people completed the survey.</p> <p class="import-Normal">We will use the totals along the bottom and far right of Table 20.6 to help us in the calculations for expected proportions. To find a cell’s expected frequency, you will take the row total and multiply it by the column total. Then, you’ll divide that by the total sample size. So, our equation for expected frequency is notated as follows.</p> <div class="textbox shaded"><h4>Formula 20.2. Calculating expected frequency</h4> <p><strong>Formula for expected frequency:</strong></p> <p><img src="https://mathjax.library.illinois.edu/latex?latex=Rl9lID0gXGZyYWN7KFx0ZXh0e3JvdyB0b3RhbH0pKFx0ZXh0e2NvbHVtbiB0b3RhbH0pfXtOfQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="F_e = \frac{(\text{row total})(\text{column total})}{N}" title="F_e = \frac{(\text{row total})(\text{column total})}{N}" class="latex mathjax" /></p> </div> <table style="width: 824px; height: 379px;"><caption>Table 20.6. Therapeutic Approach and Race Example with Expected Frequencies</caption> <thead><tr style="height: 44.5pt;"><th class="shaded" style="border: 0.5pt solid windowtext; width: 130.203px;" scope="col"><p class="import-Normal"><strong>Race</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 145.578px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Cognitive- Behavioral Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 125.219px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Person-Centered Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 143.484px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Psychodynamic Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 96.8438px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Systemic Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 85.1094px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Totals</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 47.75pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 130.203px;" scope="row"><p class="import-Normal"><strong>Asian or Asian American</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 145.578px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7KDQ4KSgzNSl9ezEwMH0gPSAxNi44&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{(48)(35)}{100} = 16.8" title="\frac{(48)(35)}{100} = 16.8" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 125.219px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7KDQ4KSgyMCl9ezEwMH0gPSA5LjY&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{(48)(20)}{100} = 9.6" title="\frac{(48)(20)}{100} = 9.6" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 143.484px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7KDQ4KSgxNSl9ezEwMH0gPSA3LjI&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{(48)(15)}{100} = 7.2" title="\frac{(48)(15)}{100} = 7.2" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 96.8438px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7KDQ4KSgzMCl9ezEwMH0gPSAxNC40&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{(48)(30)}{100} = 14.4" title="\frac{(48)(30)}{100} = 14.4" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 85.1094px;"><p class="import-Normal" style="text-align: center;"><strong>48</strong></p> </td> </tr> <tr class="TableGrid-R" style="height: 47.75pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 130.203px;" scope="row"><p class="import-Normal"><strong>Black or African American</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 145.578px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7KDUyKSgzNSl9ezEwMH0gPSAxOC4y&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{(52)(35)}{100} = 18.2" title="\frac{(52)(35)}{100} = 18.2" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 125.219px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7KDUyKSgyMCl9ezEwMH0gPSAxMC40&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{(52)(20)}{100} = 10.4" title="\frac{(52)(20)}{100} = 10.4" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 143.484px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7KDUyKSgxNSl9ezEwMH0gPSA3Ljg&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{(52)(15)}{100} = 7.8" title="\frac{(52)(15)}{100} = 7.8" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 96.8438px; text-align: center;"><img src="https://mathjax.library.illinois.edu/latex?latex=XGZyYWN7KDUyKSgzMCl9ezEwMH0gPSAxNS42&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="\frac{(52)(30)}{100} = 15.6" title="\frac{(52)(30)}{100} = 15.6" class="latex mathjax" /></td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 85.1094px;"><p class="import-Normal" style="text-align: center;"><strong>52</strong></p> </td> </tr> <tr class="TableGrid-R" style="height: 45.05pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 130.203px;" scope="row"><p class="import-Normal"><strong>Totals</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 145.578px;"><p class="import-Normal" style="text-align: center;">35</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 125.219px;"><p class="import-Normal" style="text-align: center;">20</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 143.484px;"><p class="import-Normal" style="text-align: center;">15</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 96.8438px;"><p class="import-Normal" style="text-align: center;">30</p> </td> <td class="TableGrid-C" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 85.1094px;"><p class="import-Normal" style="text-align: center;">100</p> </td> </tr> </tbody> </table> <p class="import-Normal">If you added all of the values that you just calculated for expected frequencies, you would get 100, your total sample size.</p> <h2 class="import-Normal">Hypothesis Test for Chi-Square Test of Independence</h2> <h3 class="import-Normal">Step 1: Hypothesis Pair</h3> <p class="import-Normal">Your null hypothesis would state that there is no association between your two nominal variables–that is, that the percentage of one of your variables is equal in each of the other variables’ groups. Your alternative hypothesis would state that there is an association between your two nominal variables; the percentage of one of your variables is not equal in one or more of the other variables’ groups.</p> <ul><li>Null hypothesis: The percentage of therapists’ preferences for therapeutic approach is equal across therapists’ racial identity. There is not an association between these two variables. (Can also be written as “The two variables are independent.”)</li> <li>Alternative hypothesis: The percentage of therapists’ preferences for therapeutic approach is not equal across therapists’ racial identity. There is an association between these two variables. (Can also be written as “The two variables are not independent.”)</li> </ul> <h3 class="import-Normal">Step 2: Setup for the Test</h3> <ul><li>What inferential test are you using? <strong>Chi-square test of independence</strong> <ul><li>Reasons for selecting this test: <ul><li><strong>Your research question involves examining the frequency distribution of two nominal variables.</strong></li> </ul> </li> </ul> </li> <li>Set your confidence/alpha: <strong>Confidence = .95, and alpha = .05.</strong></li> </ul> <p>To find your degrees of freedom, you will take the number of rows of data you have <img src="https://mathjax.library.illinois.edu/latex?latex=KHIg4oCTIDEp&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(r – 1)" title="(r – 1)" class="latex mathjax" /> and the number of columns in your data <img src="https://mathjax.library.illinois.edu/latex?latex=KGMgLTEp&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(c -1)" title="(c -1)" class="latex mathjax" /> and multiply these values together. So, in our example, we have two rows (2 – 1 = 1) and four columns <img src="https://mathjax.library.illinois.edu/latex?latex=KDQg4oCTIDEgPSAzKQ&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="(4 – 1 = 3)" title="(4 – 1 = 3)" class="latex mathjax" />, so <img src="https://mathjax.library.illinois.edu/latex?latex=ZGYgPSAoMSkoMykgPSAz&amp;fg=000000&amp;svg=1&amp;isBase64=1" alt="df = (1)(3) = 3" title="df = (1)(3) = 3" class="latex mathjax" />.</p> <ul><li>Find your critical value. Using Table A.5, you find that for 3 degrees of freedom, χ<sup>2</sup><sup>&nbsp;</sup>critical = 7.815.</li> </ul> <h3 class="import-Normal">Step 3: Test Statistic Computation</h3> <p class="import-Normal">Table 20.7 shows the data we’ll need for observed values, and Table 20.8 shows the data we’ll need for expected values.</p> <table style="width: 808px; height: 331px;"><caption>Table 20.7. Observed Values for Therapeutic Approach and Race Example</caption> <thead><tr style="height: 55.25pt;"><th class="shaded" style="border: 0.5pt solid windowtext; width: 70.4297px;" scope="col"><p class="import-Normal"><strong>Race</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 78.375px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Cognitive- Behavioral Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 65.9141px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Person-Centered Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 111.977px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Psychodynamic Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 63.4375px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Systemic Therapy</strong></p> </th> <th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 43.2578px;" scope="col"><p class="import-Normal" style="text-align: center;"><strong>Totals</strong></p> </th> </tr> </thead> <tbody><tr class="TableGrid-R" style="height: 18.75pt;"><th class="shaded" style="vertical-align: middle; border: 0.5pt solid windowtext; width: 70.4297px;" scope="row"><p class="import-Normal"><strong>Asian or Asian American</strong></p> </th> <td class="TableGrid-C" style="vertical-align: middle; bor